<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentOs.E2E.Tests</RootNamespace>
    <AssemblyName>AgentOs.E2E.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the AppHost so Aspire generates Projects.AgentOs_AppHost for the test harness. -->
    <ProjectReference Include="..\..\infra\AgentOs.AppHost\AgentOs.AppHost.csproj" />
    <!-- RowLevelSecurityRealDbTests checks the running stack against RowLevelSecurity.Tables / AppendOnlyTables (GAP-14):
         one list, so a table added to RLS is checked on the stack too. -->
    <ProjectReference Include="..\..\src\AgentOs.SharedKernel\AgentOs.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <!-- Transitive promotion: Aspire.Hosting's MessagePack 2.5.192 is vulnerable (GHSA-hv8m-jj95-wg3x). -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Playwright" />
    <!-- Budget-gate E2E seeds run_metrics directly (offline runs cost $0, so spend must be seeded). -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- MTP reporting/coverage extensions — must match AgentOs.Tests so the shared coverage /
         trx-report args are recognized when a run spans both projects. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

</Project>
