<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentOs.Tests</RootNamespace>
    <!-- The linked runner ProcessJob.cs uses source-generated P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AgentOs.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real MSBuild / dotnet test output captured for the tool-output shaping tests (2.7). -->
    <EmbeddedResource Include="Tools\Fixtures\ToolOutput\*.txt" LogicalName="ToolOutput.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentOs.Domain\AgentOs.Domain.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.SharedKernel\AgentOs.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Modules.AppConfig\AgentOs.Modules.AppConfig.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Modules.Llm\AgentOs.Modules.Llm.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Modules.Pipeline\AgentOs.Modules.Pipeline.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Modules.Identity\AgentOs.Modules.Identity.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Modules.Tenants\AgentOs.Modules.Tenants.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Modules.Tools\AgentOs.Modules.Tools.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Modules.Workspaces\AgentOs.Modules.Workspaces.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Modules.Mcp\AgentOs.Modules.Mcp.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Modules.Integration\AgentOs.Modules.Integration.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Modules.RemoteAgent\AgentOs.Modules.RemoteAgent.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Modules.Sessions\AgentOs.Modules.Sessions.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.ServiceDefaults\AgentOs.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Web\AgentOs.Web.csproj" />
    <ProjectReference Include="..\..\src\AgentOs.Modules.Memory\AgentOs.Modules.Memory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!-- MTP reporting/coverage extensions (xunit.v3 4.0.0 runs on Microsoft.Testing.Platform).
         Every test project in a solution-wide run must understand the coverage / trx-report args,
         so both extensions are referenced here and in AgentOs.E2E.Tests. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runner is an exe whose top-level records would clash with Modules.RemoteAgent's; compile only its
         dependency-free command policy + scoped-autonomy flags into the tests. -->
    <Compile Include="..\..\src\AgentOs.RemoteAgent\RunnerCommandPolicy.cs" Link="Linked\RunnerCommandPolicy.cs" />
    <Compile Include="..\..\src\AgentOs.RemoteAgent\ScopedAutonomy.cs" Link="Linked\ScopedAutonomy.cs" />
    <Compile Include="..\..\src\AgentOs.RemoteAgent\RunnerCredentials.cs" Link="Linked\RunnerCredentials.cs" />
    <Compile Include="..\..\src\AgentOs.RemoteAgent\CliProgress.cs" Link="Linked\CliProgress.cs" />
    <Compile Include="..\..\src\AgentOs.RemoteAgent\CliToolCalls.cs" Link="Linked\CliToolCalls.cs" />
    <Compile Include="..\..\src\AgentOs.RemoteAgent\PreviewHost.cs" Link="Linked\PreviewHost.cs" />
    <Compile Include="..\..\src\AgentOs.RemoteAgent\ProcessJob.cs" Link="Linked\ProcessJob.cs" />
    <Compile Include="..\..\src\AgentOs.RemoteAgent\PreviewProcess.cs" Link="Linked\PreviewProcess.cs" />
    <Compile Include="..\..\src\AgentOs.RemoteAgent\KeepAwake.cs" Link="Linked\KeepAwake.cs" />
    <Compile Include="..\..\src\AgentOs.RemoteAgent\CliModel.cs" Link="Linked\CliModel.cs" />
    <Compile Include="..\..\src\AgentOs.RemoteAgent\RunFiles.cs" Link="Linked\RunFiles.cs" />
    <Compile Include="..\..\src\AgentOs.RemoteAgent\RunUploads.cs" Link="Linked\RunUploads.cs" />
    <Compile Include="..\..\src\AgentOs.RemoteAgent\RunContinuation.cs" Link="Linked\RunContinuation.cs" />
    <!-- The perf gate's comparer (tests/AgentOs.Benchmarks) is pure BCL: compiled in here so it is unit-tested
         without pulling BenchmarkDotNet into the test run. -->
    <Compile Include="..\AgentOs.Benchmarks\Comparison\BaselineComparer.cs" Link="Linked\BaselineComparer.cs" />
    <Compile Include="..\AgentOs.Benchmarks\Comparison\ComparerArguments.cs" Link="Linked\ComparerArguments.cs" />
  </ItemGroup>

</Project>
