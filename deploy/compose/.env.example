# AgentOS.NET — docker compose settings (docs/ONPREM.md).
#
#   cp .env.example .env && ./init-secrets.sh
#
# init-secrets.sh replaces every CHANGE_ME below with a random value and creates the DataProtection
# certificate. .env holds live secrets: never commit it (it is git-ignored), chmod 600, back it up with the
# certificate in deploy/compose/dataprotection/.
#
# This file is bootstrap/deploy configuration only. Product settings (LLM providers + keys, agent profiles,
# budgets, …) are set in the desktop (Settings), per ADR-0011 — not here.

# --- Images ------------------------------------------------------------------------------------------------
# `docker compose build` tags agentos-net/{api,web,keycloak}:local. For an offline bundle (deploy/bundle.sh)
# or a private registry, set the registry/prefix and version the images were tagged with.
AGENTOS_REGISTRY=agentos-net
AGENTOS_VERSION=local

# --- Public URLs -------------------------------------------------------------------------------------------
# What the BROWSER uses. On a single machine the defaults work as-is (http on localhost is a secure context).
# On a server, put a TLS reverse proxy in front and use https URLs here (see docs/ONPREM.md → TLS).
WEB_PUBLIC_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Host ports + bind address. 127.0.0.1 = reachable from this machine only (put a reverse proxy in front);
# 0.0.0.0 = every interface.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
KEYCLOAK_PORT=8081
API_PORT=5080

# --- Postgres ----------------------------------------------------------------------------------------------
POSTGRES_USER=agentos
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=agentos

# --- Keycloak ----------------------------------------------------------------------------------------------
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Shared by Keycloak's agentic-web client and the Web host (rotated into the realm by keycloak-config).
KEYCLOAK_WEB_CLIENT_SECRET=CHANGE_ME
# First AgentOS.NET admin: user `operator` (tenant admin + platform-admin).
OPERATOR_PASSWORD=CHANGE_ME
# Optional demo user `member`; left empty, the seed user is disabled.
MEMBER_PASSWORD=
# Optional: distinct auth-cookie names when several AgentOS.NET installs share one host name.
COOKIE_PREFIX=

# --- DataProtection key-ring wrapping (docs/dataprotection-dr-runbook.md) ----------------------------------
# init-secrets.sh writes ./dataprotection/dataprotection.pfx (mounted read-only at /app/dataprotection).
DATAPROTECTION_CERTIFICATE_PATH=/app/dataprotection/dataprotection.pfx
DATAPROTECTION_CERTIFICATE_PASSWORD=CHANGE_ME
# true = a host that lost its certificate refuses to start instead of writing unwrapped keys.
DATAPROTECTION_REQUIRE_KEY_WRAPPING=true

# --- Mail (optional) ---------------------------------------------------------------------------------------
# Empty SMTP_HOST = no mail: Keycloak email verification is switched off and invitations are not mailed.
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=noreply@agentos.local
SMTP_STARTTLS=false
SMTP_AUTH=false
SMTP_USER=
SMTP_PASSWORD=

# --- Telemetry (optional) ----------------------------------------------------------------------------------
# OTLP collector for traces/metrics/logs, e.g. http://otel-collector:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=
