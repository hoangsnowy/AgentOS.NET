    {
      "id": 20,
      "type": "timeseries",
      "title": "Call latency p50 / p95 by model",
      "description": "gen_ai.client.operation.duration (a tool-calling call includes its whole tool loop).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
