<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentOs.RemoteAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- "Try the app": the runner validates a repo's recipe with exactly the server's rules. -->
    <Compile Include="..\AgentOs.Domain\Preview\PreviewRecipe.cs" Link="Linked\PreviewRecipe.cs" />
  </ItemGroup>

</Project>
