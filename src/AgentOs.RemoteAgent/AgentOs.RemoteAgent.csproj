<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentOs.RemoteAgent</RootNamespace>
    <!-- ProcessJob.cs: source-generated P/Invoke passes the job limit struct by reference. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- "Try the app": the runner validates a repo's recipe with exactly the server's rules. -->
    <Compile Include="..\AgentOs.Domain\Preview\PreviewRecipe.cs" Link="Linked\PreviewRecipe.cs" />
    <!-- Ticket files: the runner re-checks every path with exactly the server's rules (ADR-0015). -->
    <Compile Include="..\AgentOs.Domain\Files\TicketFilePath.cs" Link="Linked\TicketFilePath.cs" />
    <!-- Design gate: the screenshots a run sends back pass exactly the server's rules (ADR-0016). -->
    <Compile Include="..\AgentOs.Domain\Files\RunUploadRules.cs" Link="Linked\RunUploadRules.cs" />
  </ItemGroup>

</Project>
