@* ApiTokensApp — Settings → API tokens (enterprise review E1.3). Every member creates PERSONAL tokens (they act as the
   member, e.g. for the VS Code extension or a script); tenant admins also create SERVICE ACCOUNTS (a workspace identity
   for CI). A token has a name, a scope (read · run · admin — admin only for admins, never platform-admin) and an expiry
   capped by the platform setting Tenants:ApiTokens:MaxLifetimeDays. Its secret is shown ONCE at creation (only a salted
   HMAC is stored). Revoke takes effect on the next request. Create / use / revoke are audited. Admins see and revoke
   every token in the workspace; members see their own. *@

@using Microsoft.AspNetCore.Components.Authorization
@using AgentOs.Modules.Tenants.ApiTokens
@inject IApiTokenService Tokens
@inject IJSRuntime JS
@inject AgentOs.Web.Shell.Services.ToastService Toasts

@if (!_resolved)
{
    <Spinner />
}
else if (_tenantId is null)
{
    <div class="login-error" role="alert">@TenantClaim.MissingMessage</div>
}
else
{
    <header class="page-head">
        <div>
            <h1 class="page-title">API tokens · <code>@_tenantId</code></h1>
            <p class="page-sub">For scripts, CI, the VS Code extension and MCP clients: <code>Authorization: Bearer aos_…</code> on the Api's <code>/v1</code> routes.</p>
        </div>
    </header>

    <Panel Title="Create a token">
        <div class="form-grid">
            <Field Label="Name">
                <input @bind="_name" @bind:event="oninput" placeholder="github-actions-deploy" maxlength="128" />
            </Field>
            <Field Label="Type">
                <select class="prefs-select" @bind="_kind">
                    <option value="@ApiTokenKind.Personal">Personal — acts as you</option>
                    @if (_isAdmin)
                    {
                        <option value="@ApiTokenKind.Service">Service account — for CI</option>
                    }
                </select>
            </Field>
            <Field Label="Scope">
                <select class="prefs-select" @bind="_scope">
                    <option value="@ApiTokenScopes.Read">Read — view only</option>
                    <option value="@ApiTokenScopes.Run">Run — also start runs</option>
                    @if (_isAdmin)
                    {
                        <option value="@ApiTokenScopes.Admin">Admin — also manage</option>
                    }
                </select>
            </Field>
            <Field Label="Expires in" Hint="@($"At most {_maxDays} days (platform setting). Read = GET only; run = also POST/PUT/DELETE; admin = workspace-admin routes.")">
                <select class="prefs-select" @bind="_days">
                    @foreach (var d in ExpiryChoices())
                    {
                        <option value="@d">@ExpiryLabel(d)</option>
                    }
                </select>
            </Field>
        </div>
        <div class="form-actions">
            <Btn Variant="Btn.ButtonVariant.Primary" OnClick="CreateAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_name))">Create token</Btn>
        </div>
        @if (_newToken is not null)
        {
            <div class="cred-readout token-readout">
                <p class="cred-readout-hint">Copy it now — this is the only time the token is shown.</p>
                <textarea readonly rows="2" aria-label="New API token">@_newToken</textarea>
                <div class="form-actions">
                    <Btn Size="Btn.ButtonSize.Sm" OnClick="CopyAsync"><Icon Name="file" Size="13" /> Copy</Btn>
                    <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Ghost" OnClick="() => _newToken = null">Done</Btn>
                </div>
            </div>
        }
    </Panel>

    <Panel Title="@(_isAdmin ? "Tokens in this workspace" : "Your tokens")">
        @if (_rows is null) { <Spinner /> }
        else if (_rows.Count == 0)
        {
            <EmptyState Icon="tag" Title="No tokens yet" Hint="Create one above for a script, a pipeline or the VS Code extension." />
        }
        else
        {
            <table class="data-table">
                <thead><tr><th>Name</th><th>Type</th><th>Token</th><th>Scope</th><th>Expires</th><th>Last used</th><th>Status</th><th class="actions"></th></tr></thead>
                <tbody>
                    @foreach (var t in _rows)
                    {
                        var active = t.IsActive(DateTimeOffset.UtcNow);
                        <tr>
                            <td><strong>@t.Name</strong><br /><span class="muted">by @t.CreatedBy · @t.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span></td>
                            <td>@(t.Kind == ApiTokenKind.Service ? "Service account" : "Personal")</td>
                            <td><code>aos_@(t.Prefix)_…</code></td>
                            <td>@ApiTokenScopes.Highest(t.Scopes)</td>
                            <td>@t.ExpiresAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td>@(t.LastUsedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "never")</td>
                            <td><span class="badge @(active ? "ok" : t.RevokedAtUtc is not null ? "err" : "warn")">@(active ? "active" : t.RevokedAtUtc is not null ? "revoked" : "expired")</span></td>
                            <td class="actions">
                                @if (t.RevokedAtUtc is null)
                                {
                                    <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Danger" OnClick="() => RevokeAsync(t)" Disabled="_busy" Title="@($"Revoke {t.Name}")">Revoke</Btn>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </Panel>
}

@code {
    private static readonly int[] StandardDays = [7, 30, 90, 180, 365];

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _resolved;
    private bool _isAdmin;
    private bool _busy;
    // Null = the sign-in carries no tenant claim: fail closed (GAP-17), never the shared "default" tenant.
    private string? _tenantId;
    private ApiTokenActor _actor = new("member", null, false);
    private string _name = string.Empty;
    private string _kind = ApiTokenKind.Personal;
    private string _scope = ApiTokenScopes.Read;
    private int _days = 90;
    private int _maxDays = ApiTokenFormat.DefaultMaxLifetimeDays;
    private string? _newToken;
    private IReadOnlyList<ApiTokenInfo>? _rows;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _isAdmin = state.User.IsAdmin();
            _tenantId = state.User.GetTenantId();
            _actor = new ApiTokenActor(state.User.Identity?.Name ?? "member", state.User.GetUserId(), _isAdmin);
        }
        // Admins mostly create CI identities; members can only create personal tokens.
        _kind = _isAdmin ? ApiTokenKind.Service : ApiTokenKind.Personal;
        _scope = _isAdmin ? ApiTokenScopes.Run : ApiTokenScopes.Read;
        if (_tenantId is { } tenant)
        {
            _maxDays = await Tokens.MaxLifetimeDaysAsync(tenant);
            _days = Math.Min(_days, _maxDays);
            _rows = await Tokens.ListAsync(tenant, _actor);
        }
        _resolved = true;
    }

    private IEnumerable<int> ExpiryChoices()
    {
        var choices = StandardDays.Where(d => d < _maxDays).ToList();
        choices.Add(_maxDays);
        return choices;
    }

    private static string ExpiryLabel(int days) => days switch
    {
        1 => "1 day",
        365 => "1 year",
        _ => $"{days} days",
    };

    private async Task CreateAsync()
    {
        if (_tenantId is not { } tenant) { return; }
        _busy = true;
        try
        {
            var (_, token) = await Tokens.CreateAsync(new ApiTokenRequest(tenant, _name, _kind, [_scope], _days, _actor));
            _newToken = token;
            _name = string.Empty;
            _rows = await Tokens.ListAsync(tenant, _actor);
        }
        catch (InvalidOperationException ex)
        {
            Toasts.Show("API tokens", ex.Message, ToastKind.Err);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeAsync(ApiTokenInfo token)
    {
        if (_tenantId is not { } tenant) { return; }
        _busy = true;
        try
        {
            if (await Tokens.RevokeAsync(tenant, token.Id, _actor)) { Toasts.Show("API tokens", $"{token.Name} revoked.", ToastKind.Ok); }
            _rows = await Tokens.ListAsync(tenant, _actor);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _newToken);
            Toasts.Show("API tokens", "Token copied.", ToastKind.Ok);
        }
        catch (JSException)
        {
            Toasts.Show("API tokens", "The browser blocked clipboard access — select and copy the token.", ToastKind.Warn);
        }
    }
}
