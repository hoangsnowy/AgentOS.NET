@* UsersApp — tenant-admin member management desktop window (Windows Server "Users" / GNOME
   Users vibe). Lists the current tenant's Keycloak members and lets an Admin change roles (RBAC v2: viewer ·
   developer · approver · auditor · admin, see PermissionMatrix), send a password-reset email, remove a member,
   mint an invitation URL, and give members a role on one board (Board access — the first membership restricts the
   board to its members). Gated on ManageMembers: AppCatalog hides the app, WindowHost refuses it, and the page
   re-checks (defence in depth); every change is audited. Tenant + role are read from the circuit's
   AuthenticationState — HttpContext is null in interactive Server, so ITenantContext can't be used in a component. *@

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using AgentOs.Modules.Tenants
@using AgentOs.Modules.Tenants.Keycloak
@using AgentOs.Modules.Workspaces.Access
@using AgentOs.Modules.Workspaces.Persistence
@using AgentOs.Modules.Workspaces.Persistence.Entities
@inject AgentOs.Modules.Tenants.Keycloak.IKeycloakAdminClient Kc
@inject AgentOs.Modules.Tenants.ITenantSignupService Signup
@inject AgentOs.Modules.Tenants.Email.IEmailSender Email
@inject NavigationManager Nav
@inject AgentOs.Web.Shell.Services.ToastService Toasts
@inject AgentOs.Domain.Sessions.IRunnerDisconnector RunnerDisconnector
@inject Microsoft.Extensions.DependencyInjection.IServiceScopeFactory Scopes
@inject Microsoft.Extensions.Logging.ILoggerFactory Loggers

@if (!_resolved)
{
    <Spinner />
}
else if (!_isAdmin)
{
    <div class="login-error">Admin role required. Your account is a member of <code>@_tenantId</code> without admin rights.</div>
}
else if (_tenantId.Length == 0)
{
    <div class="login-error">No workspace (tenant) on your sign-in token. Re-authenticate; member management is unavailable without a tenant.</div>
}
else
{
    <header class="page-head">
        <div>
            <h1 class="page-title">Users · <code>@_tenantId</code></h1>
            <p class="page-sub">@(_members?.Count ?? 0) member(s) · roles + lifecycle managed via Keycloak · roles are additive; admin and auditor apply on every board</p>
        </div>
        <Btn OnClick="Reload" Disabled="_loading">
            <Icon Name="arrow-clockwise" Size="14" /> Refresh
        </Btn>
    </header>

    @if (_loadError is not null)
    {
        <div class="login-error">@_loadError</div>
    }
    else if (_members is null)
    {
        <Spinner />
    }
    else
    {
        <Panel Title="Members">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _members)
                    {
                        var isSelf = string.Equals(m.Id, _myUserId, StringComparison.Ordinal);
                        <tr>
                            <td>@m.Username @(isSelf ? "(you)" : "")</td>
                            <td>@(m.Email ?? "—")</td>
                            <td>
                                <select class="prefs-select" disabled="@(_busyId == m.Id || isSelf)" aria-label="@($"Role of {m.Username}")"
                                        value="@PrimaryRole(m)" @onchange="@(e => ChangeRole(m, e))">
                                    @if (PrimaryRole(m) == UserRoles.LegacyMember)
                                    {
                                        <option value="@UserRoles.LegacyMember">@UserRoles.Label(UserRoles.LegacyMember)</option>
                                    }
                                    @foreach (var role in UserRoles.Assignable)
                                    {
                                        <option value="@role" title="@UserRoles.Describe(role)">@UserRoles.Label(role)</option>
                                    }
                                </select>
                            </td>
                            <td>
                                @if (!m.Enabled) { <Badge>disabled</Badge> }
                                else if (!m.EmailVerified) { <Badge>unverified</Badge> }
                                else { <Badge>active</Badge> }
                            </td>
                            <td class="actions">
                                <span class="row-actions">
                                    <Btn Size="Btn.ButtonSize.Sm" OnClick="@(() => ResetPassword(m))" Disabled="_busyId == m.Id">
                                        <Icon Name="lock" Size="13" /> Reset
                                    </Btn>
                                    <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Danger"
                                         OnClick="@(() => AskRemove(m))" Disabled="@(_busyId == m.Id || isSelf)">
                                        <Icon Name="x" Size="13" /> Remove
                                    </Btn>
                                </span>
                            </td>
                        </tr>
                    }
                    @if (_members.Count == 0)
                    {
                        <tr><td colspan="5" class="data-empty">No members yet — invite one below.</td></tr>
                    }
                </tbody>
            </table>
        </Panel>

        <Panel Title="Invite a member">
            <div class="form-grid">
                <Field Label="Email">
                    <input type="email" @bind="_inviteEmail" placeholder="bob@@acme.test" autocomplete="email" required />
                </Field>
                <Field Label="Role">
                    <select @bind="_inviteRole" class="prefs-select">
                        @foreach (var role in UserRoles.Assignable)
                        {
                            <option value="@role">@UserRoles.Label(role) — @UserRoles.Describe(role)</option>
                        }
                    </select>
                </Field>
                <Field Label="TTL (hours)">
                    <input type="number" min="1" max="168" @bind="_inviteTtl" />
                </Field>
            </div>
            <div class="form-actions">
                <Btn Variant="Btn.ButtonVariant.Primary" OnClick="MintInvite" Loading="_busy">
                    Mint invite URL
                </Btn>
            </div>

            @if (_inviteUrl is not null)
            {
                <div class="cred-readout">
                    <p class="cred-readout-hint">Copy + send to your invitee. Expires @_inviteExpiresAt.ToString("u").</p>
                    <textarea readonly rows="2">@_inviteUrl</textarea>
                </div>
            }
            @if (_inviteError is not null)
            {
                <div class="login-error">@_inviteError</div>
            }
        </Panel>

        <Panel Title="Board access">
            @if (_boards is null)
            {
                <Spinner />
            }
            else if (_boards.Count == 0)
            {
                <p class="muted">No boards connected yet. Once a board is connected (Board app), give members a role on it here.</p>
            }
            else
            {
                <div class="form-grid">
                    <Field Label="Board">
                        <select class="prefs-select" value="@(_boardId?.ToString() ?? "")" @onchange="OnBoardChanged">
                            @foreach (var b in _boards)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </Field>
                </div>
                <p class="page-sub">
                    @if (_boardMembers.Count == 0)
                    {
                        <span>Open — everyone in <code>@_tenantId</code> works on this board with their workspace role. Add a member to restrict it.</span>
                    }
                    else
                    {
                        <span>Restricted — only the @_boardMembers.Count member(s) below, admins and auditors can see this board.</span>
                    }
                </p>
                <table class="data-table">
                    <thead>
                        <tr><th>Member</th><th>Board role</th><th class="actions">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var bm in _boardMembers)
                        {
                            <tr>
                                <td>@MemberName(bm.UserId)</td>
                                <td>
                                    <select class="prefs-select" value="@bm.Role" disabled="@(_busyId == bm.UserId)"
                                            aria-label="@($"Board role of {MemberName(bm.UserId)}")"
                                            @onchange="@(e => SetBoardRole(bm.UserId, e.Value?.ToString()))">
                                        @foreach (var role in UserRoles.WorkspaceAssignable)
                                        {
                                            <option value="@role">@UserRoles.Label(role)</option>
                                        }
                                    </select>
                                </td>
                                <td class="actions">
                                    <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Danger" Disabled="@(_busyId == bm.UserId)"
                                         OnClick="@(() => RemoveBoardRole(bm.UserId))">
                                        <Icon Name="x" Size="13" /> Remove
                                    </Btn>
                                </td>
                            </tr>
                        }
                        @if (_boardMembers.Count == 0)
                        {
                            <tr><td colspan="3" class="data-empty">No board members — the board is open to the whole workspace.</td></tr>
                        }
                    </tbody>
                </table>
                <div class="form-grid">
                    <Field Label="Member">
                        <select class="prefs-select" @bind="_addUserId">
                            <option value="">Choose a member…</option>
                            @foreach (var m in _members.Where(m => _boardMembers.All(b => b.UserId != m.Id)))
                            {
                                <option value="@m.Id">@m.Username</option>
                            }
                        </select>
                    </Field>
                    <Field Label="Board role">
                        <select class="prefs-select" @bind="_addRole">
                            @foreach (var role in UserRoles.WorkspaceAssignable)
                            {
                                <option value="@role">@UserRoles.Label(role) — @UserRoles.Describe(role)</option>
                            }
                        </select>
                    </Field>
                </div>
                <div class="form-actions">
                    <Btn Variant="Btn.ButtonVariant.Primary" OnClick="AddBoardMember" Disabled="@(string.IsNullOrEmpty(_addUserId) || _busyId is not null)">
                        Add to board
                    </Btn>
                </div>
            }
        </Panel>
    }
}

<Dialog Show="_confirmRemove is not null" Title="Remove member" Width="380" Destructive="true" OnClose="@(() => _confirmRemove = null)">
    <ChildContent>
        @if (_confirmRemove is not null)
        {
            <p>Permanently remove <strong>@_confirmRemove.Username</strong> from <code>@_tenantId</code>?</p>
            <p class="muted">Deletes the Keycloak account and disconnects their paired computers. This cannot be undone.</p>
        }
    </ChildContent>
    <Footer>
        <Btn OnClick="@(() => _confirmRemove = null)" Disabled="_removing">Cancel</Btn>
        <Btn Variant="Btn.ButtonVariant.Danger" OnClick="ConfirmRemove" Loading="_removing">Remove</Btn>
    </Footer>
</Dialog>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _resolved;
    private bool _isAdmin;
    private string _tenantId = "default";
    private string? _myUserId;

    private IReadOnlyList<KeycloakUser>? _members;
    private bool _loading;
    private string? _loadError;
    private string? _busyId;

    private KeycloakUser? _confirmRemove;
    private bool _removing;

    private string _inviteEmail = "";
    private string _inviteRole = MemberRoles.DefaultRole;

    // Board access (RBAC v2 per-board memberships).
    private IReadOnlyList<WorkspaceEntity>? _boards;
    private Guid? _boardId;
    private IReadOnlyList<WorkspaceMember> _boardMembers = [];
    private string _addUserId = "";
    private string _addRole = UserRoles.Developer;
    private int _inviteTtl = 24;
    private bool _busy;
    private string? _inviteUrl;
    private DateTimeOffset _inviteExpiresAt;
    private string? _inviteError;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            var user = state.User;
            _isAdmin = user.Can(Permission.ManageMembers); // RBAC v2 re-check (PermissionMatrix)
            // No silent `default`: a signed-in principal with no tenant claim is a malformed token, not a
            // licence to manage the default tenant's members. Empty → the admin gate below blocks the UI.
            _tenantId = user.GetTenantId() ?? string.Empty;
            _myUserId = user.GetUserId();
        }
        _resolved = true;

        if (_isAdmin && _tenantId.Length > 0)
        {
            await LoadMembersAsync();
            await LoadBoardsAsync();
        }
    }

    private static string PrimaryRole(KeycloakUser m) => MemberRoles.Primary(m.Roles) ?? UserRoles.Viewer;

    private string MemberName(string userId) =>
        _members?.FirstOrDefault(m => m.Id == userId)?.Username ?? userId;

    // Each operation gets its own scope (its own DbContext), never the circuit's long-lived one.
    private async Task LoadBoardsAsync()
    {
        await CircuitSafe.RunAsync(
            async () =>
            {
                await using var scope = Scopes.CreateAsyncScope();
                _boards = await scope.ServiceProvider.GetRequiredService<IWorkspaceRepository>().ListForTenantAsync(_tenantId);
                _boardId ??= _boards.FirstOrDefault()?.Id;
                await LoadBoardMembersAsync(scope.ServiceProvider);
            },
            ex => { _boards = []; Toasts.Show("Users", $"Could not load boards: {ex.Message}", ToastKind.Err); });
    }

    private async Task LoadBoardMembersAsync(IServiceProvider services)
    {
        _boardMembers = _boardId is { } id
            ? await services.GetRequiredService<IWorkspaceMembershipStore>().ListAsync(_tenantId, id)
            : [];
    }

    private async Task OnBoardChanged(ChangeEventArgs e)
    {
        _boardId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await using var scope = Scopes.CreateAsyncScope();
        await CircuitSafe.RunAsync(() => LoadBoardMembersAsync(scope.ServiceProvider),
            ex => Toasts.Show("Users", $"Could not load the board's members: {ex.Message}", ToastKind.Err));
    }

    private Task AddBoardMember() => SetBoardRole(_addUserId, _addRole);

    private async Task SetBoardRole(string? userId, string? role)
    {
        // Server-side re-check (GAP-17): the handler, not only the hidden UI, refuses a caller without ManageMembers.
        if (!_isAdmin || _boardId is not { } boardId || string.IsNullOrEmpty(userId) || !UserRoles.IsWorkspaceAssignable(role)) { return; }
        if (_members?.Any(m => m.Id == userId) != true) { return; }   // only members of THIS tenant
        _busyId = userId;
        await CircuitSafe.RunAsync(
            async () =>
            {
                await using var scope = Scopes.CreateAsyncScope();
                var services = scope.ServiceProvider;
                await services.GetRequiredService<IWorkspaceMembershipStore>().SetAsync(_tenantId, boardId, userId, role, _myUserId);
                await services.GetRequiredService<IAuditLog>().WriteAsync(new AuditEntry(Guid.NewGuid(), _tenantId, _myUserId,
                    AuditActions.BoardRoleSet, $"board={boardId},user={userId},role={role}", null, null, DateTimeOffset.UtcNow));
                Toasts.Show("Users", $"{MemberName(userId)} is a {UserRoles.Label(role)} on this board.", ToastKind.Ok);
                _addUserId = "";
                await LoadBoardMembersAsync(services);
            },
            ex => Toasts.Show("Users", $"Board role change failed: {ex.Message}", ToastKind.Err));
        _busyId = null;
    }

    private async Task RemoveBoardRole(string userId)
    {
        if (!_isAdmin || _boardId is not { } boardId) { return; }
        _busyId = userId;
        await CircuitSafe.RunAsync(
            async () =>
            {
                await using var scope = Scopes.CreateAsyncScope();
                var services = scope.ServiceProvider;
                if (await services.GetRequiredService<IWorkspaceMembershipStore>().RemoveAsync(_tenantId, boardId, userId))
                {
                    await services.GetRequiredService<IAuditLog>().WriteAsync(new AuditEntry(Guid.NewGuid(), _tenantId, _myUserId,
                        AuditActions.BoardRoleRemoved, $"board={boardId},user={userId}", null, null, DateTimeOffset.UtcNow));
                    Toasts.Show("Users", $"{MemberName(userId)} was taken off this board.", ToastKind.Ok);
                }
                await LoadBoardMembersAsync(services);
            },
            ex => Toasts.Show("Users", $"Remove failed: {ex.Message}", ToastKind.Err));
        _busyId = null;
    }

    private async Task LoadMembersAsync()
    {
        _loading = true;
        _loadError = null;
        // Keycloak typed-HttpClient raises transport (HttpRequestException) + Polly (TimeoutRejected/
        // BrokenCircuit : System.Exception) faults — surface ANY, never tear down the admin circuit.
        await CircuitSafe.RunAsync(
            async () => _members = await Kc.ListUsersByTenantAsync(_tenantId),
            ex => _loadError = ex.Message);
        _loading = false;
    }

    private async Task Reload() => await LoadMembersAsync();

    private async Task ChangeRole(KeycloakUser m, ChangeEventArgs e)
    {
        var role = e.Value?.ToString() ?? MemberRoles.DefaultRole;
        if (!_isAdmin || string.Equals(PrimaryRole(m), role, StringComparison.Ordinal)) { return; }
        // Same rules as PATCH /tenants/{id}/members/{userId}: allowed roles only, never strip your own admin role.
        var roles = MemberRoles.Sanitize([role]);
        if (MemberRoles.Check(_myUserId, m.Id, roles) is { } refused)
        {
            Toasts.Show("Users", refused, ToastKind.Err);
            return;
        }
        _busyId = m.Id;
        // Keycloak transport/Polly faults must surface as a toast, never tear down the circuit.
        await CircuitSafe.RunAsync(
            async () =>
            {
                await Kc.UpdateUserRolesAsync(m.Id, roles);
                await using var scope = Scopes.CreateAsyncScope();
                await scope.ServiceProvider.GetRequiredService<IAuditLog>().WriteAsync(new AuditEntry(Guid.NewGuid(), _tenantId, _myUserId,
                    AuditActions.MemberRoleChanged, $"user={m.Id},roles={string.Join('+', roles)}", null, null, DateTimeOffset.UtcNow));
                Toasts.Show("Users", $"{m.Username} is now {UserRoles.Label(role)}.", ToastKind.Ok);
                await LoadMembersAsync();
            },
            ex => Toasts.Show("Users", $"Role change failed: {ex.Message}", ToastKind.Err));
        _busyId = null;
    }

    private async Task ResetPassword(KeycloakUser m)
    {
        _busyId = m.Id;
        // Keycloak transport/Polly faults must surface as a toast, never tear down the circuit.
        await CircuitSafe.RunAsync(
            async () =>
            {
                await Kc.SendPasswordResetEmailAsync(m.Id);
                Toasts.Show("Users", $"Password-reset email sent to {m.Username}.", ToastKind.Ok);
            },
            ex => Toasts.Show("Users", $"Reset failed: {ex.Message}", ToastKind.Err));
        _busyId = null;
    }

    private void AskRemove(KeycloakUser m) => _confirmRemove = m;

    private async Task ConfirmRemove()
    {
        var m = _confirmRemove;
        if (m is null) { return; }
        _removing = true;
        _busyId = m.Id;
        // GAP-04: their paired computers are revoked FIRST, then the account is deleted, then the member.removed audit row
        // is written (MemberRemoval). Each step's failure says what did and didn't happen; nothing tears down the circuit.
        await CircuitSafe.RunAsync(
            async () =>
            {
                // A fresh scope (its own DbContexts) for this one operation, not the circuit's long-lived one.
                await using var scope = Scopes.CreateAsyncScope();
                var services = scope.ServiceProvider;
                var result = await MemberRemoval.RemoveAsync(_tenantId, m.Id, new MemberRemovalActor(_myUserId),
                    Kc, services.GetRequiredService<IAuditLog>(), services.GetService<AgentOs.Domain.Sessions.IRunnerDirectory>(),
                    RunnerDisconnector, Loggers.CreateLogger(typeof(MemberRemoval).FullName!));
                ShowRemoval(m, result);
                await LoadMembersAsync();
            },
            ex => Toasts.Show("Users", $"Remove failed: {ex.Message}", ToastKind.Err));
        _removing = false;
        _busyId = null;
        _confirmRemove = null;
    }

    // One toast per outcome: never "Remove failed" for a member who is gone.
    private void ShowRemoval(KeycloakUser m, MemberRemovalResult result)
    {
        var computers = result.ComputersRevoked == 1 ? "1 computer" : $"{result.ComputersRevoked} computers";
        switch (result.Outcome)
        {
            case MemberRemovalOutcome.Removed when result.Warning is not null:
                Toasts.Show("Users", $"Removed {m.Username}. {result.Warning}", ToastKind.Warn);
                break;
            case MemberRemovalOutcome.Removed:
                Toasts.Show("Users", result.ComputersRevoked == 0 ? $"Removed {m.Username}." : $"Removed {m.Username} and disconnected {computers}.", ToastKind.Ok);
                break;
            case MemberRemovalOutcome.AccountNotDeleted:
                Toasts.Show("Users", $"{m.Username} was not removed ({result.Error}). Their computers were disconnected — try again.", ToastKind.Err);
                break;
            default:
                Toasts.Show("Users", $"{m.Username} was not removed. {result.Error}", ToastKind.Err);
                break;
        }
    }

    private async Task MintInvite()
    {
        if (_busy) { return; }
        _inviteError = null;

        // Required-field gate: an invitation must go to an address. Inline error, no toast —
        // the user is looking at the form.
        var email = _inviteEmail.Trim();
        if (email.Length == 0 || !email.Contains('@', StringComparison.Ordinal))
        {
            _inviteError = "Enter the invitee's email address (must contain '@').";
            return;
        }

        if (!MemberRoles.IsAllowed(_inviteRole))
        {
            _inviteError = "Pick a role for the invitee.";
            return;
        }

        _busy = true;
        try
        {
            var ttl = TimeSpan.FromHours(Math.Clamp(_inviteTtl, 1, 168));
            var token = Signup.CreateInvitation(_tenantId, _inviteRole, email, ttl);
            _inviteExpiresAt = token.ExpiresAtUtc;
            _inviteUrl = $"/signup?invite={Uri.EscapeDataString(token.Token)}";

            // Email the absolute link. Best-effort: the URL stays on screen for copy/paste so the
            // admin is never blocked if delivery is unconfigured or fails.
            var absoluteUrl = Nav.ToAbsoluteUri(_inviteUrl).ToString();
            try
            {
                var (subject, htmlBody, textBody) = AgentOs.Modules.Tenants.Email.InvitationEmail.Build(_tenantId, _inviteRole, absoluteUrl);
                await Email.SendAsync(email, subject, htmlBody, textBody);
                Toasts.Show("Users", $"Invitation emailed to {email}.", ToastKind.Ok);
            }
            catch (MailKit.CommandException ex)
            {
                Toasts.Show("Users", $"Invitation created, but email failed: {ex.Message}. Copy the link below.", ToastKind.Warn);
            }
            catch (MailKit.ProtocolException ex)
            {
                Toasts.Show("Users", $"Invitation created, but email failed: {ex.Message}. Copy the link below.", ToastKind.Warn);
            }
            catch (MailKit.ServiceNotConnectedException ex)
            {
                Toasts.Show("Users", $"Invitation created, but email failed: {ex.Message}. Copy the link below.", ToastKind.Warn);
            }
            catch (MailKit.Security.AuthenticationException ex)
            {
                Toasts.Show("Users", $"Invitation created, but email failed: {ex.Message}. Copy the link below.", ToastKind.Warn);
            }
            catch (System.Net.Sockets.SocketException ex)
            {
                Toasts.Show("Users", $"Invitation created, but email failed: {ex.Message}. Copy the link below.", ToastKind.Warn);
            }
            catch (System.IO.IOException ex)
            {
                Toasts.Show("Users", $"Invitation created, but email failed: {ex.Message}. Copy the link below.", ToastKind.Warn);
            }
            catch (System.InvalidOperationException ex)
            {
                Toasts.Show("Users", $"Invitation created, but email failed: {ex.Message}. Copy the link below.", ToastKind.Warn);
            }
        }
        catch (ArgumentException ex) { _inviteError = ex.Message; }
        finally { _busy = false; }
    }
}
