@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AgentOs.Modules.Tenants.ITenantSignupService SignupSvc

<PageTitle>Sign in — AgentOS.NET</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <BrandMark Size="44" Decorative="true" />
        <div>
            <div class="brand-title">AgentOS.NET</div>
            <div class="brand-sub">.NET multi-agent framework</div>
        </div>
    </div>

    <div class="login-form">
        <a class="btn btn-primary login-btn" href="@LoginHref">
            <span class="btn-ic"><Icon Name="lock" Size="14" /></span>
            Sign in with Keycloak
        </a>
        @if (_openSignup)
        {
            <div class="login-hint">
                Don't have an account?
                <a href="/signup">Create one</a>
            </div>
        }
        else
        {
            <div class="login-hint">Don't have an account? Ask your administrator for an invitation.</div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    // GAP-01: the "Create one" link shows only when the platform allows open self-signup.
    private bool _openSignup;

    protected override async Task OnInitializedAsync() => _openSignup = await SignupSvc.IsOpenSignupEnabledAsync();

    private string LoginHref => string.IsNullOrWhiteSpace(ReturnUrl)
        ? "/account/login"
        : $"/account/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
}
