@* PlatformSettingsApp — platform admins only: settings that apply to EVERY tenant (ADR-0011, Phase C.5b) —
   the remote-execution and tool-policy safety switches, the self-hosted Git host allowlist, and the offline
   LLM fallback. A tenant admin never sees this category; production pins the riskiest switches with
   Settings:Locks, which render read-only here with the reason. Rendered from setting descriptors. *@

@using Microsoft.AspNetCore.Components.Authorization

@if (!_resolved)
{
    <Spinner />
}
else if (!_isPlatformAdmin)
{
    <div class="login-error">Platform admin role required. These settings apply to every tenant.</div>
}
else
{
    <header class="page-head">
        <div>
            <h1 class="page-title">Platform</h1>
            <p class="page-sub">Settings that apply to every tenant. Changes take effect on the next request — no restart. Values pinned by the operator are read-only.</p>
        </div>
    </header>

    <Panel Title="Safety">
        <SettingsFields Area="Platform" TenantId="@_tenantId" Actor="@_actor" CanEditPlatform="true" Keys="@SafetyKeys" />
    </Panel>

    <Panel Title="Run limits (per tenant)">
        <SettingsFields Area="Platform" TenantId="@_tenantId" Actor="@_actor" CanEditPlatform="true" Keys="@LimitKeys" />
    </Panel>
    <Panel Title="Build sandbox">
        <SettingsFields Area="Platform" TenantId="@_tenantId" Actor="@_actor" CanEditPlatform="true" Keys="@BuildKeys" />
    </Panel>

    <Panel Title="LLM">
        <SettingsFields Area="Platform" TenantId="@_tenantId" Actor="@_actor" CanEditPlatform="true" Keys="@LlmKeys" />
    </Panel>
    <Panel Title="Self-hosted models (OpenAI-compatible)">
        <p class="muted platform-hint">vLLM, Ollama, LM Studio, Azure AI Foundry or a corporate gateway. Pick <code>OpenAICompatible</code> as an agent's provider (or force it) in LLM &amp; providers. Platform-only: AgentOS.NET calls this endpoint from the server.</p>
        <SettingsFields Area="Platform" TenantId="@_tenantId" Actor="@_actor" CanEditPlatform="true" Keys="@CompatKeys" />
    </Panel>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly string[] SafetyKeys =
    [
        AgentOs.Modules.RemoteAgent.ConfigGatedRemoteExecApprover.AutoApproveKey,
        AgentOs.Modules.Tools.ToolsSettings.EnforceByDefault,
        "Workspaces:AllowedHosts",
    ];

    private static readonly string[] LlmKeys = [AgentOs.Modules.Llm.LlmSettings.OfflineFallback];
    private static readonly string[] CompatKeys =
    [
        AgentOs.Modules.Llm.LlmSettings.CompatEndpoint,
        AgentOs.Modules.Llm.LlmSettings.CompatApiKey,
        AgentOs.Modules.Llm.LlmSettings.CompatModel,
        AgentOs.Modules.Llm.LlmSettings.CompatInputPrice,
        AgentOs.Modules.Llm.LlmSettings.CompatOutputPrice,
    ];
    private static readonly string[] LimitKeys =
    [
        AgentOs.Modules.Pipeline.Limits.RunLimitSettings.MaxConcurrent,
        AgentOs.Modules.Pipeline.Limits.RunLimitSettings.PerMinute,
    ];

    private static readonly string[] BuildKeys =
    [
        AgentOs.Modules.Integration.BuildVerifierSettings.Enabled,
        AgentOs.Modules.Integration.BuildVerifierSettings.Sandbox,
        AgentOs.Modules.Integration.BuildVerifierSettings.ContainerImage,
        AgentOs.Modules.Integration.BuildVerifierSettings.CpuLimit,
        AgentOs.Modules.Integration.BuildVerifierSettings.MemoryLimit,
        AgentOs.Modules.Integration.BuildVerifierSettings.PidsLimit,
        AgentOs.Modules.Integration.BuildVerifierSettings.TimeoutSeconds,
    ];

    private bool _resolved;
    private bool _isPlatformAdmin;
    private string _tenantId = string.Empty;
    private string _actor = "platform-admin";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _isPlatformAdmin = state.User.IsPlatformAdmin();
            _tenantId = state.User.GetTenantId() ?? string.Empty;
            _actor = state.User.Identity?.Name ?? _actor;
        }
        _resolved = true;
    }
}
