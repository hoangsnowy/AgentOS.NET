    // ── "Start from idea" wizard (bootstrap) ─────────────────────────────────────────────────────

    // Only boards with a Projects v2 number can take new tickets (each issue is added to the board).
    private IEnumerable<WorkspaceEntity> IdeaBoards()
        => _boards?.Where(b => b.ProjectNumber is not null) ?? Enumerable.Empty<WorkspaceEntity>();

    private string StepClass(IdeaStep step)
        => _ideaStep == step ? "active" : (_ideaStep > step ? "done" : "");

    private async Task OnIdeaBoardChanged()
    {
        _ideaRepoId = "";
        _ideaRepos = null;
        var board = IdeaBoards().FirstOrDefault(b => b.Id.ToString() == _ideaBoardId);
        if (board is not null)
        {
            _ideaRepos = await Workspaces.ListReposForTenantAsync(_tenantId, board.Id);
        }
    }

    // Generate spec + tickets from the idea. The bootstrap service (and the LLM-backed agents it
    // builds) is resolved LAZILY in a fresh scope — never @inject'd — so opening the app never eagerly
    // constructs an LLM client and crashes the circuit (the documented eager-DI landmine).
    private async Task GenerateIdea()
    {
        if (_ideaBusy) { return; }
        if (string.IsNullOrWhiteSpace(_ideaText))
        {
            _ideaError = "Describe your idea first.";
            return;
        }
        if (string.IsNullOrEmpty(_ideaBoardId) || string.IsNullOrEmpty(_ideaRepoId))
        {
            _ideaError = "Pick a target board and repository.";
            return;
        }
        _ideaBusy = true;
        _ideaError = null;
        // The LLM-backed bootstrap agents throw LlmException (: System.Exception) on a missing key or
        // parse failure — surface ANY failure, never tear down the circuit (see CircuitSafe).
        await CircuitSafe.RunAsync(
            async () =>
            {
                using var scope = ScopeFactory.CreateScope();
                var svc = scope.ServiceProvider.GetRequiredService<IIdeaBootstrapService>();
                _preview = await svc.GenerateAsync(_ideaText.Trim());

                _draftRows.Clear();
                foreach (var t in _preview.Tickets)
                {
                    _draftRows.Add(new DraftRow
                    {
                        Title = t.Title,
                        Body = t.Body,
                        Labels = t.Labels.ToList(),
                        AiReady = t.AiReady,
                    });
                }
                _ideaStep = IdeaStep.Review;
            },
            ex => _ideaError = $"Generation failed: {ex.Message}");
        _ideaBusy = false;
    }

    // Flip a ticket's ai gate, keeping the ai:ready / needs-human label in sync with the flag.
    private static void ToggleAiReady(DraftRow row, ChangeEventArgs e)
    {
        row.AiReady = e.Value is true;
        row.Labels.RemoveAll(l =>
            string.Equals(l, StandardLabels.AiReady, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(l, StandardLabels.NeedsHuman, StringComparison.OrdinalIgnoreCase));
        row.Labels.Add(row.AiReady ? StandardLabels.AiReady : StandardLabels.NeedsHuman);
    }

    // Seed labels, then create the (edited) tickets as real issues on the chosen repo + add to board.
    // When runReady, auto-run a session per ai:ready ticket — the review step was the human gate, so
    // this is the autonomous idea→PRs path.
    private async Task CreateTickets(bool runReady)
    {
        if (_ideaBusy) { return; }
        var board = IdeaBoards().FirstOrDefault(b => b.Id.ToString() == _ideaBoardId);
        var repo = (_ideaRepos ?? Array.Empty<WorkspaceRepoEntity>()).FirstOrDefault(r => r.Id.ToString() == _ideaRepoId);
        if (board is null || repo is null)
        {
            _ideaError = "Pick a target board and repository.";
            return;
        }
        if (runReady && EngineSelection.Validate(_brain, _runOnMachine) is { } brainErr)
        {
            _ideaError = brainErr;
            return;
        }
        _ideaBusy = true;
        _ideaError = null;
        try
        {
            var pat = await ConfigStore.GetForTenantAsync(_tenantId, board.CredentialRef);
            if (string.IsNullOrEmpty(pat))
            {
                _ideaError = "Could not retrieve board credentials. Reconnect the board.";
                return;
            }

            var branch = string.IsNullOrWhiteSpace(repo.DefaultBranch) ? "main" : repo.DefaultBranch;
            var repoDesc = new WorkspaceDescriptor(
                repo.Id, _tenantId, board.Kind, repo.Owner, repo.Repo, board.Project, branch, pat);
            var boardDesc = new BoardDescriptor(
                board.Id, _tenantId, board.Kind, board.ProjectOwner, board.ProjectScope,
                board.ProjectNumber, board.ProjectNodeId, pat, board.Project);

            // Seed the taxonomy first so issue creation can apply the labels.
            await BoardWriteSvc.EnsureLabelsAsync(repoDesc, StandardLabels.All);

            var drafts = _draftRows
                .Where(r => !string.IsNullOrWhiteSpace(r.Title))
                .Select(r => new TicketDraft(r.Title.Trim(), r.Body, r.Labels.ToList(), r.AiReady))
                .ToList();
            _createdTickets = await BoardWriteSvc.CreateTicketsAsync(boardDesc, repoDesc, drafts);

            Toasts.Show("Board", $"Created {_createdTickets.Count} ticket(s) on {repo.Owner}/{repo.Repo}.", ToastKind.Ok);

            // Auto-run: one session per ai:ready created ticket (created order matches the drafts sent).
            if (runReady)
            {
                var repoOpt = new RepoOption { Owner = repo.Owner, Repo = repo.Repo, DefaultBranch = branch, WorkspaceRepoId = repo.Id, Selected = true };
                var sessions = new List<RemoteSessionEntity>();
                for (var i = 0; i < _createdTickets.Count && i < drafts.Count; i++)
                {
                    if (!drafts[i].AiReady) { continue; }
                    var t = _createdTickets[i];
                    sessions.Add(await PersistSessionAsync(
                        board.Id, t.Number, $"#{t.Number} {t.Title}", t.ItemNodeId, "Issue", [repoOpt], _runOnMachine,
                        brain: _brain, ticketType: TicketTypeOf(drafts[i].Labels)));
                }
                if (sessions.Count > 0)
                {
                    Toasts.Show("Board", $"Starting {sessions.Count} approved ticket(s)…", ToastKind.Ok);
                    await ReloadAll();
                    ResetIdea();
                    _tab = Tab.Sessions;
                    foreach (var s in sessions)
                    {
                        await RunSession(s);
                    }
                    return;
                }
            }

            _ideaStep = IdeaStep.Result;
        }
        catch (System.Net.Http.HttpRequestException ex) { HandleCreateError(ex); }
        catch (System.Text.Json.JsonException ex) { HandleCreateError(ex); }
        catch (InvalidOperationException ex) { HandleCreateError(ex); }
        catch (System.IO.IOException ex) { HandleCreateError(ex); }
        catch (TimeoutException ex) { HandleCreateError(ex); }
        finally
        {
            _ideaBusy = false;
        }

        void HandleCreateError(Exception ex)
        {
            _ideaError = $"Create failed: {ex.Message}";
            Toasts.Show("Board", _ideaError, ToastKind.Err);
        }
    }

    private void ResetIdea()
    {
        _ideaStep = IdeaStep.Input;
        _ideaText = "";
        _preview = null;
        _draftRows.Clear();
        _createdTickets = Array.Empty<CreatedTicket>();
        _ideaError = null;
        _runOnMachine = false;
    }

    // ── Tickets → session ────────────────────────────────────────────────────────────────────────

    // Open the repo-picker dialog for a ticket: offer the board's repos + the ticket's own repo,
    // pre-selecting the ticket's repo.
    private void OpenWorkDialog(BoardTicket ticket)
    {
        if (ticket.RepoOwner is null || ticket.RepoName is null) { return; }
        _workTicket = ticket;
        _workRepoOptions.Clear();
        foreach (var r in _repos ?? Array.Empty<WorkspaceRepoEntity>())
        {
            _workRepoOptions.Add(new RepoOption
            {
                Owner = r.Owner,
                Repo = r.Repo,
                DefaultBranch = r.DefaultBranch,
                WorkspaceRepoId = r.Id,
                Selected = r.Owner == ticket.RepoOwner && r.Repo == ticket.RepoName,
            });
        }
        // The ticket's own repo may not be a curated board repo — add it (pre-selected).
        if (!_workRepoOptions.Any(o => o.Owner == ticket.RepoOwner && o.Repo == ticket.RepoName))
        {
            _workRepoOptions.Insert(0, new RepoOption
            {
                Owner = ticket.RepoOwner,
                Repo = ticket.RepoName,
                DefaultBranch = "main",
                Selected = true,
            });
        }
        _runOnMachine = false;
        _confirmPersonTicket = false;
        _showWorkDialog = true;
    }

    // A ticket meant for a person: an epic, or one a planner flagged needs-human. One click must not hand it to the
    // AI (a member started the whole M1 epic by mistake on the first real project).
    private bool _confirmPersonTicket;

    private static bool NeedsPerson(BoardTicket ticket) =>
        ticket.Labels.Any(l => l.Equals("needs-human", StringComparison.OrdinalIgnoreCase)
                               || l.Equals("epic", StringComparison.OrdinalIgnoreCase)
                               || l.Equals("type:epic", StringComparison.OrdinalIgnoreCase));

    private void CloseWorkDialog()
    {
        _showWorkDialog = false;
        _workTicket = null;
    }

    // Cross-link — open the ticket as a story in the Workflow app (the run surface), prefilling the story
    // via a one-shot launch payload so the ticket → run handoff reads as one engine.
    private void OpenInWorkflow(BoardTicket ticket)
    {
        var app = AgentOs.Web.Services.AppCatalog.Find("workflow");
        if (app is null) { return; }
        var story = ticket.Number is { } n ? $"#{n} {ticket.Title}".Trim() : ticket.Title.Trim();
        WM.RequestLaunchPayload("workflow", story);
        WM.OpenApp(app.Key, app.Title, app.Icon, app.W, app.H);
    }

    private async Task ConfirmWorkSession()
    {
        if (_busy || _selectedBoard is null || _workTicket is null) { return; }
        if (NeedsPerson(_workTicket) && !_confirmPersonTicket) { return; }
        var selected = _workRepoOptions.Where(o => o.Selected).ToList();
        if (selected.Count == 0)
        {
            Toasts.Show("Board", "Select at least one repository.", ToastKind.Err);
            return;
        }
        if (EngineSelection.Validate(_brain, _runOnMachine) is { } brainErr)
        {
            Toasts.Show("Board", brainErr, ToastKind.Err);
            return;
        }
        _busy = true;
        try
        {
            var ticket = _workTicket;
            // The ticket's own repo becomes the session's primary repo — put it first.
            var ordered = selected
                .OrderByDescending(o => o.Owner == ticket.RepoOwner && o.Repo == ticket.RepoName)
                .ToList();
            var created = await PersistSessionAsync(
                _selectedBoard.Id, ticket.Number, $"#{ticket.Number} {ticket.Title}",
                ticket.ItemNodeId, ticket.Kind.ToString(), ordered, _runOnMachine,
                brain: _brain, ticketType: TicketTypeOf(ticket.Labels));

            // "Start working" means it: the task starts now (it used to sit as a draft until Run was pressed on Tasks).
            CloseWorkDialog();
            await ReloadAll();
            _tab = Tab.Sessions;
            CloseBoard();
            await RunSession(created);
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Couldn't start the task: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Couldn't start the task: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Couldn't start the task: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Couldn't start the task: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busy = false;
        }
    }

    // True when the member has at least one runner that isn't revoked — gates the "run on my machine"
    // hint (the dispatch itself still fails clearly if no runner is actually live).
    private bool HasRunner() => _runners?.Any(r => r.Status != "Revoked") == true;

    // Persist a session (+ its repo rows) for a ticket; returns the entity so the caller can run it.
    // The single source of truth for "ticket → session", shared by Work-on-this, Run-all-ready, and
    // the idea-wizard auto-run. repos[0] is the primary repo.
    private async Task<RemoteSessionEntity> PersistSessionAsync(
        Guid workspaceId, int? issueNumber, string title, string? itemNodeId, string ticketKind,
        IReadOnlyList<RepoOption> repos, bool runOnMachine = false, string brain = "Quick", string? ticketType = null)
    {
        var sessionId = Guid.NewGuid();
        var primary = repos[0];
        var session = new RemoteSessionEntity
        {
            Id = sessionId,
            TenantId = _tenantId,
            WorkspaceId = workspaceId,
            MemberUserId = _userId,
            Title = title,
            Status = "Draft",
            IssueNumber = issueNumber,
            RepoOwner = primary.Owner,
            RepoName = primary.Repo,
            RepoDefaultBranch = primary.DefaultBranch,
            BoardItemNodeId = itemNodeId,
            TicketKind = ticketKind,
            RunOnMachine = runOnMachine,
            Brain = brain,
            TicketType = ticketType,
            CreatedAtUtc = DateTimeOffset.UtcNow,
            CreatedByUserId = string.IsNullOrEmpty(_userId) ? null : _userId,
        };
        await Sessions.AddForTenantAsync(session);

        foreach (var opt in repos)
        {
            await Sessions.AddRepoForTenantAsync(new SessionRepoEntity
            {
                Id = Guid.NewGuid(),
                TenantId = _tenantId,
                SessionId = sessionId,
                WorkspaceRepoId = opt.WorkspaceRepoId,
                Owner = opt.Owner,
                Repo = opt.Repo,
                DefaultBranch = opt.DefaultBranch,
                Status = "Pending",
            });
        }
        return session;
    }

    // The ticket's `type:*` label (type:feature / type:bug / …), captured so the greenfield router can
    // hard-gate the Quality engine. First match wins; null when the ticket carries no type label.
    private static string? TicketTypeOf(IEnumerable<string>? labels) =>
        labels?.FirstOrDefault(l => l.StartsWith("type:", StringComparison.OrdinalIgnoreCase));

    // A1 residue — the single builder for the repo-level, token-carrying WorkspaceDescriptor the source /
    // PR / label services consume (transient; the PAT is resolved per call, never persisted). Kind +
    // Project come from the board (the workspace); the descriptor Id is the board's workspace id.
    private static WorkspaceDescriptor RepoDescriptor(
        WorkspaceEntity board, string tenantId, string owner, string repo, string defaultBranch, string pat) =>
        new(board.Id, tenantId, board.Kind, owner, repo, board.Project,
            string.IsNullOrWhiteSpace(defaultBranch) ? "main" : defaultBranch, pat);

    // Read the ticket's CURRENT body (third-party text — the agent prompts fence it as untrusted data).
    // Best-effort: an unsupported backend, a missing ticket, or a network/API failure yields null and the
    // run proceeds on the title alone rather than failing.
    private static async Task<string?> ReadTicketBodyAsync(
        IServiceScope scope, WorkspaceEntity board, string tenantId, RemoteSessionEntity session, string pat)
    {
        if (session.IssueNumber is not > 0 || string.IsNullOrWhiteSpace(session.RepoOwner) || string.IsNullOrWhiteSpace(session.RepoName))
        {
            return null;
        }
        var resolver = scope.ServiceProvider.GetRequiredService<ISourceProviderResolver>();
        if (!resolver.TryResolve(board.Kind, out var provider) || provider is null)
        {
            return null;
        }
        var repo = RepoDescriptor(board, tenantId, session.RepoOwner, session.RepoName, session.RepoDefaultBranch ?? "main", pat);
        try
        {
            return await provider.ReadTicketBodyAsync(repo, session.IssueNumber.Value).ConfigureAwait(false);
        }
        catch (System.Net.Http.HttpRequestException) { return null; }
        catch (Octokit.ApiException) { return null; }
        catch (InvalidOperationException) { return null; }
        catch (TaskCanceledException) { return null; }
    }

    // The target repo's agent-instruction files, budgeted (E0.7). Best-effort like the ticket body: a backend
    // without repo context or an API failure means "no guidance", never a failed run.
    private static async Task<IReadOnlyList<RepoInstructionFile>> ReadRepoGuidanceAsync(
        IServiceScope scope, WorkspaceEntity board, string tenantId, SessionRepoEntity primary, string pat)
    {
        var resolver = scope.ServiceProvider.GetRequiredService<ISourceProviderResolver>();
        if (!resolver.TryResolve(board.Kind, out var provider) || provider is null)
        {
            return [];
        }
        var repo = RepoDescriptor(board, tenantId, primary.Owner, primary.Repo, primary.DefaultBranch, pat);
        try
        {
            return (await provider.ReadRepoContextAsync(repo).ConfigureAwait(false)).Instructions;
        }
        catch (System.Net.Http.HttpRequestException) { return []; }
        catch (Octokit.ApiException) { return []; }
        catch (InvalidOperationException) { return []; }
        catch (TaskCanceledException) { return []; }
    }

    // The ai:ready tickets on the board that the agent can run unattended (real issue, has a repo).
    private List<BoardTicket> ReadyTickets() => _tickets is null
        ? new List<BoardTicket>()
        : _tickets.Where(t => t.Labels.Contains(StandardLabels.AiReady)
            && t.Kind != BoardTicketKind.DraftIssue && t.RepoOwner is not null && t.RepoName is not null).ToList();

    private RepoOption RepoOptionForTicket(BoardTicket ticket)
    {
        var curated = (_repos ?? Array.Empty<WorkspaceRepoEntity>())
            .FirstOrDefault(r => r.Owner == ticket.RepoOwner && r.Repo == ticket.RepoName);
        return new RepoOption
        {
            Owner = ticket.RepoOwner!,
            Repo = ticket.RepoName!,
            DefaultBranch = curated?.DefaultBranch ?? "main",
            WorkspaceRepoId = curated?.Id,
            Selected = true,
        };
    }

    // Batch: create a session per ai:ready ticket and run them all (the "server thinks, runner does"
    // path, unattended). Shares PersistSessionAsync + RunSession with the single-ticket flow.
    private async Task RunAllReady()
    {
        if (_busy || _selectedBoard is null) { return; }
        var ready = ReadyTickets();
        if (ready.Count == 0)
        {
            Toasts.Show("Board", "No ai:ready tickets to run.", ToastKind.Err);
            return;
        }
        _busy = true;
        try
        {
            var sessions = new List<RemoteSessionEntity>();
            foreach (var ticket in ready)
            {
                sessions.Add(await PersistSessionAsync(
                    _selectedBoard.Id, ticket.Number, $"#{ticket.Number} {ticket.Title}",
                    ticket.ItemNodeId, ticket.Kind.ToString(), [RepoOptionForTicket(ticket)],
                    ticketType: TicketTypeOf(ticket.Labels)));
            }
            Toasts.Show("Board", $"Starting {sessions.Count} approved ticket(s)…", ToastKind.Ok);
            await ReloadAll();
            _tab = Tab.Sessions;
            CloseBoard();
            foreach (var s in sessions)
            {
                await RunSession(s);
            }
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Run all failed: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Run all failed: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Run all failed: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Run all failed: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busy = false;
        }
    }

    // The Sessions table asks for every row's repos on each render; group them once per load (keyed by the list
    // instance) instead of rescanning the whole list per row — O(repos) per load, not O(sessions × repos) per render.
    private IReadOnlyList<SessionRepoEntity>? _sessionReposIndexed;
    private Dictionary<Guid, SessionRepoEntity[]> _reposBySession = new();

    // "Ready for review" rows whose pull request has since been merged → "Done". Only open-PR rows are checked, and
    // a merged row is written back, so each change costs one GitHub call in its life, on load/refresh only.
    private async Task SyncMergedAsync()
    {
        var pending = (_sessionRepos ?? Array.Empty<SessionRepoEntity>())
            .Where(r => r.Status == "Done" && !string.IsNullOrEmpty(r.PrUrl))
            .Take(20)
            .ToList();
        if (pending.Count == 0 || _boards is null) { return; }
        var changed = false;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var prs = scope.ServiceProvider.GetRequiredService<AgentOs.Domain.Workspaces.IPrCreationService>();
            var sessionsById = (_sessions ?? []).ToDictionary(s => s.Id);
            var pats = new Dictionary<Guid, string?>();
            foreach (var repo in pending)
            {
                if (!sessionsById.TryGetValue(repo.SessionId, out var session)) { continue; }
                var board = _boards.FirstOrDefault(b => b.Id == session.WorkspaceId);
                if (board is null || PrNumber(repo.PrUrl) is not { } number) { continue; }
                if (!pats.TryGetValue(board.Id, out var pat))
                {
                    pat = await ConfigStore.GetForTenantAsync(_tenantId, board.CredentialRef);
                    pats[board.Id] = pat;
                }
                if (string.IsNullOrEmpty(pat)) { continue; }
                var state = await prs.GetStateAsync(RepoDescriptor(board, _tenantId, repo.Owner, repo.Repo, repo.DefaultBranch, pat), number);
                if (state != AgentOs.Domain.Workspaces.PrState.Merged) { continue; }
                await Sessions.UpdateRepoRunResultAsync(_tenantId, repo.Id, "Merged", repo.BranchName, repo.PrUrl, null);
                await Sessions.RecomputeSessionStatusForTenantAsync(_tenantId, repo.SessionId);
                changed = true;
            }
            if (!changed) { return; }
            var all = await Sessions.ListForTenantAsync(_tenantId);
            _sessions = _isAdmin ? all : all.Where(s => s.MemberUserId == _userId).ToList();
            _sessionRepos = await Sessions.ListAllReposForTenantAsync(_tenantId);
            await InvokeAsync(StateHasChanged);
        }
        // Best effort — the rows simply keep "Ready for review" until the next refresh.
        catch (Exception ex) when (ex is System.Net.Http.HttpRequestException or InvalidOperationException or System.IO.IOException or TimeoutException or ObjectDisposedException) { _ = ex.Message; }
    }

    private static int? PrNumber(string? url)
    {
        if (string.IsNullOrEmpty(url)) { return null; }
        var i = url.LastIndexOf("/pull/", StringComparison.Ordinal);
        return i >= 0 && int.TryParse(url.AsSpan(i + "/pull/".Length).TrimEnd('/'), System.Globalization.NumberStyles.None,
            System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : null;
    }

    // The furthest plain step this task's live feed has reported (feed messages carry the step labels), or -1.
    private int CurrentStep(Guid sessionId)
    {
        if (!_activity.TryGetValue(sessionId, out var feed)) { return -1; }
        var furthest = -1;
        foreach (var ev in feed)
        {
            furthest = Math.Max(furthest, AgentOs.Domain.Sessions.TaskSteps.IndexOfLabel(ev.Message));
        }
        return furthest;
    }

    // A person, not a GUID: "You" for the signed-in member, else a short id (full id in the cell's tooltip).
    private string MemberLabel(string? userId) =>
        string.IsNullOrEmpty(userId) ? "—" : userId == _userId ? "You" : "Member " + userId[..Math.Min(8, userId.Length)];

    // Task and repo states in words, not enum names (the stored values stay as they are).
    private static string PlainStatus(string status) => status switch
    {
        "Draft" => "Not started",
        "Pending" => "Waiting",
        "Running" => "Working…",
        "Failed" => "Couldn't finish",
        "Blocked" => "Needs your review",   // the QA gate refused to open the change
        "Done" => "Ready for review",
        "Merged" => "Done",
        "Closed" => "Closed",
        _ => status,
    };

    private IReadOnlyList<SessionRepoEntity> SessionReposFor(Guid sessionId)
    {
        if (!ReferenceEquals(_sessionReposIndexed, _sessionRepos))
        {
            _reposBySession = (_sessionRepos ?? Array.Empty<SessionRepoEntity>())
                .GroupBy(r => r.SessionId)
                .ToDictionary(g => g.Key, g => g.OrderBy(r => r.Owner).ThenBy(r => r.Repo).ToArray());
            _sessionReposIndexed = _sessionRepos;
        }
        return _reposBySession.TryGetValue(sessionId, out var repos) ? repos : Array.Empty<SessionRepoEntity>();
    }

    // ── Run session (fire-and-forget AI pipeline) ──────────────────────────────────────────────

    private async Task RunSession(RemoteSessionEntity session, string? changeRequest = null)
    {
        if (_busyId == session.Id) { return; }
        _busyId = session.Id;
        try
        {
            var board = _boards?.FirstOrDefault(w => w.Id == session.WorkspaceId);
            if (board is null)
            {
                Toasts.Show("Board", "Board not found — reload and try again.", ToastKind.Err);
                return;
            }
            var children = await Sessions.ListReposForTenantAsync(_tenantId, session.Id);
            if (children.Count == 0)
            {
                Toasts.Show("Board", "This task has no code project to work on. Start it again from the ticket.", ToastKind.Err);
                return;
            }
            var pat = await ConfigStore.GetForTenantAsync(_tenantId, board.CredentialRef);
            if (string.IsNullOrEmpty(pat))
            {
                Toasts.Show("Board", "Could not retrieve board credentials. Reconnect the board.", ToastKind.Err);
                return;
            }

            await Sessions.UpdateRunResultAsync(_tenantId, session.Id, "Running", null, null);
            // Try again: a repo that failed last time starts over clean (its old error would read as this run's).
            foreach (var failed in children.Where(c => c.Status == "Failed"))
            {
                // A follow-up keeps the branch + pull request it continues; a plain retry starts over.
                var keep = changeRequest is not null && !string.IsNullOrEmpty(failed.PrUrl);
                await Sessions.UpdateRepoRunResultAsync(_tenantId, failed.Id, "Pending", keep ? failed.BranchName : null, keep ? failed.PrUrl : null, null);
                failed.Status = "Pending";
                failed.Error = null;
            }
            _sessionRepos = await Sessions.ListAllReposForTenantAsync(_tenantId);
            var all = await Sessions.ListForTenantAsync(_tenantId);
            _sessions = _isAdmin ? all : all.Where(s => s.MemberUserId == _userId).ToList();
            Toasts.Show("Board", $"Task #{session.IssueNumber} started — the AI is working on it. You can close this window.", ToastKind.Ok);
            StartPolling();

            // Fire-and-forget background work in a fresh DI scope (independent of this circuit).
            var capturedTenantId = _tenantId;
            var capturedSession = session;
            var capturedBoard = board;
            var capturedPat = pat;
            var capturedChildren = children;
            var capturedCli = _cliProfile;   // CLI choice is transient (not persisted) — capture at dispatch.
            var capturedChange = string.IsNullOrWhiteSpace(changeRequest) ? null : changeRequest.Trim();
            var stopLease = StopRegistry.Begin(capturedTenantId, capturedSession.Id);
            _ = Task.Run(async () =>
            {
                using var _stop = stopLease;
                try
                {
                    using var scope = ScopeFactory.CreateScope();
                    // No HttpContext in this Task.Run, so seed the captured tenant + member as the ambient
                    // identity — the LLM tool tenant + the runner dispatch read it to target the right runner,
                    // and runner_shell tags its per-command progress to the session id carried here.
                    using var _identity = AgentOs.SharedKernel.Identity.AmbientIdentity.Push(capturedTenantId, capturedSession.MemberUserId, capturedSession.Id);
                    var sessRepo = scope.ServiceProvider.GetRequiredService<AgentOs.Modules.Sessions.Persistence.ISessionRepository>();

                    // Quality engine — the 5-agent SDLC pipeline runs server-side (generates new files,
                    // commits them + opens a PR via Octokit), greenfield only, hard-gated by the ticket-type
                    // router. The Quick engine (the default IssueWorkAgent edit loop) is below.
                    if (EngineSelection.IsQuality(capturedSession.Brain))
                    {
                        await RunQualitySessionAsync(
                            scope, sessRepo, capturedSession, capturedBoard, capturedPat, capturedChildren, capturedTenantId, stopLease.Token)
                            .ConfigureAwait(false);
                        return;
                    }

                    var agent = scope.ServiceProvider.GetRequiredService<AgentOs.Domain.Sessions.IIssueWorkAgent>();
                    var prService = scope.ServiceProvider.GetRequiredService<AgentOs.Domain.Workspaces.IPrCreationService>();

                    var issueBody = await ReadTicketBodyAsync(scope, capturedBoard, capturedTenantId, capturedSession, capturedPat).ConfigureAwait(false);

                    // Ask for changes: each repo that already has a pull request continues on its branch.
                    var workRepos = capturedChildren
                        .Select(c => new AgentOs.Domain.Sessions.WorkRepo(c.Id, c.Owner, c.Repo, c.DefaultBranch,
                            capturedChange is not null && !string.IsNullOrEmpty(c.PrUrl) ? c.BranchName : null))
                        .ToList();
                    var issueRequest = new AgentOs.Domain.Sessions.IssueWorkRequest(
                        SessionId: capturedSession.Id,
                        TenantId: capturedTenantId,
                        MemberId: capturedSession.MemberUserId,
                        Repos: workRepos,
                        IssueNumber: capturedSession.IssueNumber ?? 0,
                        IssueTitle: capturedSession.Title,
                        IssueBody: issueBody ?? "",
                        TicketKind: capturedSession.TicketKind ?? "Issue",
                        ProviderOverride: capturedSession.RunOnMachine ? "RemoteAgent" : null,
                        CliProfile: capturedSession.RunOnMachine ? capturedCli : null,
                        TicketType: capturedSession.TicketType,
                        ChangeRequest: capturedChange);

                    var workResult = await agent.RunAsync(issueRequest, stopLease.Token).ConfigureAwait(false);

                    // One PR per repo that pushed a branch; write each repo's result back incrementally
                    // (per-repo try/catch so one failure doesn't sink the others).
                    var anyFailure = false;
                    foreach (var outcome in workResult.Repos)
                    {
                        var repoLabel = $"{outcome.Owner}/{outcome.Repo}";
                        if (!outcome.Ok)
                        {
                            anyFailure = true;
                            await sessRepo.UpdateRepoRunResultAsync(capturedTenantId, outcome.SessionRepoId,
                                "Failed", outcome.BranchName, null, outcome.Error ?? "Agent failed.").ConfigureAwait(false);
                            Publish(SessionRunEventKind.RepoDone, $"{repoLabel} — failed: {outcome.Error}", repoLabel, "Failed");
                            continue;
                        }

                        // A follow-up pushed more commits to an open pull request: nothing new to open.
                        var child = capturedChildren.FirstOrDefault(c => c.Id == outcome.SessionRepoId);
                        if (capturedChange is not null && !string.IsNullOrEmpty(child?.PrUrl))
                        {
                            await sessRepo.UpdateRepoRunResultAsync(capturedTenantId, outcome.SessionRepoId,
                                "Done", outcome.BranchName, child.PrUrl, null).ConfigureAwait(false);
                            Publish(SessionRunEventKind.RepoDone, $"{repoLabel} — proposed change updated", repoLabel, "Done", child.PrUrl);
                            continue;
                        }

                        var childBranch = child?.DefaultBranch ?? "main";
                        var descriptor = RepoDescriptor(capturedBoard, capturedTenantId, outcome.Owner, outcome.Repo, childBranch, capturedPat);

                        try
                        {
                            var prResult = await prService.CreateFromBranchAsync(
                                descriptor,
                                outcome.BranchName,
                                AgentOs.Domain.Workspaces.PullRequestText.Title(capturedSession.IssueNumber, capturedSession.Title, capturedSession.TicketType),
                                AgentOs.Domain.Workspaces.PullRequestText.Body(capturedSession.IssueNumber, outcome.Summary)).ConfigureAwait(false);

                            await sessRepo.UpdateRepoRunResultAsync(capturedTenantId, outcome.SessionRepoId,
                                prResult.Ok ? "Done" : "Failed", outcome.BranchName, prResult.HtmlUrl,
                                prResult.Ok ? null : prResult.Error).ConfigureAwait(false);
                            if (!prResult.Ok) { anyFailure = true; }
                            Publish(SessionRunEventKind.RepoDone,
                                prResult.Ok ? $"{repoLabel} — PR opened" : $"{repoLabel} — PR failed: {prResult.Error}",
                                repoLabel, prResult.Ok ? "Done" : "Failed", prResult.HtmlUrl);
                        }
                        catch (System.Net.Http.HttpRequestException prEx) { await HandlePrError(prEx).ConfigureAwait(false); }
                        catch (System.Text.Json.JsonException prEx) { await HandlePrError(prEx).ConfigureAwait(false); }
                        catch (InvalidOperationException prEx) { await HandlePrError(prEx).ConfigureAwait(false); }
                        catch (System.IO.IOException prEx) { await HandlePrError(prEx).ConfigureAwait(false); }
                        catch (TimeoutException prEx) { await HandlePrError(prEx).ConfigureAwait(false); }

                        async Task HandlePrError(Exception prEx)
                        {
                            anyFailure = true;
                            await sessRepo.UpdateRepoRunResultAsync(capturedTenantId, outcome.SessionRepoId,
                                "Failed", outcome.BranchName, null, $"PR creation failed: {prEx.Message}").ConfigureAwait(false);
                            Publish(SessionRunEventKind.RepoDone, $"{repoLabel} — PR creation failed: {prEx.Message}", repoLabel, "Failed");
                        }
                    }

                    await sessRepo.RecomputeSessionStatusForTenantAsync(capturedTenantId, capturedSession.Id).ConfigureAwait(false);
                    Publish(anyFailure ? SessionRunEventKind.Failed : SessionRunEventKind.Done,
                        anyFailure ? "Session finished with failures." : "Session complete — all repos done.");

                    // Local publish helper: tags every event with this run's tenant + session.
                    void Publish(SessionRunEventKind kind, string message, string? repo = null, string? status = null, string? prUrl = null) =>
                        Feed.Publish(new SessionRunEvent(capturedTenantId, capturedSession.Id, kind, message, DateTimeOffset.UtcNow, repo, status, prUrl));
                }
                catch (System.Net.Http.HttpRequestException ex) { await HandleRunFailure(ex).ConfigureAwait(false); }
                catch (System.Text.Json.JsonException ex) { await HandleRunFailure(ex).ConfigureAwait(false); }
                catch (Microsoft.AspNetCore.SignalR.HubException ex) { await HandleRunFailure(ex).ConfigureAwait(false); }
                catch (InvalidOperationException ex) { await HandleRunFailure(ex).ConfigureAwait(false); }
                catch (System.IO.IOException ex) { await HandleRunFailure(ex).ConfigureAwait(false); }
                catch (TimeoutException ex) { await HandleRunFailure(ex).ConfigureAwait(false); }
                catch (OperationCanceledException) when (stopLease.Token.IsCancellationRequested) { await HandleStopped().ConfigureAwait(false); }

                // Stop: the task and every repo that hadn't finished read "Stopped", and Try again is offered.
                async Task HandleStopped()
                {
                    const string stopped = "Stopped — you pressed Stop. Nothing was pushed for the unfinished parts; Try again to restart.";
                    try
                    {
                        using var scope = ScopeFactory.CreateScope();
                        var sessRepo = scope.ServiceProvider.GetRequiredService<AgentOs.Modules.Sessions.Persistence.ISessionRepository>();
                        foreach (var child in await sessRepo.ListReposForTenantAsync(capturedTenantId, capturedSession.Id).ConfigureAwait(false))
                        {
                            if (child.Status is "Pending" or "Running")
                            {
                                await sessRepo.UpdateRepoRunResultAsync(capturedTenantId, child.Id, "Failed", null, null, "Stopped").ConfigureAwait(false);
                            }
                        }
                        await sessRepo.UpdateRunResultAsync(capturedTenantId, capturedSession.Id, "Failed", null, stopped).ConfigureAwait(false);
                    }
                    catch (Exception inner) when (inner is System.Net.Http.HttpRequestException or System.IO.IOException or InvalidOperationException or TimeoutException) { _ = inner.Message; }
                    Feed.Publish(new SessionRunEvent(capturedTenantId, capturedSession.Id,
                        SessionRunEventKind.Failed, "Stopped by you.", DateTimeOffset.UtcNow));
                }

                async Task HandleRunFailure(Exception ex)
                {
                    try
                    {
                        using var scope = ScopeFactory.CreateScope();
                        var sessRepo = scope.ServiceProvider.GetRequiredService<AgentOs.Modules.Sessions.Persistence.ISessionRepository>();
                        await sessRepo.UpdateRunResultAsync(capturedTenantId, capturedSession.Id,
                            "Failed", null, ex.Message).ConfigureAwait(false);
                    }
                    // Best-effort.
                    catch (System.Net.Http.HttpRequestException inner) { _ = inner.Message; }
                    catch (System.IO.IOException inner) { _ = inner.Message; }
                    catch (InvalidOperationException inner) { _ = inner.Message; }
                    catch (TimeoutException inner) { _ = inner.Message; }
                    Feed.Publish(new SessionRunEvent(capturedTenantId, capturedSession.Id,
                        SessionRunEventKind.Failed, $"Session failed: {ex.Message}", DateTimeOffset.UtcNow));
                }
            });
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Run failed: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Run failed: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Run failed: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Run failed: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busyId = null;
        }
    }

    // ── Quality engine (5-agent pipeline) ─────────────────────────────────────────────────────────

    // Runs the 5-agent SDLC pipeline for a session against its PRIMARY repo (children[0]) and opens a PR
    // with the generated code + tests. Server-side end-to-end — no runner needed. Hard-gated by the
    // ticket-type router: a non-greenfield ticket is REFUSED (the pipeline only generates new files), never
    // silently downgraded to Quick. Multi-repo fan-out is deferred (Quality targets the primary repo only).
    private async Task RunQualitySessionAsync(
        IServiceScope scope,
        AgentOs.Modules.Sessions.Persistence.ISessionRepository sessRepo,
        RemoteSessionEntity session,
        WorkspaceEntity board,
        string pat,
        IReadOnlyList<SessionRepoEntity> children,
        string tenantId,
        CancellationToken stop)
    {
        // Tenant + session tagged publish to the live feed.
        void Publish(SessionRunEventKind kind, string message, string? repo = null, string? status = null, string? prUrl = null) =>
            Feed.Publish(new SessionRunEvent(tenantId, session.Id, kind, message, DateTimeOffset.UtcNow, repo, status, prUrl));

        // Hard greenfield router (red-team HIGH) — refuse edit/bug/ambiguous tickets, never best-effort.
        var cls = TicketClassifier.Classify(session.TicketType, session.Title);
        if (cls != TicketClass.Greenfield)
        {
            var reason = TicketClassifier.RefusalMessage(cls);
            await sessRepo.UpdateRunResultAsync(tenantId, session.Id, "Failed", null, reason).ConfigureAwait(false);
            Publish(SessionRunEventKind.Failed, reason);
            return;
        }

        var primary = children.Count > 0 ? children[0] : null;
        if (primary is null)
        {
            const string noRepo = "Quality run has no target repo — recreate the session from a board ticket.";
            await sessRepo.UpdateRunResultAsync(tenantId, session.Id, "Failed", null, noRepo).ConfigureAwait(false);
            Publish(SessionRunEventKind.Failed, noRepo);
            return;
        }
        var repoLabel = $"{primary.Owner}/{primary.Repo}";

        // Resolve the heavy services lazily, inside this background scope (eager-DI landmine — never a
        // @inject'd field, which would build a pooled LLM client in the circuit ctor and crash on open).
        var pipeline = scope.ServiceProvider.GetRequiredService<IPipelineClient>();
        var prService = scope.ServiceProvider.GetRequiredService<IGitHubPrService>();

        Publish(SessionRunEventKind.Running, $"Quality engine — 5-agent pipeline on {repoLabel}.", repoLabel);

        var ticketBody = await ReadTicketBodyAsync(scope, board, tenantId, session, pat).ConfigureAwait(false);
        var story = IssueToStoryAdapter.ToUserStory(session.Title, ticketBody, QualityNMax());

        // E0.7: the repo's own agent instructions (AGENTS.md, CLAUDE.md, Copilot instructions, …) guide every
        // agent of this run; the session feed says which files were used so the outcome is explainable.
        var guidance = await ReadRepoGuidanceAsync(scope, board, tenantId, primary, pat).ConfigureAwait(false);
        Publish(SessionRunEventKind.Step, guidance.Count == 0
            ? $"{repoLabel} — no repo agent instructions found (AGENTS.md, CLAUDE.md, …)."
            : $"{repoLabel} — following repo instructions: {RepoInstructions.Describe(guidance)}.", repoLabel);
        using var guidanceScope = RunGuidance.Push(RepoInstructions.ToPromptBlock(guidance));

        PipelineResult? result = null;
        string? error = null;
        // The pipeline runs through PersistingOrchestratorAgent, which applies the S1 per-tenant budget gate
        // (the ambient identity pushed by RunSession flows in via InProcessPipelineClient).
        await foreach (var evt in pipeline.StreamAsync(story, stop).ConfigureAwait(false))
        {
            switch (evt.Kind)
            {
                case PipelineStreamEventKind.Progress when evt.Progress is not null:
                    Publish(SessionRunEventKind.Step, PipelineProgressFormatter.Describe(evt.Progress), repoLabel);
                    break;
                case PipelineStreamEventKind.Result:
                    result = evt.Result;
                    break;
                case PipelineStreamEventKind.Error:
                    error = evt.Error ?? "Pipeline error.";
                    break;
            }
        }

        if (result is null || result.Status == PipelineStatus.Failed)
        {
            var msg = error ?? "Quality pipeline failed — see the server log.";
            await sessRepo.UpdateRepoRunResultAsync(tenantId, primary.Id, "Failed", null, null, msg).ConfigureAwait(false);
            await sessRepo.UpdateRunResultAsync(tenantId, session.Id, "Failed", null, msg).ConfigureAwait(false);
            Publish(SessionRunEventKind.Failed, $"{repoLabel} — {msg}", repoLabel, "Failed");
            return;
        }

        // QA gate (plan 0.5): only a result QA PASSED on real model output becomes a PR. Anything else is
        // Blocked with the reason — visible on the session, never silently shipped.
        var gate = PrGate.Evaluate(result);
        if (!gate.Allowed)
        {
            await sessRepo.UpdateRepoRunResultAsync(tenantId, primary.Id, "Blocked", null, null, gate.Reason).ConfigureAwait(false);
            await sessRepo.RecomputeSessionStatusForTenantAsync(tenantId, session.Id).ConfigureAwait(false);
            Publish(SessionRunEventKind.Failed, $"{repoLabel} — {gate.Reason}", repoLabel, "Blocked");
            return;
        }

        // Commit the generated code + tests to the primary repo and open a PR (server-side via Octokit).
        var descriptor = RepoDescriptor(board, tenantId, primary.Owner, primary.Repo, primary.DefaultBranch, pat);
        var title = $"feat: #{session.IssueNumber} {session.Title}";
        var body = $"Generated by the AgentOS.NET Quality pipeline (5-agent SDLC loop) for session #{session.IssueNumber}.";
        try
        {
            var pr = await prService.OpenPrAsync(result, descriptor, title, body, CancellationToken.None).ConfigureAwait(false);
            await sessRepo.UpdateRepoRunResultAsync(tenantId, primary.Id, "Done", pr.Branch, pr.HtmlUrl, null).ConfigureAwait(false);
            await sessRepo.RecomputeSessionStatusForTenantAsync(tenantId, session.Id).ConfigureAwait(false);
            Publish(SessionRunEventKind.Done, $"{repoLabel} — PR opened.", repoLabel, "Done", pr.HtmlUrl);
        }
        catch (System.Net.Http.HttpRequestException ex) { await PrFailed(ex).ConfigureAwait(false); }
        catch (System.Text.Json.JsonException ex) { await PrFailed(ex).ConfigureAwait(false); }
        catch (InvalidOperationException ex) { await PrFailed(ex).ConfigureAwait(false); }
        catch (ArgumentException ex) { await PrFailed(ex).ConfigureAwait(false); }
        catch (System.IO.IOException ex) { await PrFailed(ex).ConfigureAwait(false); }
        catch (TimeoutException ex) { await PrFailed(ex).ConfigureAwait(false); }

        async Task PrFailed(Exception ex)
        {
            await sessRepo.UpdateRepoRunResultAsync(tenantId, primary.Id, "Failed", null, null, $"PR creation failed: {ex.Message}").ConfigureAwait(false);
            await sessRepo.UpdateRunResultAsync(tenantId, session.Id, "Failed", null, $"PR creation failed: {ex.Message}").ConfigureAwait(false);
            Publish(SessionRunEventKind.Failed, $"{repoLabel} — PR creation failed: {ex.Message}", repoLabel, "Failed");
        }
    }

    // The QA-loop iteration cap for a Quality run, clamped to the admin/tenant bound (S4): the pipeline
    // default (3), never above Pipeline:MaxIterations. The orchestrator re-clamps the same way, so this is
    // also what the cost label can honestly advertise.
    private int QualityNMax() => Math.Clamp(Math.Min(3, PipelineOpts.Value.MaxIterations), 1, 10);

    // Switching the engine to Quality forces "run on my machine" off — the pipeline is server-side.
    private void OnBrainChanged()
    {
        if (EngineSelection.IsQuality(_brain)) { _runOnMachine = false; }
    }

    // ── Runner management ────────────────────────────────────────────────────────────────────────

    private async Task RegisterRunner()
    {
        if (_busy) { return; }
        if (string.IsNullOrWhiteSpace(_runnerLabel))
        {
            Toasts.Show("Board", "A label is required.", ToastKind.Err);
            return;
        }
        _busy = true;
        try
        {
            var secret = Pairing.Issue();
            var entity = new RunnerEntity
            {
                Id = Guid.NewGuid(),
                TenantId = _tenantId,
                OwnerUserId = _userId,
                Label = _runnerLabel.Trim(),
                TokenHash = secret.TokenHash,
                Status = "Pending",
                CreatedAtUtc = DateTimeOffset.UtcNow,
                CreatedByUserId = string.IsNullOrEmpty(_userId) ? null : _userId,
            };
            await Runners.AddForTenantAsync(entity);
            _newRunner = (entity.Id, secret.Token);
            _newRunnerLabel = entity.Label;
            _newRunnerConnected = false;
            _newRunnerCode = PairingCodes.IssueTypedCode(entity.Id, secret.Token, Nav.BaseUri + "hubs/remote-agent");
            _runnerLabel = "";
            _ = WatchForConnectionAsync(entity.Id);
            var r0 = await Runners.ListForTenantAsync(_tenantId);
            _runners = _isAdmin ? r0 : r0.Where(r => r.OwnerUserId == _userId).ToList();
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Register failed: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Register failed: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Register failed: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Register failed: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeRunner(RunnerEntity r)
    {
        _busyId = r.Id;
        try
        {
            await Runners.SetStatusForTenantAsync(_tenantId, r.Id, "Revoked");
            Toasts.Show("Board", $"Revoked '{r.Label}'.", ToastKind.Ok);
            var r0 = await Runners.ListForTenantAsync(_tenantId);
            _runners = _isAdmin ? r0 : r0.Where(r => r.OwnerUserId == _userId).ToList();
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Revoke failed: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Revoke failed: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Revoke failed: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Revoke failed: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busyId = null;
        }
    }

    // ── Sessions ─────────────────────────────────────────────────────────────────────────────────

    // The failure card's one button.
    private async Task OnFailureAction(RemoteSessionEntity s, AgentOs.Web.Services.TaskFailureAction action)
    {
        switch (action)
        {
            case AgentOs.Web.Services.TaskFailureAction.ConnectAiAccount:
                AgentOs.Web.Services.SettingsLinks.Open(WM, AgentOs.Web.Services.SettingsLinks.ModelKeys);
                break;
            case AgentOs.Web.Services.TaskFailureAction.ConnectComputer:
                _tab = Tab.Runners;
                break;
            case AgentOs.Web.Services.TaskFailureAction.ReconnectGitHub:
                _tab = Tab.Boards;
                _selectedBoard = null;
                break;
            case AgentOs.Web.Services.TaskFailureAction.RaiseSpendingLimit:
                if (AgentOs.Web.Services.AppCatalog.Find("insights") is { } insights)
                {
                    WM.OpenApp(insights.Key, insights.Title, insights.Icon, insights.W, insights.H);
                }
                break;
            default:
                await RunSession(s);
                break;
        }
    }

    // ── Ask for changes ──────────────────────────────────────────────────────────────────────────────
    private Guid? _changesFor;
    private string _changesText = "";
    private bool _loadingChecks;

    private bool HasOpenChange(Guid sessionId) => SessionReposFor(sessionId).Any(r => !string.IsNullOrEmpty(r.PrUrl) && !string.IsNullOrEmpty(r.BranchName));

    private void ToggleChanges(Guid sessionId)
    {
        _changesFor = _changesFor == sessionId ? null : sessionId;
        _changesText = "";
    }

    private async Task SendChanges(RemoteSessionEntity s)
    {
        var text = _changesText;
        if (string.IsNullOrWhiteSpace(text)) { return; }
        _changesFor = null;
        _changesText = "";
        await RunSession(s, text);
    }

    // The checks of each open pull request of this task that failed, with the tail of their logs, as the request.
    private async Task FixFailingChecks(RemoteSessionEntity s)
    {
        var board = _boards?.FirstOrDefault(b => b.Id == s.WorkspaceId);
        if (board is null) { return; }
        _loadingChecks = true;
        try
        {
            var pat = await ConfigStore.GetForTenantAsync(_tenantId, board.CredentialRef);
            if (string.IsNullOrEmpty(pat)) { Toasts.Show("Board", "GitHub access has expired — reconnect the project.", ToastKind.Err); return; }
            using var scope = ScopeFactory.CreateScope();
            var prs = scope.ServiceProvider.GetRequiredService<AgentOs.Domain.Workspaces.IPrCreationService>();
            var report = new System.Text.StringBuilder();
            foreach (var repo in SessionReposFor(s.Id).Where(r => PrNumber(r.PrUrl) is not null))
            {
                var failed = await prs.GetFailedChecksAsync(RepoDescriptor(board, _tenantId, repo.Owner, repo.Repo, repo.DefaultBranch, pat), PrNumber(repo.PrUrl)!.Value);
                if (!string.IsNullOrWhiteSpace(failed)) { report.Append(repo.Owner).Append('/').Append(repo.Repo).Append(":\n").Append(failed).Append('\n'); }
            }
            if (report.Length == 0)
            {
                Toasts.Show("Board", "No failing checks right now — they may still be running.", ToastKind.Ok);
                return;
            }
            _changesFor = null;
            _changesText = "";
            await RunSession(s, "The pull request's automated checks failed. Fix the cause (not the test, unless the test itself is wrong) so they pass:\n\n" + report);
        }
        catch (Exception ex) when (ex is System.Net.Http.HttpRequestException or InvalidOperationException or TimeoutException)
        {
            Toasts.Show("Board", $"Couldn't read the checks: {ex.Message}", ToastKind.Err);
        }
        finally
        {
            _loadingChecks = false;
        }
    }

    private void StopSession(RemoteSessionEntity s)
    {
        Toasts.Show("Board", StopRegistry.Stop(_tenantId, s.Id)
            ? $"Stopping task #{s.IssueNumber}… the AI finishes its current step and stops."
            : $"Task #{s.IssueNumber} isn't running here any more — refresh to see where it ended.",
            ToastKind.Ok);
    }

    private async Task CloseSession(RemoteSessionEntity s)
    {
        _busyId = s.Id;
        try
        {
            await Sessions.CloseForTenantAsync(_tenantId, s.Id, DateTimeOffset.UtcNow);
            Toasts.Show("Board", $"Closed '{s.Title}'.", ToastKind.Ok);
            var s0 = await Sessions.ListForTenantAsync(_tenantId);
            _sessions = _isAdmin ? s0 : s0.Where(s => s.MemberUserId == _userId).ToList();
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Close failed: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Close failed: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Close failed: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Close failed: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busyId = null;
        }
    }

    // ── Connect board ────────────────────────────────────────────────────────────────────────────

    private async Task FindBoards()
    {
        if (_findingBoards) { return; }
        if (string.IsNullOrWhiteSpace(_wsProjectOwner) || string.IsNullOrWhiteSpace(_wsToken))
        {
            Toasts.Show("Board", "Owner and token are required to find boards.", ToastKind.Err);
            return;
        }
        _findingBoards = true;
        try
        {
            _foundBoards = await Connector.ListBoardsAsync(_wsKind, _wsProjectOwner.Trim(), _wsToken);
            if (_foundBoards.Count == 0)
            {
                Toasts.Show("Board", "No boards visible to that token.", ToastKind.Info);
            }
        }
        catch (System.Net.Http.HttpRequestException ex) { HandleFindError(ex); }
        catch (System.Text.Json.JsonException ex) { HandleFindError(ex); }
        catch (InvalidOperationException ex) { HandleFindError(ex); }
        catch (System.IO.IOException ex) { HandleFindError(ex); }
        catch (TimeoutException ex) { HandleFindError(ex); }
        finally
        {
            _findingBoards = false;
        }

        void HandleFindError(Exception ex)
        {
            Toasts.Show("Board", $"Find boards failed: {ex.Message}", ToastKind.Err);
            _foundBoards = null;
        }
    }

    private void OnBoardPicked(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value) || _foundBoards is null) { return; }
        if (!int.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, out var number)) { return; }
        var board = _foundBoards.FirstOrDefault(b => b.Number == number);
        if (board is null) { return; }
        _wsNumberText = board.Number.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (string.IsNullOrWhiteSpace(_wsName)) { _wsName = board.Title; }
    }

    private async Task ConnectBoard()
    {
        if (_busy) { return; }
        if (string.IsNullOrWhiteSpace(_wsName) || string.IsNullOrWhiteSpace(_wsProjectOwner)
            || string.IsNullOrWhiteSpace(_wsToken))
        {
            Toasts.Show("Board", "Name, owner and token are required.", ToastKind.Err);
            return;
        }
        int? number = null;
        if (!string.IsNullOrWhiteSpace(_wsNumberText))
        {
            if (!int.TryParse(_wsNumberText.Trim(), out var n) || n <= 0)
            {
                Toasts.Show("Board", "Board number must be a positive integer.", ToastKind.Err);
                return;
            }
            number = n;
        }
        _busy = true;
        try
        {
            var input = new WorkspaceConnectInput(
                _wsName.Trim(), _wsKind, _wsProjectOwner.Trim(),
                _wsKind == SourceProviderKind.GitHub ? _wsScope : "org",
                number,
                string.IsNullOrWhiteSpace(_wsProject) ? null : _wsProject.Trim(),
                null, _wsToken);
            var result = await Connector.ConnectAsync(_tenantId, string.IsNullOrEmpty(_userId) ? null : _userId, input);
            if (result.Ok)
            {
                Toasts.Show("Board", $"Connected '{_wsName.Trim()}'.", ToastKind.Ok);
                _wsName = _wsProjectOwner = _wsNumberText = _wsProject = _wsToken = "";
                _foundBoards = null;
                _boards = await Workspaces.ListForTenantAsync(_tenantId);
            }
            else
            {
                Toasts.Show("Board", result.Error ?? "Connect failed.", ToastKind.Err);
            }
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Connect failed: {ex.Message}", ToastKind.Err); }
        catch (System.Text.Json.JsonException ex) { Toasts.Show("Board", $"Connect failed: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Connect failed: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Connect failed: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Connect failed: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busy = false;
        }
    }
