    // The failure card's one button.
    private async Task OnFailureAction(RemoteSessionEntity s, AgentOs.Web.Services.TaskFailureAction action)
    {
        switch (action)
        {
            case AgentOs.Web.Services.TaskFailureAction.ConnectAiAccount:
                AgentOs.Web.Services.SettingsLinks.Open(WM, AgentOs.Web.Services.SettingsLinks.ModelKeys);
                break;
            case AgentOs.Web.Services.TaskFailureAction.ConnectComputer:
                _tab = Tab.Runners;
                break;
            case AgentOs.Web.Services.TaskFailureAction.ReconnectGitHub:
                _tab = Tab.Boards;
                _selectedBoard = null;
                break;
            case AgentOs.Web.Services.TaskFailureAction.RaiseSpendingLimit:
                if (AgentOs.Web.Services.AppCatalog.Find("insights") is { } insights)
                {
                    WM.OpenApp(insights.Key, insights.Title, insights.Icon, insights.W, insights.H);
                }
                break;
            default:
                await RunSession(s);
                break;
        }
    }

    // ── Ask for changes ──────────────────────────────────────────────────────────────────────────────
    private Guid? _changesFor;
    private string _changesText = "";
    private bool _loadingChecks;

    private bool HasOpenChange(Guid sessionId) => SessionReposFor(sessionId).Any(r => !string.IsNullOrEmpty(r.PrUrl) && !string.IsNullOrEmpty(r.BranchName));

    private void ToggleChanges(Guid sessionId)
    {
        _changesFor = _changesFor == sessionId ? null : sessionId;
        _changesText = "";
    }

    private async Task SendChanges(RemoteSessionEntity s)
    {
        var text = _changesText;
        if (string.IsNullOrWhiteSpace(text)) { return; }
        _changesFor = null;
        _changesText = "";
        await RunSession(s, text);
    }

    // The checks of each open pull request of this task that failed, with the tail of their logs, as the request.
    private async Task FixFailingChecks(RemoteSessionEntity s)
    {
        var board = _boards?.FirstOrDefault(b => b.Id == s.WorkspaceId);
        if (board is null) { return; }
        _loadingChecks = true;
        try
        {
            var pat = await ConfigStore.GetForTenantAsync(_tenantId, board.CredentialRef);
            if (string.IsNullOrEmpty(pat)) { Toasts.Show("Board", "GitHub access has expired — reconnect the project.", ToastKind.Err); return; }
            using var scope = ScopeFactory.CreateScope();
            var prs = scope.ServiceProvider.GetRequiredService<AgentOs.Domain.Workspaces.IPrCreationService>();
            var report = new System.Text.StringBuilder();
            foreach (var repo in SessionReposFor(s.Id).Where(r => PrNumber(r.PrUrl) is not null))
            {
                var failed = await prs.GetFailedChecksAsync(RepoDescriptor(board, _tenantId, repo.Owner, repo.Repo, repo.DefaultBranch, pat), PrNumber(repo.PrUrl)!.Value);
                if (!string.IsNullOrWhiteSpace(failed)) { report.Append(repo.Owner).Append('/').Append(repo.Repo).Append(":\n").Append(failed).Append('\n'); }
            }
            if (report.Length == 0)
            {
                Toasts.Show("Board", "No failing checks right now — they may still be running.", ToastKind.Ok);
                return;
            }
            _changesFor = null;
            _changesText = "";
            await RunSession(s, "The pull request's automated checks failed. Fix the cause (not the test, unless the test itself is wrong) so they pass:\n\n" + report);
        }
        catch (Exception ex) when (ex is System.Net.Http.HttpRequestException or InvalidOperationException or TimeoutException)
        {
            Toasts.Show("Board", $"Couldn't read the checks: {ex.Message}", ToastKind.Err);
        }
        finally
        {
            _loadingChecks = false;
        }
    }

