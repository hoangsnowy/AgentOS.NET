    {
        if (_selectedBoard is null) { return; }
        _previewBusy = r.Id;
        try
        {
            var number = await Previews.RequestRecipeAsync(_tenantId, _selectedBoard, r);
            _previewAsk.Remove(r.Id);
            Toasts.Show("Try the app", number is { } n
                ? $"Opened #{n} — the AI will add the recipe; then Try the app works here."
                : "Couldn't open the ticket — AgentOS.NET has no access to this project.", number is null ? ToastKind.Err : ToastKind.Ok);
        }
        catch (Exception ex) when (ex is Octokit.ApiException or System.Net.Http.HttpRequestException or InvalidOperationException)
        {
