                <strong>Try @r.Repo on your computer</strong>
                <span>AgentOS.NET gets the latest <code>@(string.IsNullOrWhiteSpace(r.DefaultBranch) ? "main" : r.DefaultBranch)</code> and runs the project's own command:</span>
                <code class="board-preview-command">@recipe.Command</code>
                <span class="muted">Then it opens <code>@recipe.Url.AbsoluteUri</code>. Testing on this project waits while the app runs.</span>
                @if (!HasMyComputer())
                {
                    <span class="board-preview-warn">Your computer isn't connected — connect it on the Computers tab first.</span>
                }
                <div class="board-preview-actions">
                    <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Primary" OnClick="@(() => RunPreview(r, recipe))" Disabled="@(!HasMyComputer())">
                        <Icon Name="play" Size="13" /> Run it
                    </Btn>
                    <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Ghost" OnClick="@(() => _previewAsk.Remove(r.Id))">Cancel</Btn>
                </div>
            }
            else if (ask.Missing)
            {
                <strong>This project doesn't say how to run it yet.</strong>
                <span>The AI can add a small recipe file (<code>@AgentOs.Domain.Preview.PreviewRecipe.FilePath</code>) as a normal task — then Try the app works here.</span>
                <div class="board-preview-actions">
                    <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Primary" OnClick="@(() => AskForRecipe(r))" Disabled="@(_previewBusy == r.Id)">
                        <Icon Name="lightning" Size="13" /> Ask the AI to set it up
                    </Btn>
                    <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Ghost" OnClick="@(() => _previewAsk.Remove(r.Id))">Cancel</Btn>
                </div>
            }
            else
            {
                <strong>Try the app isn't set up right.</strong>
                <span>@ask.Problem</span>
                <div class="board-preview-actions">
                    <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Ghost" OnClick="@(() => _previewAsk.Remove(r.Id))">Close</Btn>
                </div>
            }
        }
        else if (p is not null)
        {
            <strong>@PreviewHeadline(p)</strong>
            @if (p.State is "Preparing" or "Starting" && !string.IsNullOrEmpty(p.Message))
            {
                <span class="muted">@p.Message</span>
            }
            <div class="board-preview-actions">
                @if (p.State == "Ready")
                {
                    <a class="btn btn-primary btn-sm" href="@p.Url" target="_blank" rel="noopener"><Icon Name="arrow-square-out" Size="13" /> Open the app</a>
                    <span class="muted">@p.Url</span>
                }
                @if (p.IsActive)
                {
                    <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Danger" OnClick="@(() => Previews.Stop(_tenantId, r.Id))">
                        <Icon Name="stop" Size="13" /> Stop
                    </Btn>
                }
                else
                {
                    <Btn Size="Btn.ButtonSize.Sm" OnClick="@(() => TryTheApp(r))"><Icon Name="arrow-clockwise" Size="13" /> Try again</Btn>
                }
            </div>
            @if (!p.IsActive && !string.IsNullOrWhiteSpace(p.Message))
            {
                <details class="board-failure-details">
                    <summary>What happened</summary>
                    <pre>@p.Message</pre>
                </details>
            }
        }
    </div>;

    // ── Autopilot ────────────────────────────────────────────────────────────────────────────────────
    private readonly Dictionary<Guid, IReadOnlyList<(DateTimeOffset At, string Text)>> _autopilotLog = new();

    private async Task ShowAutopilot()
    {
        _tab = Tab.Autopilot;
        await LoadAutopilotLogAsync();
    }

    private async Task LoadAutopilotLogAsync()
    {
        foreach (var b in _boards ?? [])
        {
            _autopilotLog[b.Id] = await OrchestratorLog.RecentAsync(_tenantId, b.Id);
        }
    }
    private async Task SetAutopilot(WorkspaceEntity board, string mode)
    {
        if (!await Workspaces.SetAutopilotForTenantAsync(_tenantId, board.Id, mode, _userId))
        {
            Toasts.Show("Board", "Couldn't change Autopilot — reload and try again.", ToastKind.Err);
            return;
        }
        board.Autopilot = mode;
        board.AutopilotUserId = mode == "Off" ? null : _userId;
        OrchestratorLog.Add(_tenantId, board.Id, mode switch
        {
            "Build" => "Autopilot on: building approved tickets in order; you merge.",
            "BuildAndMerge" => "Autopilot on: building and merging when all checks pass.",
            _ => "Autopilot off.",
        });
        await LoadAutopilotLogAsync();
    }

    private async Task AutopilotNow(WorkspaceEntity board)
    {
        _busy = true;
        try
        {
            var actions = await Orchestrator.StepAsync(board);
            if (actions.Count == 0) { OrchestratorLog.Add(_tenantId, board.Id, "Checked: nothing to do right now."); }
            await ReloadAll();
            await LoadAutopilotLogAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    // Agentic Testing on demand: the Testing agent checks the open change against the ticket's criteria on your computer.
    private async Task TestTask(RemoteSessionEntity s)
    {
        _busyId = s.Id;
        try
        {
            var started = await TaskService.TestAsync(_tenantId, s.Id, _cliProfile);
            Toasts.Show("Board", started == AgentOs.Web.Services.BoardTasks.TaskStart.Started
                ? $"Testing #{s.IssueNumber} on your computer — the result is posted on the pull request."
                : $"Couldn't test #{s.IssueNumber}: {started}.", started == AgentOs.Web.Services.BoardTasks.TaskStart.Started ? ToastKind.Ok : ToastKind.Err);
            await ReloadAll();
            StartPolling();
        }
        finally
        {
            _busyId = null;
        }
    }

    private void StopSession(RemoteSessionEntity s)
    {
        Toasts.Show("Board", StopRegistry.Stop(_tenantId, s.Id)
            ? $"Stopping task #{s.IssueNumber}… the AI finishes its current step and stops."
            : $"Task #{s.IssueNumber} isn't running here any more — refresh to see where it ended.",
            ToastKind.Ok);
    }

    private async Task CloseSession(RemoteSessionEntity s)
    {
        _busyId = s.Id;
        try
        {
            await Sessions.CloseForTenantAsync(_tenantId, s.Id, DateTimeOffset.UtcNow);
            Toasts.Show("Board", $"Closed '{s.Title}'.", ToastKind.Ok);
            var s0 = await Sessions.ListForTenantAsync(_tenantId);
            _sessions = _isAdmin ? s0 : s0.Where(s => s.MemberUserId == _userId).ToList();
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Close failed: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Close failed: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Close failed: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Close failed: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busyId = null;
        }
    }

    // ── Connect board ────────────────────────────────────────────────────────────────────────────

    private async Task FindBoards()
    {
        if (_findingBoards) { return; }
        if (string.IsNullOrWhiteSpace(_wsProjectOwner) || string.IsNullOrWhiteSpace(_wsToken))
        {
            Toasts.Show("Board", "Owner and token are required to find boards.", ToastKind.Err);
            return;
        }
        _findingBoards = true;
        try
        {
            _foundBoards = await Connector.ListBoardsAsync(_wsKind, _wsProjectOwner.Trim(), _wsToken);
            if (_foundBoards.Count == 0)
            {
                Toasts.Show("Board", "No boards visible to that token.", ToastKind.Info);
            }
        }
        catch (System.Net.Http.HttpRequestException ex) { HandleFindError(ex); }
        catch (System.Text.Json.JsonException ex) { HandleFindError(ex); }
        catch (InvalidOperationException ex) { HandleFindError(ex); }
        catch (System.IO.IOException ex) { HandleFindError(ex); }
        catch (TimeoutException ex) { HandleFindError(ex); }
        finally
        {
            _findingBoards = false;
        }

        void HandleFindError(Exception ex)
        {
            Toasts.Show("Board", $"Find boards failed: {ex.Message}", ToastKind.Err);
            _foundBoards = null;
        }
    }

    private void OnBoardPicked(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value) || _foundBoards is null) { return; }
        if (!int.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, out var number)) { return; }
        var board = _foundBoards.FirstOrDefault(b => b.Number == number);
        if (board is null) { return; }
        _wsNumberText = board.Number.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (string.IsNullOrWhiteSpace(_wsName)) { _wsName = board.Title; }
    }

    private async Task ConnectBoard()
    {
        if (_busy) { return; }
        if (string.IsNullOrWhiteSpace(_wsName) || string.IsNullOrWhiteSpace(_wsProjectOwner)
            || string.IsNullOrWhiteSpace(_wsToken))
        {
            Toasts.Show("Board", "Name, owner and token are required.", ToastKind.Err);
            return;
        }
        int? number = null;
        if (!string.IsNullOrWhiteSpace(_wsNumberText))
        {
            if (!int.TryParse(_wsNumberText.Trim(), out var n) || n <= 0)
            {
                Toasts.Show("Board", "Board number must be a positive integer.", ToastKind.Err);
                return;
            }
            number = n;
        }
        _busy = true;
        try
        {
            var input = new WorkspaceConnectInput(
                _wsName.Trim(), _wsKind, _wsProjectOwner.Trim(),
                _wsKind == SourceProviderKind.GitHub ? _wsScope : "org",
                number,
                string.IsNullOrWhiteSpace(_wsProject) ? null : _wsProject.Trim(),
                null, _wsToken);
            var result = await Connector.ConnectAsync(_tenantId, string.IsNullOrEmpty(_userId) ? null : _userId, input);
            if (result.Ok)
            {
                Toasts.Show("Board", $"Connected '{_wsName.Trim()}'.", ToastKind.Ok);
                _wsName = _wsProjectOwner = _wsNumberText = _wsProject = _wsToken = "";
                _foundBoards = null;
                _boards = await Workspaces.ListForTenantAsync(_tenantId);
            }
            else
            {
                Toasts.Show("Board", result.Error ?? "Connect failed.", ToastKind.Err);
            }
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Connect failed: {ex.Message}", ToastKind.Err); }
        catch (System.Text.Json.JsonException ex) { Toasts.Show("Board", $"Connect failed: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Connect failed: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Connect failed: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Connect failed: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busy = false;
        }
    }
}
