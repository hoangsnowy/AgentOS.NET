@* BoardApp — Boards (a connected GitHub Projects v2 board, spanning many repos) → Tickets (board
   items across repos) → AI sessions. A board has a Repositories sub-list (the services under it) and
   a unified Tickets list filtered by repo / label / status. "Work on this" starts a session against
   the ticket's repo, then "Run" triggers the IssueWorkAgent → branch → PR.
   A Blazor Server circuit has no HttpContext, so ITenantContext is blank here — we read the tenant +
   user from AuthenticationState and call repos via tenant-explicit overloads. *@

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using AgentOs.Domain.Workspaces
@using AgentOs.Domain.Sessions
@using AgentOs.Modules.AppConfig
@using AgentOs.Modules.Integration
@using AgentOs.Modules.Pipeline.Decomposition
@using AgentOs.Modules.Workspaces
@using AgentOs.Modules.Workspaces.Persistence
@using AgentOs.Modules.Workspaces.Persistence.Entities
@using AgentOs.Modules.Sessions.Persistence
@using AgentOs.Modules.Sessions.Persistence.Entities
@using AgentOs.Domain.Pipeline
@using AgentOs.Modules.Pipeline.Pipeline
@using AgentOs.Modules.Pipeline.Sessions
@inject IWorkspaceRepository Workspaces
@inject IWorkspaceConnector Connector
@inject IRunnerRepository Runners
@inject ISessionRepository Sessions
@inject IRunnerPairingService Pairing
@inject IAppConfigStore ConfigStore
@inject IBoardTicketService BoardTicketSvc
@inject IBoardWriteService BoardWriteSvc
@inject AgentOs.Web.Shell.Services.ToastService Toasts
@inject ISessionRunFeed Feed
@inject IServiceScopeFactory ScopeFactory
@inject AgentOs.Web.Services.TaskStopRegistry StopRegistry
@inject AgentOs.Modules.Sessions.Pairing.IComputerPairingCodes PairingCodes
@inject AgentOs.Modules.RemoteAgent.IRemoteAgentBroker Broker
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<PipelineOptions> PipelineOpts
@inject AgentOs.Web.Shell.Services.WindowManagerService WM
@implements IDisposable

<header class="page-head">
    <div>
        <h1 class="page-title">Board</h1>
        <p class="page-sub">Your projects, the tasks the AI is working on, and the computers it can use.</p>
    </div>
    <Btn OnClick="ReloadAll" Disabled="_loading">
        <Icon Name="arrow-clockwise" Size="14" /> Refresh
    </Btn>
</header>

<div class="board-tabs">
    <button class="board-tab @(_tab == Tab.Boards ? "active" : "")" @onclick="@(() => { _tab = Tab.Boards; _selectedBoard = null; })">
        Projects <Badge>@(_boards?.Count ?? 0)</Badge>
    </button>
    <button class="board-tab @(_tab == Tab.Idea ? "active" : "")" @onclick="@(() => _tab = Tab.Idea)">
        New idea
    </button>
    <button class="board-tab @(_tab == Tab.Sessions ? "active" : "")" @onclick="@(() => _tab = Tab.Sessions)">
        Tasks <Badge>@(_sessions?.Count ?? 0)</Badge>
    </button>
    <button class="board-tab @(_tab == Tab.Runners ? "active" : "")" @onclick="@(() => _tab = Tab.Runners)">
        Computers <Badge>@(_runners?.Count ?? 0)</Badge>
    </button>
    @* Was the standalone Terminal app: the runner's live session feed lives next to the sessions it tails. *@
    <button class="board-tab @(_tab == Tab.Log ? "active" : "")" @onclick="@(() => _tab = Tab.Log)">
        <Icon Name="terminal" Size="13" /> Activity
    </button>
    @* Was the standalone Files app: browse the connected repos the tickets live in. *@
    <button class="board-tab @(_tab == Tab.Files ? "active" : "")" @onclick="@(() => _tab = Tab.Files)">
        <Icon Name="folder" Size="13" /> Files
    </button>
</div>

@if (!_resolved)
{
    <Spinner />
}

@* ── BOARDS TAB ───────────────────────────────────────────────────────────────────────────── *@
else if (_tab == Tab.Boards)
{
    @if (_selectedBoard is null)
    {
        @* Boards list view *@
        <Panel Title="Connect a board">
            <div class="form-grid">
                <Field Label="Provider">
                    <select class="prefs-select" @bind="_wsKind">
                        <option value="@SourceProviderKind.GitHub">GitHub Projects</option>
                        <option value="@SourceProviderKind.AzureDevOps">Azure DevOps</option>
                    </select>
                </Field>
                <Field Label="Name">
                    <input @bind="_wsName" placeholder="My product board" />
                </Field>
                <Field Label="@(_wsKind == SourceProviderKind.AzureDevOps ? "Organization" : "Owner (org or user)")">
                    <input @bind="_wsProjectOwner" placeholder="octo-org" />
                </Field>
                @if (_wsKind == SourceProviderKind.GitHub)
                {
                    <Field Label="Scope">
                        <select class="prefs-select" @bind="_wsScope">
                            <option value="org">Organization</option>
                            <option value="user">User</option>
                        </select>
                    </Field>
                }
                @if (_wsKind == SourceProviderKind.AzureDevOps)
                {
                    <Field Label="Project">
                        <input @bind="_wsProject" placeholder="MyProject" />
                    </Field>
                }
                <Field Label="Board number">
                    <input @bind="_wsNumberText" placeholder="5 (optional — leave blank for repos-only)" />
                    @if (_foundBoards is { Count: > 0 })
                    {
                        <select class="prefs-select" @onchange="OnBoardPicked">
                            <option value="">— pick from @_foundBoards.Count found —</option>
                            @foreach (var b in _foundBoards)
                            {
                                <option value="@b.Number">#@b.Number — @b.Title</option>
                            }
                        </select>
                    }
                    else if (_foundBoards is { Count: 0 })
                    {
                        <p class="muted board-form-hint">No boards found for that owner + token.</p>
                    }
                </Field>
                <Field Label="Access token (PAT)">
                    <input type="password" @bind="_wsToken" placeholder="ghp_… (needs repo + read:project)" autocomplete="off" />
                </Field>
            </div>
            <div class="form-actions">
                <Btn Variant="Btn.ButtonVariant.Ghost" OnClick="FindBoards"
                     Disabled="_busy || _findingBoards || _wsKind != SourceProviderKind.GitHub">
                    @(_findingBoards ? "Finding…" : "Find boards")
                </Btn>
                <Btn Variant="Btn.ButtonVariant.Primary" OnClick="ConnectBoard" Disabled="_busy">
                    @(_busy ? "Connecting…" : "Connect")
                </Btn>
            </div>
            <p class="muted board-form-hint">Token is validated, then stored encrypted — never shown again or kept on the row. A GitHub board number is its Projects v2 number (in the project URL).</p>
        </Panel>

        @if (_boards is null) { <Spinner /> }
        else
        {
            <Panel Title="Projects">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Board</th>
                        <th>Status</th>
                        <th class="actions">Open</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in _boards)
                    {
                        <tr>
                            <td><strong>@b.Name</strong></td>
                            <td>
                                <code>@b.ProjectOwner</code>
                                @if (b.ProjectNumber is not null)
                                {
                                    <span class="muted"> #@b.ProjectNumber</span>
                                }
                                else
                                {
                                    <span class="muted"> · repos only</span>
                                }
                            </td>
                            <td><Badge>@b.Status</Badge></td>
                            <td class="actions">
                                @if (b.Kind == SourceProviderKind.GitHub)
                                {
                                    <Btn Size="Btn.ButtonSize.Sm" OnClick="@(() => SelectBoard(b))">
                                        Open <Icon Name="arrow-right" Size="13" />
                                    </Btn>
                                }
                                else
                                {
                                    <span class="muted" style="font-size:12px">ADO — soon</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (_boards.Count == 0)
                    {
                        <tr><td colspan="4" class="data-empty">No boards yet — connect one above.</td></tr>
                    }
                </tbody>
            </table>
            </Panel>
        }
    }
    else
    {
        @* Board detail: repositories + unified tickets *@
        <div class="board-back-bar">
            <Btn Size="Btn.ButtonSize.Sm" OnClick="CloseBoard">
                <Icon Name="arrow-left" Size="13" /> @_selectedBoard.Name
            </Btn>
            <span class="board-back-repo muted">
                <code>@_selectedBoard.ProjectOwner@(_selectedBoard.ProjectNumber is not null ? $" #{_selectedBoard.ProjectNumber}" : "")</code>
            </span>
        </div>

        @* Repositories under the board *@
        <Panel Title="Repositories">
            <div class="form-grid">
                <Field Label="Owner">
                    <input @bind="_addRepoOwner" placeholder="octo-org" />
                </Field>
                <Field Label="Repository">
                    <input @bind="_addRepoName" placeholder="api-service" />
                </Field>
                <Field Label="Default branch">
                    <input @bind="_addRepoBranch" placeholder="main" />
                </Field>
            </div>
            <div class="form-actions">
                <Btn Variant="Btn.ButtonVariant.Primary" OnClick="AddRepo" Disabled="_busy">
                    @(_busy ? "Adding…" : "Add repository")
                </Btn>
            </div>
            @if (_repos is null) { <Spinner /> }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr><th>Repository</th><th>Branch</th><th class="actions">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _repos)
                        {
                            <tr>
                                <td><code>@r.Owner/@r.Repo</code></td>
                                <td>@r.DefaultBranch</td>
                                <td class="actions">
                                    <Btn Size="Btn.ButtonSize.Sm"
                                         OnClick="@(() => SeedLabels(r))" Disabled="@(_busyId == r.Id)">
                                        <Icon Name="tag" Size="13" /> Seed labels
                                    </Btn>
                                    <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Danger"
                                         OnClick="@(() => RemoveRepo(r))" Disabled="@(_busyId == r.Id)">
                                        <Icon Name="x" Size="13" /> Remove
                                    </Btn>
                                </td>
                            </tr>
                        }
                        @if (_repos.Count == 0)
                        {
                            <tr><td colspan="3" class="data-empty">No repositories under this board yet — add the services it spans.</td></tr>
                        }
                    </tbody>
                </table>
            }
        </Panel>

        @* Unified tickets across the board's repos *@
        @if (_selectedBoard.ProjectNumber is null)
        {
            <Panel Title="Tickets">
                <p class="muted">This is a repos-only board. Reconnect it with a GitHub Projects v2 board number to pull tickets.</p>
            </Panel>
        }
        else if (_loadingTickets)
        {
            <Spinner />
        }
        else if (_ticketError is not null)
        {
            <Panel Title="Tickets">
                <p class="login-error">@_ticketError</p>
                <div class="form-actions">
                    <Btn OnClick="@(() => SelectBoard(_selectedBoard))">Retry</Btn>
                </div>
            </Panel>
        }
        else if (_tickets is not null)
        {
            <Panel Title="@($"Tickets · {_selectedBoard.Name}")">
                <div class="board-filters">
                    <Field Label="Repository">
                        <select class="prefs-select" @bind="_filterRepo">
                            <option value="">All repos</option>
                            @foreach (var repo in TicketRepos())
                            {
                                <option value="@repo">@repo</option>
                            }
                        </select>
                    </Field>
                    <Field Label="Label">
                        <select class="prefs-select" @bind="_filterLabel">
                            <option value="">All labels</option>
                            @foreach (var label in TicketLabels())
                            {
                                <option value="@label">@label</option>
                            }
                        </select>
                    </Field>
                    <Field Label="Status">
                        <select class="prefs-select" @bind="_filterStatus">
                            <option value="">All statuses</option>
                            @foreach (var status in TicketStatuses())
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </Field>
                </div>
                @{ var readyCount = ReadyTickets().Count; }
                @if (readyCount > 0)
                {
                    <div class="form-actions board-runall">
                        <Btn Variant="Btn.ButtonVariant.Primary" OnClick="RunAllReady" Disabled="_busy">
                            <Icon Name="lightning" Size="13" /> Run all ai:ready (@readyCount)
                        </Btn>
                    </div>
                }
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width:64px">#</th>
                            <th>Title</th>
                            <th>Repo</th>
                            <th>Labels</th>
                            <th>Status</th>
                            <th>Assignee</th>
                            <th class="actions">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in FilteredTickets())
                        {
                            <tr>
                                <td class="muted">@(ticket.Number is null ? "draft" : $"#{ticket.Number}")</td>
                                <td>
                                    @if (ticket.Kind == BoardTicketKind.DraftIssue || string.IsNullOrEmpty(ticket.HtmlUrl))
                                    {
                                        @ticket.Title
                                    }
                                    else
                                    {
                                        <a href="@ticket.HtmlUrl" target="_blank" rel="noopener" class="board-issue-link">@ticket.Title</a>
                                    }
                                </td>
                                <td>
                                    @if (ticket.RepoOwner is not null)
                                    {
                                        <code>@ticket.RepoOwner/@ticket.RepoName</code>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>
                                    @foreach (var label in ticket.Labels.Take(3))
                                    {
                                        <Badge>@label</Badge>
                                    }
                                </td>
                                <td>@if (ticket.Status is not null) { <Badge>@ticket.Status</Badge> } else { <span class="muted">—</span> }</td>
                                <td class="muted">@(ticket.AssigneeLogin ?? "—")</td>
                                <td class="actions">
                                    <Btn Size="Btn.ButtonSize.Sm" OnClick="@(() => OpenInWorkflow(ticket))"
                                         title="Open this ticket as a story in the Workflow app">
                                        <Icon Name="graph" Size="13" /> Workflow
                                    </Btn>
                                    <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Primary"
                                         OnClick="@(() => OpenWorkDialog(ticket))"
                                         Disabled="@(_busy || ticket.Kind == BoardTicketKind.DraftIssue || ticket.RepoOwner is null)">
                                        Work on this <Icon Name="arrow-right" Size="13" />
                                    </Btn>
                                </td>
                            </tr>
                        }
                        @if (!FilteredTickets().Any())
                        {
                            <tr><td colspan="7" class="data-empty">No tickets match — the board is clear or your filters are too narrow.</td></tr>
                        }
                    </tbody>
                </table>
            </Panel>
        }
    }
}

@* ── START FROM IDEA TAB (bootstrap) ──────────────────────────────────────────────────────── *@
else if (_tab == Tab.Idea)
{
    <Panel Title="New idea">
        <div class="board-wizard-steps">
            <span class="board-wizard-step @StepClass(IdeaStep.Input)">1 · Idea</span>
            <span class="board-wizard-step @StepClass(IdeaStep.Review)">2 · Review</span>
            <span class="board-wizard-step @StepClass(IdeaStep.Result)">3 · Create</span>
        </div>

        @if (_ideaStep == IdeaStep.Input)
        {
            <div class="form-grid">
                <Field Label="Target board">
                    <select class="prefs-select" @bind="_ideaBoardId" @bind:after="OnIdeaBoardChanged">
                        <option value="">Select a board…</option>
                        @foreach (var b in IdeaBoards())
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    </select>
                </Field>
                <Field Label="Target repository">
                    <select class="prefs-select" @bind="_ideaRepoId">
                        <option value="">Select a repo…</option>
                        @foreach (var r in _ideaRepos ?? Enumerable.Empty<WorkspaceRepoEntity>())
                        {
                            <option value="@r.Id">@r.Owner/@r.Repo</option>
                        }
                    </select>
                </Field>
            </div>
            <Field Label="Your idea">
                <textarea rows="5" @bind="_ideaText"
                          placeholder="Describe the feature or product you want to build. The Requirement agent turns this into a spec, then tickets."></textarea>
            </Field>
            @if (_ideaError is not null) { <p class="login-error">@_ideaError</p> }
            <div class="form-actions">
                <Btn Variant="Btn.ButtonVariant.Primary" OnClick="GenerateIdea" Disabled="_ideaBusy">
                    @(_ideaBusy ? "Generating…" : "Generate spec + tickets")
                </Btn>
            </div>
            <p class="muted board-form-hint">Nothing is written to GitHub yet — you review and edit the tickets before anything is created. The board needs a Projects v2 number.</p>
        }
        else if (_ideaStep == IdeaStep.Review && _preview is not null)
        {
            <div class="board-spec">
                <h3>@_preview.Spec.Title</h3>
                <p class="muted">@_preview.Spec.Summary</p>
            </div>

            <table class="data-table">
                <thead>
                    <tr><th>Title</th><th>Labels</th><th style="width:96px">Auto-run</th><th class="actions"></th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _draftRows)
                    {
                        <tr>
                            <td><input class="board-ticket-title" @bind="row.Title" /></td>
                            <td>@foreach (var l in row.Labels) { <Badge>@l</Badge> }</td>
                            <td>
                                <label class="board-ai-toggle">
                                    <input type="checkbox" checked="@row.AiReady" aria-label="Auto-run this ticket (ai:ready)"
                                           @onchange="@(e => ToggleAiReady(row, e))" /> ai:ready
                                </label>
                            </td>
                            <td class="actions">
                                <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Danger" OnClick="@(() => _draftRows.Remove(row))">
                                    <Icon Name="x" Size="13" />
                                </Btn>
                            </td>
                        </tr>
                    }
                    @if (_draftRows.Count == 0)
                    {
                        <tr><td colspan="4" class="data-empty">No tickets — go back and regenerate.</td></tr>
                    }
                </tbody>
            </table>

            @if (_ideaError is not null) { <p class="login-error">@_ideaError</p> }
            @WhereToWork
            <div class="form-actions">
                <Btn OnClick="@(() => { _ideaStep = IdeaStep.Input; _ideaError = null; })" Disabled="_ideaBusy">Back</Btn>
                <Btn Variant="Btn.ButtonVariant.Primary" OnClick="@(() => CreateTickets(true))" Disabled="@(_ideaBusy || _draftRows.Count == 0)">
                    @(_ideaBusy ? "Working…" : "Create & run all ready")
                </Btn>
                <Btn OnClick="@(() => CreateTickets(false))" Disabled="@(_ideaBusy || _draftRows.Count == 0)">
                    Create only
                </Btn>
            </div>
            <p class="muted board-form-hint">Creates real GitHub issues on the selected repo and adds them to the board (labels seeded first). <strong>Create &amp; run</strong> then starts an AI session on every <code>ai:ready</code> ticket — review the list above first; this is the one human gate.</p>
        }
        else if (_ideaStep == IdeaStep.Result)
        {
            <p>Created <strong>@_createdTickets.Count</strong> ticket(s).</p>
            <table class="data-table">
                <thead><tr><th style="width:64px">#</th><th>Title</th></tr></thead>
                <tbody>
                    @foreach (var t in _createdTickets)
                    {
                        <tr>
                            <td class="muted">#@t.Number</td>
                            <td><a href="@t.HtmlUrl" target="_blank" rel="noopener" class="board-issue-link">@t.Title</a></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="form-actions">
                <Btn Variant="Btn.ButtonVariant.Primary" OnClick="ResetIdea">Start another</Btn>
                <Btn OnClick="@(() => { _tab = Tab.Boards; ResetIdea(); })">Go to projects</Btn>
            </div>
        }
    </Panel>
}

@* ── RUNNERS TAB ───────────────────────────────────────────────────────────────────────────── *@
else if (_tab == Tab.Runners)
{
    <Panel Title="Connect a computer">
        <div class="form-grid">
            <Field Label="Label">
                <input @bind="_runnerLabel" placeholder="My laptop" />
            </Field>
        </div>
        <div class="form-actions">
            <Btn Variant="Btn.ButtonVariant.Primary" OnClick="RegisterRunner" Disabled="_busy">
                @(_busy ? "Connecting…" : "Connect this computer")
            </Btn>
        </div>
        @if (_newRunner is not null)
        {
            <div class="cred-readout" data-testid="connect-readout">
                @if (_newRunnerConnected)
                {
                    <p class="pair-connected" role="status"><Icon Name="check" Size="14" /> <strong>@_newRunnerLabel</strong> is connected. The AI can now work on it.</p>
                }
                else
                {
                    <p class="cred-readout-hint">On <strong>@_newRunnerLabel</strong>, open the AgentOS.NET helper folder and run this once — it connects the computer and remembers it:</p>
                    <pre class="pair-command" data-testid="pair-command">AgentOs.RemoteAgent pair @Nav.BaseUri.TrimEnd('/') @_newRunnerCode</pre>
                    <p class="cred-readout-hint">Code <strong class="pair-code">@_newRunnerCode</strong> works once, for 10 minutes. This page turns to “connected” by itself.</p>
                }
                <details class="prefs-details">
                    <summary>Set it up by hand (advanced)</summary>
                    <p class="cred-readout-hint">Shown <strong>once</strong>. Set these on the computer, then start the helper:</p>
                    <textarea readonly rows="2" aria-label="Manual pairing values">REMOTE_AGENT_HUB=@(Nav.BaseUri)hubs/remote-agent
REMOTE_AGENT_ID=@_newRunner.Value.Id
REMOTE_AGENT_TOKEN=@_newRunner.Value.Token</textarea>
                </details>
            </div>
        }
    </Panel>

    @if (_runners is null) { <Spinner /> }
    else
    {
        var offline = _runners.Where(r => r.Status != "Revoked" && !Broker.IsConnected(r.Id)).ToList();
        var disconnectedCount = _runners.Count(r => r.Status == "Revoked");
        <Panel Title="@(_isAdmin ? "Computers (all members)" : "Your computers")">
        @if (offline.Count > 1)
        {
            @* Re-pairing leaves the old entry behind; one click retires every computer that isn't connected now. Two
               steps — each keeps a live pairing secret, and its helper needs a new code to come back. *@
            <div class="form-actions">
                <Btn Size="Btn.ButtonSize.Sm" Variant="@(_confirmOffline ? Btn.ButtonVariant.Danger : Btn.ButtonVariant.Default)"
                     OnClick="@(() => DisconnectOffline(offline))" Disabled="_busy">
                    @(_confirmOffline ? $"Click again to disconnect {offline.Count} offline computers" : $"Disconnect offline computers ({offline.Count})")
                </Btn>
            </div>
        }
        <table class="data-table">
            <thead>
                <tr>
                    <th>Label</th>
                    @if (_isAdmin) { <th>Owner</th> }
                    <th>Status</th>
                    <th>Last seen</th>
                    <th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in VisibleComputers())
                {
                    <tr>
                        <td>@r.Label</td>
                        @if (_isAdmin) { <td title="@r.OwnerUserId">@MemberLabel(r.OwnerUserId)</td> }
                        <td><Badge>@ComputerStatus(r)</Badge></td>
                        <td title="@((r.LastSeenUtc ?? r.CreatedAtUtc).ToString("u"))">@(Broker.IsConnected(r.Id) ? "now" : Ago(r.LastSeenUtc ?? r.CreatedAtUtc))</td>
                        <td class="actions">
                            <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Danger"
                                 OnClick="@(() => RevokeRunner(r))" Disabled="@(_busyId == r.Id || r.Status == "Revoked")">
                                <Icon Name="x" Size="13" /> Disconnect
                            </Btn>
                        </td>
                    </tr>
                }
                @if (_runners.Count(r => r.Status != "Revoked") == 0) { <tr><td colspan="@(_isAdmin ? 5 : 4)" class="data-empty">No computers connected yet — connect one above.</td></tr> }
            </tbody>
        </table>
        @if (disconnectedCount > 0)
        {
            <p class="muted board-form-hint">
                <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Ghost" OnClick="@(() => _showDisconnected = !_showDisconnected)">
                    @(_showDisconnected ? "Hide" : "Show") @disconnectedCount disconnected
                </Btn>
            </p>
        }
        </Panel>
    }
}

@* ── SESSIONS TAB ──────────────────────────────────────────────────────────────────────────── *@
else if (_tab == Tab.Log)
{
    <div class="board-embed"><TerminalApp /></div>
}
else if (_tab == Tab.Files)
{
    <div class="board-embed"><FilesApp /></div>
}
else if (_tab == Tab.Sessions)
{
    @if (_sessions is null) { <Spinner /> }
    else
    {
        <Panel Title="@(_isAdmin ? "Tasks (all members)" : "Your tasks")">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Board</th>
                    <th>Repos</th>
                    @if (_isAdmin) { <th>Member</th> }
                    <th>Status</th>
                    <th>Created</th>
                    <th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _sessions)
                {
                    <tr>
                        <td>
                            @s.Title
                            @if (s.Status == "Running" && CurrentStep(s.Id) is var step && step >= 0)
                            {
                                @* Live progress in plain steps (reported by the computer doing the work). Static — no looping motion. *@
                                <ol class="task-steps" aria-label="Progress">
                                    @for (var i = 0; i < AgentOs.Domain.Sessions.TaskSteps.All.Count; i++)
                                    {
                                        var state = i < step ? "done" : i == step ? "now" : "next";
                                        <li class="task-step is-@state" aria-current="@(i == step ? "step" : null)">@AgentOs.Domain.Sessions.TaskSteps.All[i].Label</li>
                                    }
                                </ol>
                            }
                            @if (s.Status != "Running" && AgentOs.Web.Services.TaskFailure.Explain(s.Error) is { } why)
                            {
                                @* Failure card: what happened in one line, what to do, ONE action; the raw text under Details. *@
                                <div class="board-failure" role="status" data-kind="@why.Kind">
                                    <strong>@why.Headline</strong>
                                    <span class="muted">@why.Advice</span>
                                    <div class="board-failure-actions">
                                        <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Primary"
                                             OnClick="@(() => OnFailureAction(s, why.Action))" Disabled="@(_busyId == s.Id)">@why.ActionLabel</Btn>
                                        <details class="prefs-details board-failure-details">
                                            <summary>Details</summary>
                                            <pre>@s.Error</pre>
                                        </details>
                                    </div>
                                </div>
                            }
                        </td>
                        <td><code>@BoardName(s.WorkspaceId)</code></td>
                        <td>
                            @{ var sessionRepos = SessionReposFor(s.Id); }
                            @if (sessionRepos.Count > 0)
                            {
                                @foreach (var r in sessionRepos)
                                {
                                    <div class="board-session-repo">
                                        <code>@r.Owner/@r.Repo</code>
                                        <Badge>@PlainStatus(r.Status)</Badge>
                                        @if (!string.IsNullOrEmpty(r.PrUrl))
                                        {
                                            <a href="@r.PrUrl" target="_blank" rel="noopener">PR</a>
                                        }
                                        @if (!string.IsNullOrEmpty(r.Error))
                                        {
                                            <span class="muted board-session-repo-err" title="@r.Error">!</span>
                                        }
                                    </div>
                                }
                            }
                            else if (!string.IsNullOrEmpty(s.RepoName))
                            {
                                <code>@s.RepoOwner/@s.RepoName</code>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </td>
                        @if (_isAdmin) { <td title="@s.MemberUserId">@MemberLabel(s.MemberUserId)</td> }
                        <td><Badge>@PlainStatus(s.Status)</Badge></td>
                        <td>@s.CreatedAtUtc.ToString("u")</td>
                        <td class="actions">
                            @* A failed session can be run again in place (after fixing what its error says) instead of being
                               closed and recreated from the ticket. *@
                            @* The failure card already carries Try again when that is its action — don't show it twice. *@
                            @if (s.Status == "Draft" || (s.Status == "Failed" && AgentOs.Web.Services.TaskFailure.Explain(s.Error)?.Action != AgentOs.Web.Services.TaskFailureAction.TryAgain))
                            {
                                <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Primary"
                                     OnClick="@(() => RunSession(s))"
                                     Disabled="@(_busyId == s.Id)">
                                    <Icon Name="play" Size="13" /> @(s.Status == "Failed" ? "Try again" : "Run")
                                </Btn>
                            }
                            @if (s.Status == "Running" && StopRegistry.IsRunning(_tenantId, s.Id))
                            {
                                <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Danger" OnClick="@(() => StopSession(s))"
                                     aria-label="@($"Stop task #{s.IssueNumber}")">
                                    <Icon Name="x" Size="13" /> Stop
                                </Btn>
                            }
                            @if (s.Status is "Done" or "Failed" or "Blocked" && HasOpenChange(s.Id))
                            {
                                <Btn Size="Btn.ButtonSize.Sm" OnClick="@(() => ToggleChanges(s.Id))" aria-expanded="@(_changesFor == s.Id)">
                                    <Icon Name="pencil" Size="13" /> Ask for changes
                                </Btn>
                            }
                            <Btn Size="Btn.ButtonSize.Sm" OnClick="@(() => CloseSession(s))"
                                 Disabled="@(_busyId == s.Id || s.Status is "Closed" or "Running")">
                                <Icon Name="check" Size="13" /> Close
                            </Btn>
                        </td>
                    </tr>
                    @if (_changesFor == s.Id)
                    {
                        <tr class="board-activity-tr">
                            <td colspan="@(_isAdmin ? 7 : 6)">
                                @* Review in words: what to change on the open proposed change. The AI continues on the same
                                   branch and pull request; "Fix the failing checks" fills this from the CI log. *@
                                <div class="board-where board-changes">
                                    <label class="board-ai-toggle" for="@($"changes-{s.Id}")"><strong>What should the AI change?</strong></label>
                                    <textarea id="@($"changes-{s.Id}")" class="prefs-input" rows="4" @bind="_changesText"
                                              placeholder="e.g. The second test is wrong: reload the page before checking the duplicate email."></textarea>
                                    <div class="board-failure-actions">
                                        <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Primary" OnClick="@(() => SendChanges(s))"
                                             Disabled="@(_busyId == s.Id || string.IsNullOrWhiteSpace(_changesText))">Send to the AI</Btn>
                                        <Btn Size="Btn.ButtonSize.Sm" OnClick="@(() => FixFailingChecks(s))" Disabled="@(_busyId == s.Id || _loadingChecks)">
                                            @(_loadingChecks ? "Reading the checks…" : "Fix the failing checks")
                                        </Btn>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (_activity.TryGetValue(s.Id, out var feed) && feed.Count > 0)
                    {
                        <tr class="board-activity-tr">
                            <td colspan="@(_isAdmin ? 7 : 6)">
                                <div class="board-activity">
                                    @foreach (var ev in feed.TakeLast(8))
                                    {
                                        <div class="board-activity-row">
                                            <span class="board-activity-time">@ev.At.ToLocalTime().ToString("HH:mm:ss")</span>
                                            <span>@ev.Message</span>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                @if (_sessions.Count == 0) { <tr><td colspan="@(_isAdmin ? 7 : 6)" class="data-empty">No tasks yet. Open a project and pick "Work on this" on a ticket.</td></tr> }
            </tbody>
        </table>
        </Panel>
    }
}

@* ── Work dialog: pick which repo(s) the ticket maps to ──────────────────────────────────── *@
<Dialog Show="_showWorkDialog" Title="@($"Work on #{_workTicket?.Number}")" OnClose="CloseWorkDialog">
    <ChildContent>
        <p class="muted">Pick the code projects this task touches. The AI prepares a proposed change in each one for you to review.</p>
        <div class="board-repo-picker">
            @foreach (var opt in _workRepoOptions)
            {
                <label class="board-repo-option">
                    <input type="checkbox" @bind="opt.Selected" aria-label="@($"Include {opt.Owner}/{opt.Repo} in this task")" />
                    <code>@opt.Owner/@opt.Repo</code>
                    <span class="muted">@opt.DefaultBranch</span>
                </label>
            }
            @if (_workRepoOptions.Count == 0)
            {
                <p class="muted">No repositories available — add one under the board first.</p>
            }
        </div>
        @WhereToWork
        @if (_workTicket is not null && NeedsPerson(_workTicket))
        {
            <div class="board-where" role="alert">
                <p class="login-error">This ticket is marked for a person (<code>needs-human</code> / epic) — usually a big goal or a
                    decision, not one change. The AI may try to do all of it at once.</p>
                <label class="board-repo-option">
                    <input type="checkbox" @bind="_confirmPersonTicket" />
                    <span>Run it anyway</span>
                </label>
            </div>
        }
    </ChildContent>
    <Footer>
        <Btn OnClick="CloseWorkDialog">Cancel</Btn>
        <Btn Variant="Btn.ButtonVariant.Primary" OnClick="ConfirmWorkSession"
             Disabled="@(_busy || (_workTicket is not null && NeedsPerson(_workTicket) && !_confirmPersonTicket))">Start working</Btn>
    </Footer>
</Dialog>

@code {
    private enum Tab { Boards, Idea, Runners, Sessions, Log, Files }

    /// <summary>Board deep-link tabs (WM.RequestLaunchTab("board", …)): the setup checklist's "Pair" → runners, etc.</summary>
    public static class LaunchTabs
    {
        /// <summary>Runners (pair a machine).</summary>
        public const string Runners = "runners";
        /// <summary>The runner's live log (was the Terminal app).</summary>
        public const string Log = "log";
        /// <summary>Repo files (was the Files app).</summary>
        public const string Files = "files";
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Tab _tab = Tab.Boards;
    private bool _resolved;
    private bool _loading;
    private bool _busy;
    private Guid? _busyId;

    private string _tenantId = "default";
    private string _userId = "";
    private bool _isAdmin;

    // ── Data ────────────────────────────────────────────────────────────────────────────────
    private IReadOnlyList<WorkspaceEntity>? _boards;
    private IReadOnlyList<RunnerEntity>? _runners;
    private IReadOnlyList<RemoteSessionEntity>? _sessions;
    private IReadOnlyList<SessionRepoEntity>? _sessionRepos;

    // ── Live run activity (M6 — a live event stream backs the feed; the poll is now just a backstop) ──
    private readonly Dictionary<Guid, List<SessionRunEvent>> _activity = new();
    private readonly System.Collections.Concurrent.ConcurrentQueue<SessionRunEvent> _incoming = new();
    private System.Threading.CancellationTokenSource? _cts;
    private System.Threading.Timer? _renderTimer;   // coalesces feed renders (~150ms) to avoid burst thrash

    // ── Board detail (repos + tickets) ────────────────────────────────────────────────────────
    private WorkspaceEntity? _selectedBoard;
    private IReadOnlyList<WorkspaceRepoEntity>? _repos;
    private IReadOnlyList<BoardTicket>? _tickets;
    private bool _loadingTickets;
    private string? _ticketError;

    // ── Work dialog (ticket → repo multi-select) ───────────────────────────────────────────────
    private BoardTicket? _workTicket;
    private bool _showWorkDialog;
    private readonly List<RepoOption> _workRepoOptions = new();

    private sealed class RepoOption
    {
        public string Owner { get; set; } = "";
        public string Repo { get; set; } = "";
        public string DefaultBranch { get; set; } = "main";
        public Guid? WorkspaceRepoId { get; set; }
        public bool Selected { get; set; }
    }

    // Ticket filters (client-side over the loaded list).
    private string _filterRepo = "";
    private string _filterLabel = "";
    private string _filterStatus = "";

    // ── Add-repo form ─────────────────────────────────────────────────────────────────────────
    private string _addRepoOwner = "";
    private string _addRepoName = "";
    private string _addRepoBranch = "";

    // ── Runner registration form ─────────────────────────────────────────────────────────────
    private string _runnerLabel = "";
    private (Guid Id, string Token)? _newRunner;
    private string _newRunnerCode = "";
    private string _newRunnerLabel = "";
    private bool _newRunnerConnected;

    private bool _showDisconnected;
    private bool _confirmOffline;

    // Connected first, then waiting, then offline (most recently seen first); disconnected history only on request.
    private IEnumerable<RunnerEntity> VisibleComputers() => (_runners ?? [])
        .Where(r => _showDisconnected || r.Status != "Revoked")
        .OrderBy(r => r.Status == "Revoked" ? 3 : Broker.IsConnected(r.Id) ? 0 : r.Status == "Pending" ? 1 : 2)
        .ThenByDescending(r => r.LastSeenUtc ?? r.CreatedAtUtc);

    private static string Ago(DateTimeOffset at)
    {
        var d = DateTimeOffset.UtcNow - at;
        return d.TotalMinutes < 1 ? "just now"
            : d.TotalHours < 1 ? $"{(int)d.TotalMinutes} min ago"
            : d.TotalDays < 1 ? $"{(int)d.TotalHours} h ago"
            : d.TotalDays < 60 ? $"{(int)d.TotalDays} days ago"
            : at.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    }

    private async Task DisconnectOffline(IReadOnlyList<RunnerEntity> offline)
    {
        if (!_confirmOffline) { _confirmOffline = true; return; }
        _confirmOffline = false;
        _busy = true;
        try
        {
            foreach (var r in offline.Where(r => !Broker.IsConnected(r.Id)))
            {
                await Runners.SetStatusForTenantAsync(_tenantId, r.Id, "Revoked");
            }
            var all = await Runners.ListForTenantAsync(_tenantId);
            _runners = _isAdmin ? all : all.Where(x => x.OwnerUserId == _userId).ToList();
            Toasts.Show("Board", $"Disconnected {offline.Count} offline computer(s).", ToastKind.Ok);
        }
        catch (Exception ex) when (ex is System.Net.Http.HttpRequestException or InvalidOperationException or System.IO.IOException or TimeoutException)
        {
            Toasts.Show("Board", $"Couldn't disconnect: {ex.Message}", ToastKind.Err);
        }
        finally
        {
            _busy = false;
        }
    }

    // Live, not stored: a paired computer is "Connected" while its helper holds a hub connection.
    private string ComputerStatus(RunnerEntity r) =>
        r.Status == "Revoked" ? "Disconnected"
        : Broker.IsConnected(r.Id) ? "Connected"
        : r.Status == "Pending" ? "Waiting to connect"
        : "Offline";

    // While a fresh code is on screen, watch for that computer to come online (2 s, up to the code's 10 minutes).
    private async Task WatchForConnectionAsync(Guid runnerId)
    {
        var stop = _cts?.Token ?? CancellationToken.None;
        for (var i = 0; i < 300 && !stop.IsCancellationRequested; i++)
        {
            try { await Task.Delay(TimeSpan.FromSeconds(2), stop); } catch (OperationCanceledException) { return; }
            if (_newRunner?.Id != runnerId) { return; }
            if (!Broker.IsConnected(runnerId)) { continue; }
            _newRunnerConnected = true;
            var all = await Runners.ListForTenantAsync(_tenantId);
            _runners = _isAdmin ? all : all.Where(x => x.OwnerUserId == _userId).ToList();
            Toasts.Show("Board", $"{_newRunnerLabel} is connected.", ToastKind.Ok);
            await InvokeAsync(StateHasChanged);
            return;
        }
    }

    // ── "Start from idea" wizard (bootstrap) ─────────────────────────────────────────────────
    private enum IdeaStep { Input, Review, Result }
    private IdeaStep _ideaStep = IdeaStep.Input;
    private string _ideaText = "";
    private string _ideaBoardId = "";
    private string _ideaRepoId = "";
    private IReadOnlyList<WorkspaceRepoEntity>? _ideaRepos;
    private bool _ideaBusy;
    private string? _ideaError;
    // "Where should the AI work?" — the one question a member answers before a task starts. The engine and the CLI
    // stay available under Advanced for people who know what they are; the defaults (Fast, Claude Code) fit most.
    private RenderFragment WhereToWork => @<div class="board-where">
        <p class="muted board-form-hint"><strong>Where should the AI work?</strong></p>
        <div class="board-repo-picker" role="radiogroup" aria-label="Where should the AI work?">
            <label class="board-repo-option">
                <input type="radio" name="board-where" checked="@(!_runOnMachine)" @onchange="@(() => _runOnMachine = false)" />
                <span><strong>On our servers</strong> <span class="muted">— nothing to set up</span></span>
            </label>
            <label class="board-repo-option">
                <input type="radio" name="board-where" checked="@_runOnMachine" disabled="@(_brain == "Quality")" @onchange="@(() => _runOnMachine = true)" />
                <span><strong>On my computer</strong> <span class="muted">— uses your own AI plan, free on our side</span></span>
            </label>
        </div>
        @if (_runOnMachine)
        {
            @MachineScopeHint
            @if (!HasRunner())
            {
                <p class="muted board-form-hint">Connect your computer first — open the <strong>Computers</strong> tab.</p>
            }
        }
        <details class="prefs-details">
            <summary>Advanced</summary>
            <label class="board-ai-toggle" style="margin-top:var(--space-2)">
                How thorough
                <select @bind="_brain" @bind:after="OnBrainChanged" class="prefs-input" style="width:auto;margin-left:var(--space-2)" aria-label="How thorough">
                    <option value="Quick">Fast — one agent edits the code</option>
                    <option value="Quality">Thorough — five agents with extra checks (costs more)</option>
                </select>
            </label>
            @if (_brain == "Quality")
            {
                <p class="muted board-form-hint">Thorough runs on our servers with up to @QualityNMax() review round(s). For new features only — it won't change existing code.</p>
            }
            @if (_runOnMachine)
            {
                <label class="board-ai-toggle" style="margin-top:var(--space-2)">
                    AI helper on your computer
                    <select @bind="_cliProfile" class="prefs-input" style="width:auto;margin-left:var(--space-2)" aria-label="AI helper on your computer">
                        <option value="claude">Claude Code</option>
                        <option value="codex">Codex</option>
                    </select>
                </label>
            }
        </details>
    </div>;

    // What "Run on my machine" lets the agent do, in words a non-developer can weigh before clicking: the runner
    // grants scoped autonomy for this session only (src/AgentOs.RemoteAgent/ScopedAutonomy.cs).
    private static readonly RenderFragment MachineScopeHint = @<p class="muted board-form-hint" data-testid="machine-scope-hint">
        Your computer does this ticket in a private folder made just for it: it downloads the repository, edits the code,
        builds, tests and pushes a branch for you to review. It can't open your other files, change your settings or
        overwrite existing work, and the folder is deleted when it finishes.</p>;

    // "Run on my machine" — route the issue-work loop to the member's paired dev-machine CLI (claude-code
    // / codex) instead of the server LLM. Shared by the idea-wizard auto-run + the Work-on-this dialog.
    private bool _runOnMachine;
    private string _cliProfile = "claude";   // which subscription CLI runs on-machine (claude | codex)
    private string _brain = "Quick";         // which engine runs the session (Quick = runner edit loop | Quality = 5-agent pipeline)
    private BootstrapPreview? _preview;
    private readonly List<DraftRow> _draftRows = new();
    private IReadOnlyList<CreatedTicket> _createdTickets = Array.Empty<CreatedTicket>();

    private sealed class DraftRow
    {
        public string Title { get; set; } = "";
        public string Body { get; set; } = "";
        public List<string> Labels { get; set; } = new();
        public bool AiReady { get; set; }
    }

    // ── Connect board form ───────────────────────────────────────────────────────────────────
    private SourceProviderKind _wsKind = SourceProviderKind.GitHub;
    private string _wsName = "";
    private string _wsProjectOwner = "";
    private string _wsScope = "org";
    private string _wsNumberText = "";
    private string _wsProject = "";
    private string _wsToken = "";
    // "Find boards" picker: null = not searched yet; empty = searched, none found.
    private IReadOnlyList<BoardSummary>? _foundBoards;
    private bool _findingBoards;

    // ── Polling timer (runs while any session is in "Running" state) ─────────────────────────
    private System.Threading.Timer? _pollTimer;

    // ── Lifecycle ────────────────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            var user = state.User;
            _tenantId = user.GetTenantId() ?? string.Empty;
            _userId = user.GetUserId() ?? "";
            _isAdmin = user.IsAdmin();
        }
        _resolved = true;
        // Deep-link from the Home app's "Start from idea": prefill the wizard's idea + open the Idea tab.
        _tab = WM.ConsumeLaunchTab("board") switch
        {
            LaunchTabs.Runners => Tab.Runners,
            LaunchTabs.Log => Tab.Log,
            LaunchTabs.Files => Tab.Files,
            _ => _tab,
        };
        var ideaPayload = WM.ConsumeLaunchPayload("board");
        if (!string.IsNullOrWhiteSpace(ideaPayload))
        {
            _ideaText = ideaPayload;
            _tab = Tab.Idea;
            _ideaStep = IdeaStep.Input;
        }
        // No tenant on the token → nothing tenant-scoped to load (fail closed; never read the `default`
        // workspace for a malformed sign-in). The empty-state UI handles _tenantId == "".
        if (_tenantId.Length == 0) { return; }
        await ReloadAll();
        _pollTimer = new System.Threading.Timer(
            _ => InvokeAsync(PollRunningSessions),
            null,
            System.Threading.Timeout.Infinite,
            System.Threading.Timeout.Infinite);

        // Subscribe to the live session-run stream for this tenant (background loop, tied to the circuit).
        _cts = new System.Threading.CancellationTokenSource();
        _ = ListenAsync(_cts.Token);
        // Coalesce feed renders: fold queued events + render at most once per ~150ms (see FlushFeed).
        _renderTimer = new System.Threading.Timer(
            _ => InvokeAsync(FlushFeed), null,
            TimeSpan.FromMilliseconds(150), TimeSpan.FromMilliseconds(150));
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
        _renderTimer?.Dispose();
        if (_cts is not null)
        {
            _cts.Cancel();
            _cts.Dispose();
        }
    }

    private async Task ReloadAll()
    {
        _loading = true;
        try
        {
            _boards = await Workspaces.ListForTenantAsync(_tenantId);

            var allRunners = await Runners.ListForTenantAsync(_tenantId);
            _runners = _isAdmin ? allRunners : allRunners.Where(r => r.OwnerUserId == _userId).ToList();

            var allSessions = await Sessions.ListForTenantAsync(_tenantId);
            _sessions = _isAdmin ? allSessions : allSessions.Where(s => s.MemberUserId == _userId).ToList();
            _sessionRepos = await Sessions.ListAllReposForTenantAsync(_tenantId);
            _ = SyncMergedAsync();
        }
        catch (System.Net.Http.HttpRequestException ex) { HandleLoadError(ex); }
        catch (InvalidOperationException ex) { HandleLoadError(ex); }
        catch (System.IO.IOException ex) { HandleLoadError(ex); }
        catch (TimeoutException ex) { HandleLoadError(ex); }
        finally
        {
            _loading = false;
        }

        void HandleLoadError(Exception ex) =>
            Toasts.Show("Board", $"Load failed: {ex.Message}", ToastKind.Err);
    }

    private async Task PollRunningSessions()
    {
        try
        {
            var all = await Sessions.ListForTenantAsync(_tenantId);
            _sessions = _isAdmin ? all : all.Where(s => s.MemberUserId == _userId).ToList();
            _sessionRepos = await Sessions.ListAllReposForTenantAsync(_tenantId);
            StateHasChanged();
            if (_sessions.All(s => s.Status != "Running"))
            {
                _pollTimer?.Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
            }
        }
        // Suppress poll errors — next tick will retry.
        catch (System.Net.Http.HttpRequestException ex) { _ = ex.Message; }
        catch (System.IO.IOException ex) { _ = ex.Message; }
        catch (InvalidOperationException ex) { _ = ex.Message; }
        catch (TimeoutException ex) { _ = ex.Message; }
    }

    // Backstop only — the live stream drives immediate updates; this slow tick reconciles from the DB
    // in case an event was dropped or this circuit joined after the run's early events had passed.
    private void StartPolling() => _pollTimer?.Change(TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));

    // ── Live activity subscription (M6) ──────────────────────────────────────────────────────────
    private async Task ListenAsync(CancellationToken ct)
    {
        try
        {
            // Lean producer: just enqueue. FlushFeed (the ~150ms render timer) folds events into _activity
            // and renders ONCE per tick, so an event burst during a run can't thrash the circuit.
            await foreach (var ev in Feed.Subscribe(_tenantId, ct))
            {
                _incoming.Enqueue(ev);
            }
        }
        catch (OperationCanceledException) { /* circuit closing — expected */ }
        // Stream fault — the backstop poll still reconciles from the DB.
        catch (Microsoft.AspNetCore.SignalR.HubException ex) { _ = ex.Message; }
        catch (System.Net.Http.HttpRequestException ex) { _ = ex.Message; }
        catch (System.IO.IOException ex) { _ = ex.Message; }
        catch (InvalidOperationException ex) { _ = ex.Message; }
    }

    // Runs on the circuit thread (via InvokeAsync from the render timer): drain queued events, fold them
    // into the per-session feed, and render at most once per tick.
    private async Task FlushFeed()
    {
        if (_incoming.IsEmpty) { return; }

        var changed = false;
        var sawTerminal = false;
        while (_incoming.TryDequeue(out var ev))
        {
            // Surface activity only for sessions this user can see (the stream is per-tenant).
            if (_sessions is null || !_sessions.Any(s => s.Id == ev.SessionId)) { continue; }
            if (!_activity.TryGetValue(ev.SessionId, out var list))
            {
                list = new List<SessionRunEvent>();
                _activity[ev.SessionId] = list;
            }
            list.Add(ev);
            if (list.Count > 40) { list.RemoveRange(0, list.Count - 40); }
            changed = true;
            if (ev.Kind is SessionRunEventKind.RepoDone or SessionRunEventKind.Done or SessionRunEventKind.Failed)
            {
                sawTerminal = true;
            }
        }

        // The DB stays authoritative — re-read on terminal/per-repo events so PR links + final status are
        // right even if a stream event was dropped.
        if (sawTerminal) { await ReloadSessionsState(); }
        if (changed || sawTerminal) { StateHasChanged(); }
    }

    private async Task ReloadSessionsState()
    {
        try
        {
            var all = await Sessions.ListForTenantAsync(_tenantId);
            _sessions = _isAdmin ? all : all.Where(s => s.MemberUserId == _userId).ToList();
            _sessionRepos = await Sessions.ListAllReposForTenantAsync(_tenantId);
        }
        // Best-effort; the next event or poll retries.
        catch (System.Net.Http.HttpRequestException ex) { _ = ex.Message; }
        catch (System.IO.IOException ex) { _ = ex.Message; }
        catch (InvalidOperationException ex) { _ = ex.Message; }
        catch (TimeoutException ex) { _ = ex.Message; }
    }

    private string BoardName(Guid id) =>
        _boards?.FirstOrDefault(w => w.Id == id)?.Name ?? id.ToString("N")[..8];

