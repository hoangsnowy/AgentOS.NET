                        <label class="board-repo-option">
                            <input type="radio" name="@($"autopilot-{b.Id}")" checked="@(mode == AgentOs.Web.Services.Orchestration.AutopilotMode.Off)"
                                   @onchange="@(() => SetAutopilot(b, "Off"))" />
                            <span><strong>Nothing</strong> <span class="muted">— it only works when you click</span></span>
                        </label>
                        <label class="board-repo-option">
                            <input type="radio" name="@($"autopilot-{b.Id}")" checked="@(mode == AgentOs.Web.Services.Orchestration.AutopilotMode.Build)"
                                   @onchange="@(() => SetAutopilot(b, "Build"))" />
                            <span><strong>Build</strong> <span class="muted">— start approved tickets in order, two at a time, and fix failing checks. You merge.</span></span>
                        </label>
                        <label class="board-repo-option">
                            <input type="radio" name="@($"autopilot-{b.Id}")" checked="@(mode == AgentOs.Web.Services.Orchestration.AutopilotMode.BuildAndMerge)"
                                   @onchange="@(() => SetAutopilot(b, "BuildAndMerge"))" />
                            <span><strong>Build and merge</strong> <span class="muted">— also merge each change once all its checks pass.</span></span>
                        </label>
                    </div>
                    <p class="muted board-form-hint">It checks the project every minute, asks you when a fix keeps failing, and never touches tickets marked for a person.</p>
                    <div class="form-actions">
                        <Btn Size="Btn.ButtonSize.Sm" OnClick="@(() => AutopilotNow(b))" Disabled="@(_busy || mode == AgentOs.Web.Services.Orchestration.AutopilotMode.Off)">
                            <Icon Name="arrow-clockwise" Size="13" /> Check now
                        </Btn>
                    </div>
                </div>
                @{ var decisions = _autopilotLog.GetValueOrDefault(b.Id) ?? []; }
                @if (decisions.Count == 0)
                {
                    <p class="muted board-form-hint">No decisions yet.</p>
                }
                else
                {
                    <ol class="autopilot-log" aria-label="@($"Autopilot decisions on {b.Name}, newest first")">
                        @foreach (var (at, text) in decisions)
                        {
                            <li><span class="board-activity-time" title="@at.ToString("u")">@Ago(at)</span> @text</li>
