    // ── "Start from idea" wizard (bootstrap) ─────────────────────────────────────────────────────

    // Only boards with a Projects v2 number can take new tickets (each issue is added to the board).
    private IEnumerable<WorkspaceEntity> IdeaBoards()
        => _boards?.Where(b => b.ProjectNumber is not null) ?? Enumerable.Empty<WorkspaceEntity>();

    private string StepClass(IdeaStep step)
        => _ideaStep == step ? "active" : (_ideaStep > step ? "done" : "");

    private async Task OnIdeaBoardChanged()
    {
        _ideaRepoId = "";
        _ideaRepos = null;
        var board = IdeaBoards().FirstOrDefault(b => b.Id.ToString() == _ideaBoardId);
        if (board is not null)
        {
            _ideaRepos = await Workspaces.ListReposForTenantAsync(_tenantId, board.Id);
        }
    }

    // Generate spec + tickets from the idea. The bootstrap service (and the LLM-backed agents it
    // builds) is resolved LAZILY in a fresh scope — never @inject'd — so opening the app never eagerly
    // constructs an LLM client and crashes the circuit (the documented eager-DI landmine).
    private async Task GenerateIdea()
    {
        if (_ideaBusy) { return; }
        if (string.IsNullOrWhiteSpace(_ideaText))
        {
            _ideaError = "Describe your idea first.";
            return;
        }
        if (string.IsNullOrEmpty(_ideaBoardId) || string.IsNullOrEmpty(_ideaRepoId))
        {
            _ideaError = "Pick a target board and repository.";
            return;
        }
        _ideaBusy = true;
        _ideaError = null;
        // The LLM-backed bootstrap agents throw LlmException (: System.Exception) on a missing key or
        // parse failure — surface ANY failure, never tear down the circuit (see CircuitSafe).
        await CircuitSafe.RunAsync(
            async () =>
            {
                using var scope = ScopeFactory.CreateScope();
                var svc = scope.ServiceProvider.GetRequiredService<IIdeaBootstrapService>();
                _preview = await svc.GenerateAsync(_ideaText.Trim());

                _draftRows.Clear();
                for (var k = 0; k < _preview.Tickets.Count; k++)
                {
                    var t = _preview.Tickets[k];
                    _draftRows.Add(new DraftRow
                    {
                        Key = k,
                        Title = t.Title,
                        Body = t.Body,
                        Labels = t.Labels.ToList(),
                        AiReady = t.AiReady,
                        DependsOnKeys = (t.DependsOn ?? []).ToList(),
                    });
                }
                _ideaStep = IdeaStep.Review;
            },
            ex => _ideaError = $"Generation failed: {ex.Message}");
        _ideaBusy = false;
    }

    // Flip a ticket's ai gate, keeping the ai:ready / needs-human label in sync with the flag.
    private static void ToggleAiReady(DraftRow row, ChangeEventArgs e)
    {
        row.AiReady = e.Value is true;
        row.Labels.RemoveAll(l =>
            string.Equals(l, StandardLabels.AiReady, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(l, StandardLabels.NeedsHuman, StringComparison.OrdinalIgnoreCase));
        row.Labels.Add(row.AiReady ? StandardLabels.AiReady : StandardLabels.NeedsHuman);
    }

    // Seed labels, then create the (edited) tickets as real issues on the chosen repo + add to board.
    // When runReady, auto-run a session per ai:ready ticket — the review step was the human gate, so
    // this is the autonomous idea→PRs path.
    private async Task CreateTickets(bool runReady)
    {
        if (_ideaBusy) { return; }
        var board = IdeaBoards().FirstOrDefault(b => b.Id.ToString() == _ideaBoardId);
        var repo = (_ideaRepos ?? Array.Empty<WorkspaceRepoEntity>()).FirstOrDefault(r => r.Id.ToString() == _ideaRepoId);
        if (board is null || repo is null)
        {
            _ideaError = "Pick a target board and repository.";
            return;
        }
        if (runReady && EngineSelection.Validate(_brain, _runOnMachine) is { } brainErr)
        {
            _ideaError = brainErr;
            return;
        }
        _ideaBusy = true;
        _ideaError = null;
        try
        {
            var pat = await ConfigStore.GetForTenantAsync(_tenantId, board.CredentialRef);
            if (string.IsNullOrEmpty(pat))
            {
                _ideaError = "Could not retrieve board credentials. Reconnect the board.";
                return;
            }

            var branch = string.IsNullOrWhiteSpace(repo.DefaultBranch) ? "main" : repo.DefaultBranch;
            var repoDesc = new WorkspaceDescriptor(
                repo.Id, _tenantId, board.Kind, repo.Owner, repo.Repo, board.Project, branch, pat);
            var boardDesc = new BoardDescriptor(
                board.Id, _tenantId, board.Kind, board.ProjectOwner, board.ProjectScope,
                board.ProjectNumber, board.ProjectNodeId, pat, board.Project);

            // Seed the taxonomy first so issue creation can apply the labels.
            await BoardWriteSvc.EnsureLabelsAsync(repoDesc, StandardLabels.All);

            // Rows the member kept, their dependencies re-pointed at kept rows only.
            var rows = _draftRows.Where(r => !string.IsNullOrWhiteSpace(r.Title)).ToList();
            var position = rows.Select((r, i) => (r.Key, i)).ToDictionary(p => p.Key, p => p.i);
            var drafts = rows
                .Select(r => new TicketDraft(r.Title.Trim(), r.Body, r.Labels.ToList(), r.AiReady,
                    r.DependsOnKeys.Where(position.ContainsKey).Select(k => position[k]).ToList()))
                .ToList();
            // Create in dependency order, one by one, so each body can name the real numbers of what it waits for.
            var created = new CreatedTicket?[drafts.Count];
            foreach (var i in TicketDependencies.CreationOrder(drafts.Count, i => drafts[i].DependsOn))
            {
                var waitsFor = (drafts[i].DependsOn ?? []).Where(d => created[d] is not null).Select(d => created[d]!.Number).ToList();
                var draft = waitsFor.Count == 0 ? drafts[i] : drafts[i] with { Body = drafts[i].Body.TrimEnd() + "\n\n" + TicketDependencies.Line(waitsFor) };
                var one = await BoardWriteSvc.CreateTicketsAsync(boardDesc, repoDesc, [draft]);
                if (one.Count > 0) { created[i] = one[0]; }
            }
            _createdTickets = created.Where(c => c is not null).Select(c => c!).ToList();

            Toasts.Show("Board", $"Created {_createdTickets.Count} ticket(s) on {repo.Owner}/{repo.Repo}.", ToastKind.Ok);

            // Auto-run: one session per ai:ready created ticket (created order matches the drafts sent).
            if (runReady)
            {
                var repoOpt = new RepoOption { Owner = repo.Owner, Repo = repo.Repo, DefaultBranch = branch, WorkspaceRepoId = repo.Id, Selected = true };
                var sessions = new List<RemoteSessionEntity>();
                // Only what nothing blocks starts now; the rest waits for its dependencies (Run all approved picks them up).
                for (var i = 0; i < drafts.Count; i++)
                {
                    if (!drafts[i].AiReady || created[i] is not { } t || (drafts[i].DependsOn?.Count ?? 0) > 0) { continue; }
                    sessions.Add(await PersistSessionAsync(
                        board.Id, t.Number, $"#{t.Number} {t.Title}", t.ItemNodeId, "Issue", [repoOpt], _runOnMachine,
                        brain: _brain, ticketType: TicketTypeOf(drafts[i].Labels)));
                }
                if (sessions.Count > 0)
                {
                    Toasts.Show("Board", $"Starting {sessions.Count} approved ticket(s)…", ToastKind.Ok);
                    await ReloadAll();
                    ResetIdea();
                    _tab = Tab.Sessions;
                    foreach (var s in sessions)
                    {
                        await RunSession(s);
                    }
                    return;
                }
            }

            _ideaStep = IdeaStep.Result;
        }
        catch (System.Net.Http.HttpRequestException ex) { HandleCreateError(ex); }
        catch (System.Text.Json.JsonException ex) { HandleCreateError(ex); }
        catch (InvalidOperationException ex) { HandleCreateError(ex); }
        catch (System.IO.IOException ex) { HandleCreateError(ex); }
        catch (TimeoutException ex) { HandleCreateError(ex); }
        finally
        {
            _ideaBusy = false;
        }

        void HandleCreateError(Exception ex)
        {
            _ideaError = $"Create failed: {ex.Message}";
            Toasts.Show("Board", _ideaError, ToastKind.Err);
        }
    }

    private void ResetIdea()
    {
        _ideaStep = IdeaStep.Input;
        _ideaText = "";
        _preview = null;
        _draftRows.Clear();
        _createdTickets = Array.Empty<CreatedTicket>();
        _ideaError = null;
        _runOnMachine = false;
    }

    // ── Tickets → session ────────────────────────────────────────────────────────────────────────

    // Open the repo-picker dialog for a ticket: offer the board's repos + the ticket's own repo,
    // pre-selecting the ticket's repo.
    private void OpenWorkDialog(BoardTicket ticket)
    {
        if (ticket.RepoOwner is null || ticket.RepoName is null) { return; }
        _workTicket = ticket;
        _workRepoOptions.Clear();
        foreach (var r in _repos ?? Array.Empty<WorkspaceRepoEntity>())
        {
            _workRepoOptions.Add(new RepoOption
            {
                Owner = r.Owner,
                Repo = r.Repo,
                DefaultBranch = r.DefaultBranch,
                WorkspaceRepoId = r.Id,
                Selected = r.Owner == ticket.RepoOwner && r.Repo == ticket.RepoName,
            });
        }
        // The ticket's own repo may not be a curated board repo — add it (pre-selected).
        if (!_workRepoOptions.Any(o => o.Owner == ticket.RepoOwner && o.Repo == ticket.RepoName))
        {
            _workRepoOptions.Insert(0, new RepoOption
            {
                Owner = ticket.RepoOwner,
                Repo = ticket.RepoName,
                DefaultBranch = "main",
                Selected = true,
            });
        }
        _runOnMachine = false;
        _confirmPersonTicket = false;
        _showWorkDialog = true;
    }

    // A ticket meant for a person: an epic, or one a planner flagged needs-human. One click must not hand it to the
    // AI (a member started the whole M1 epic by mistake on the first real project).
    private bool _confirmPersonTicket;

    private static bool NeedsPerson(BoardTicket ticket) =>
        ticket.Labels.Any(l => l.Equals("needs-human", StringComparison.OrdinalIgnoreCase)
                               || l.Equals("epic", StringComparison.OrdinalIgnoreCase)
                               || l.Equals("type:epic", StringComparison.OrdinalIgnoreCase));

    private void CloseWorkDialog()
    {
        _showWorkDialog = false;
        _workTicket = null;
    }

    // Cross-link — open the ticket as a story in the Workflow app (the run surface), prefilling the story
    // via a one-shot launch payload so the ticket → run handoff reads as one engine.
    private void OpenInWorkflow(BoardTicket ticket)
    {
        var app = AgentOs.Web.Services.AppCatalog.Find("workflow");
        if (app is null) { return; }
        var story = ticket.Number is { } n ? $"#{n} {ticket.Title}".Trim() : ticket.Title.Trim();
        WM.RequestLaunchPayload("workflow", story);
        WM.OpenApp(app.Key, app.Title, app.Icon, app.W, app.H);
    }

    private async Task ConfirmWorkSession()
    {
        if (_busy || _selectedBoard is null || _workTicket is null) { return; }
        if (NeedsPerson(_workTicket) && !_confirmPersonTicket) { return; }
        var selected = _workRepoOptions.Where(o => o.Selected).ToList();
        if (selected.Count == 0)
        {
            Toasts.Show("Board", "Select at least one repository.", ToastKind.Err);
            return;
        }
        if (EngineSelection.Validate(_brain, _runOnMachine) is { } brainErr)
        {
            Toasts.Show("Board", brainErr, ToastKind.Err);
            return;
        }
        _busy = true;
        try
        {
            var ticket = _workTicket;
            // The ticket's own repo becomes the session's primary repo — put it first.
            var ordered = selected
                .OrderByDescending(o => o.Owner == ticket.RepoOwner && o.Repo == ticket.RepoName)
                .ToList();
            var created = await PersistSessionAsync(
                _selectedBoard.Id, ticket.Number, $"#{ticket.Number} {ticket.Title}",
                ticket.ItemNodeId, ticket.Kind.ToString(), ordered, _runOnMachine,
                brain: _brain, ticketType: TicketTypeOf(ticket.Labels));

            // "Start working" means it: the task starts now (it used to sit as a draft until Run was pressed on Tasks).
            CloseWorkDialog();
            await ReloadAll();
            _tab = Tab.Sessions;
            CloseBoard();
            await RunSession(created);
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Couldn't start the task: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Couldn't start the task: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Couldn't start the task: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Couldn't start the task: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busy = false;
        }
    }

    // True when the member has at least one runner that isn't revoked — gates the "run on my machine"
    // hint (the dispatch itself still fails clearly if no runner is actually live).
    private bool HasRunner() => _runners?.Any(r => r.Status != "Revoked") == true;

    // Persist a session (+ its repo rows) for a ticket; returns the entity so the caller can run it.
    // The single source of truth for "ticket → session", shared by Work-on-this, Run-all-ready, and
    // the idea-wizard auto-run. repos[0] is the primary repo.
    private Task<RemoteSessionEntity> PersistSessionAsync(
        Guid workspaceId, int? issueNumber, string title, string? itemNodeId, string ticketKind,
        IReadOnlyList<RepoOption> repos, bool runOnMachine = false, string brain = "Quick", string? ticketType = null) =>
        TaskService.CreateAsync(_tenantId, _userId, workspaceId, issueNumber, title, itemNodeId, ticketKind,
            repos.Select(r => new AgentOs.Web.Services.BoardTasks.BoardTaskService.TaskRepo(r.Owner, r.Repo, r.DefaultBranch, r.WorkspaceRepoId)).ToList(),
            runOnMachine, brain, ticketType);

    // The ticket's `type:*` label (type:feature / type:bug / …), captured so the greenfield router can
    // hard-gate the Quality engine. First match wins; null when the ticket carries no type label.
    private static string? TicketTypeOf(IEnumerable<string>? labels) =>
        labels?.FirstOrDefault(l => l.StartsWith("type:", StringComparison.OrdinalIgnoreCase));

    // A1 residue — the single builder for the repo-level, token-carrying WorkspaceDescriptor the source /
    // PR / label services consume (transient; the PAT is resolved per call, never persisted). Kind +
    // Project come from the board (the workspace); the descriptor Id is the board's workspace id.
    private static WorkspaceDescriptor RepoDescriptor(
        WorkspaceEntity board, string tenantId, string owner, string repo, string defaultBranch, string pat) =>
        AgentOs.Web.Services.BoardTasks.BoardTaskService.RepoDescriptor(board, tenantId, owner, repo, defaultBranch, pat);

    // The ai:ready tickets on the board that the agent can run unattended: a real, OPEN issue with a repo and no task
    // already working on it or done (a failed or closed task may be run again).
    private List<BoardTicket> ReadyTickets() => _tickets is null
        ? new List<BoardTicket>()
        : _tickets.Where(t => t.Labels.Contains(StandardLabels.AiReady)
            && t.Kind != BoardTicketKind.DraftIssue && t.RepoOwner is not null && t.RepoName is not null
            && !IsClosed(t) && !HasLiveTask(t)).ToList();

    private static bool IsClosed(BoardTicket t) => string.Equals(t.State, "CLOSED", StringComparison.OrdinalIgnoreCase)
        || string.Equals(t.State, "closed", StringComparison.Ordinal);

    private bool HasLiveTask(BoardTicket t) => (_sessions ?? []).Any(s => s.IssueNumber == t.Number
        && s.RepoOwner == t.RepoOwner && s.RepoName == t.RepoName && s.Status is not ("Failed" or "Closed"));

    // How many tasks run at once on a board (a paired computer runs two CLI runs side by side by default).
    private const int MaxParallelTasks = 2;

    private RepoOption RepoOptionForTicket(BoardTicket ticket)
    {
        var curated = (_repos ?? Array.Empty<WorkspaceRepoEntity>())
            .FirstOrDefault(r => r.Owner == ticket.RepoOwner && r.Repo == ticket.RepoName);
        return new RepoOption
        {
            Owner = ticket.RepoOwner!,
            Repo = ticket.RepoName!,
            DefaultBranch = curated?.DefaultBranch ?? "main",
            WorkspaceRepoId = curated?.Id,
            Selected = true,
        };
    }

    // Batch: create a session per ai:ready ticket and run them all (the "server thinks, runner does"
    // path, unattended). Shares PersistSessionAsync + RunSession with the single-ticket flow.
    private async Task RunAllReady()
    {
        if (_busy || _selectedBoard is null) { return; }
        var candidates = ReadyTickets();
        if (candidates.Count == 0)
        {
            Toasts.Show("Board", "Nothing to start — every approved ticket is done or already being worked on.", ToastKind.Ok);
            return;
        }
        _busy = true;
        try
        {
            // Dependencies come from each ticket's body ("Depends on #8, #11"); a ticket waits until they are closed.
            var board = _selectedBoard;
            var pat = await ConfigStore.GetForTenantAsync(_tenantId, board.CredentialRef) ?? "";
            var closed = (_tickets ?? []).Where(IsClosed).Select(t => t.Number).ToHashSet();
            var ready = new List<BoardTicket>();
            var waiting = new List<string>();
            using (var scope = ScopeFactory.CreateScope())
            {
                var resolver = scope.ServiceProvider.GetRequiredService<ISourceProviderResolver>();
                resolver.TryResolve(board.Kind, out var provider);
                foreach (var t in candidates)
                {
                    string? body = null;
                    if (provider is not null && t.Number is int number)
                    {
                        try { body = await provider.ReadTicketBodyAsync(RepoDescriptor(board, _tenantId, t.RepoOwner!, t.RepoName!, "main", pat), number); }
                        catch (Exception ex) when (ex is System.Net.Http.HttpRequestException or Octokit.ApiException or InvalidOperationException or TaskCanceledException) { _ = ex; }
                    }
                    var open = TicketDependencies.Parse(body).Where(d => !closed.Contains(d)).ToList();
                    if (open.Count == 0) { ready.Add(t); }
                    else { waiting.Add($"#{t.Number} (after {string.Join(", ", open.Select(d => "#" + d))})"); }
                }
            }
            // Within the parallel cap, highest priority first (p0 before p1 before p2), then oldest ticket.
            var running = (_sessions ?? []).Count(s => s.Status == "Running");
            var slots = Math.Max(0, MaxParallelTasks - running);
            var start = ready.OrderBy(t => t.Labels.Contains("p0") ? 0 : t.Labels.Contains("p1") ? 1 : 2).ThenBy(t => t.Number).Take(slots).ToList();
            var queued = ready.Skip(start.Count).Select(t => "#" + t.Number).ToList();
            // A connected computer of the member's is used (their own AI plan); otherwise the servers.
            var onComputer = (_runners ?? []).Any(r => r.OwnerUserId == _userId && Broker.IsConnected(r.Id));
            var sessions = new List<RemoteSessionEntity>();
            foreach (var ticket in start)
            {
                sessions.Add(await PersistSessionAsync(
                    board.Id, ticket.Number, $"#{ticket.Number} {ticket.Title}",
                    ticket.ItemNodeId, ticket.Kind.ToString(), [RepoOptionForTicket(ticket)], onComputer,
                    ticketType: TicketTypeOf(ticket.Labels)));
            }
            var report = sessions.Count == 0 ? $"Nothing can start yet ({running} running)." : $"Starting {string.Join(", ", start.Select(t => "#" + t.Number))}.";
            if (queued.Count > 0) { report += $" Next when a slot frees: {string.Join(", ", queued)}."; }
            if (waiting.Count > 0) { report += $" Waiting: {string.Join("; ", waiting)}."; }
            Toasts.Show("Board", report, ToastKind.Ok);
            await ReloadAll();
            _tab = Tab.Sessions;
            CloseBoard();
            foreach (var s in sessions)
            {
                await RunSession(s);
            }
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Run all failed: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Run all failed: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Run all failed: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Run all failed: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busy = false;
        }
    }

    // The Sessions table asks for every row's repos on each render; group them once per load (keyed by the list
    // instance) instead of rescanning the whole list per row — O(repos) per load, not O(sessions × repos) per render.
    private IReadOnlyList<SessionRepoEntity>? _sessionReposIndexed;
    private Dictionary<Guid, SessionRepoEntity[]> _reposBySession = new();

    // "Ready for review" rows whose pull request has since been merged → "Done". Only open-PR rows are checked, and
    // a merged row is written back, so each change costs one GitHub call in its life, on load/refresh only.
    private async Task SyncMergedAsync()
    {
        var pending = (_sessionRepos ?? Array.Empty<SessionRepoEntity>())
            .Where(r => r.Status == "Done" && !string.IsNullOrEmpty(r.PrUrl))
            .Take(20)
            .ToList();
        if (pending.Count == 0 || _boards is null) { return; }
        var changed = false;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var prs = scope.ServiceProvider.GetRequiredService<AgentOs.Domain.Workspaces.IPrCreationService>();
            var sessionsById = (_sessions ?? []).ToDictionary(s => s.Id);
            var pats = new Dictionary<Guid, string?>();
            foreach (var repo in pending)
            {
                if (!sessionsById.TryGetValue(repo.SessionId, out var session)) { continue; }
                var board = _boards.FirstOrDefault(b => b.Id == session.WorkspaceId);
                if (board is null || PrNumber(repo.PrUrl) is not { } number) { continue; }
                if (!pats.TryGetValue(board.Id, out var pat))
                {
                    pat = await ConfigStore.GetForTenantAsync(_tenantId, board.CredentialRef);
                    pats[board.Id] = pat;
                }
                if (string.IsNullOrEmpty(pat)) { continue; }
                var state = await prs.GetStateAsync(RepoDescriptor(board, _tenantId, repo.Owner, repo.Repo, repo.DefaultBranch, pat), number);
                if (state != AgentOs.Domain.Workspaces.PrState.Merged) { continue; }
                await Sessions.UpdateRepoRunResultAsync(_tenantId, repo.Id, "Merged", repo.BranchName, repo.PrUrl, null);
                await Sessions.RecomputeSessionStatusForTenantAsync(_tenantId, repo.SessionId);
                changed = true;
            }
            if (!changed) { return; }
            var all = await Sessions.ListForTenantAsync(_tenantId);
            _sessions = _isAdmin ? all : all.Where(s => s.MemberUserId == _userId).ToList();
            _sessionRepos = await Sessions.ListAllReposForTenantAsync(_tenantId);
            await InvokeAsync(StateHasChanged);
        }
        // Best effort — the rows simply keep "Ready for review" until the next refresh.
        catch (Exception ex) when (ex is System.Net.Http.HttpRequestException or InvalidOperationException or System.IO.IOException or TimeoutException or ObjectDisposedException) { _ = ex.Message; }
    }

    private static int? PrNumber(string? url)
    {
        if (string.IsNullOrEmpty(url)) { return null; }
        var i = url.LastIndexOf("/pull/", StringComparison.Ordinal);
        return i >= 0 && int.TryParse(url.AsSpan(i + "/pull/".Length).TrimEnd('/'), System.Globalization.NumberStyles.None,
            System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : null;
    }

    // The furthest plain step this task's live feed has reported (feed messages carry the step labels), or -1.
    private int CurrentStep(Guid sessionId)
    {
        if (!_activity.TryGetValue(sessionId, out var feed)) { return -1; }
        var furthest = -1;
        foreach (var ev in feed)
        {
            furthest = Math.Max(furthest, AgentOs.Domain.Sessions.TaskSteps.IndexOfLabel(ev.Message));
        }
        return furthest;
    }

    // A person, not a GUID: "You" for the signed-in member, else a short id (full id in the cell's tooltip).
    private string MemberLabel(string? userId) =>
        string.IsNullOrEmpty(userId) ? "—" : userId == _userId ? "You" : "Member " + userId[..Math.Min(8, userId.Length)];

    // Task and repo states in words, not enum names (the stored values stay as they are).
    private static string PlainStatus(string status) => status switch
    {
        "Draft" => "Not started",
        "Pending" => "Waiting",
        "Running" => "Working…",
        "Failed" => "Couldn't finish",
        "Blocked" => "Needs your review",   // the QA gate refused to open the change
        "Done" => "Ready for review",
        "Merged" => "Done",
        "Testing" => "Being tested",
        "Accepted" => "Passed testing",
        "Rejected" => "Failed testing",
        "Closed" => "Closed",
        _ => status,
    };

    private IReadOnlyList<SessionRepoEntity> SessionReposFor(Guid sessionId)
    {
        if (!ReferenceEquals(_sessionReposIndexed, _sessionRepos))
        {
            _reposBySession = (_sessionRepos ?? Array.Empty<SessionRepoEntity>())
                .GroupBy(r => r.SessionId)
                .ToDictionary(g => g.Key, g => g.OrderBy(r => r.Owner).ThenBy(r => r.Repo).ToArray());
            _sessionReposIndexed = _sessionRepos;
        }
        return _reposBySession.TryGetValue(sessionId, out var repos) ? repos : Array.Empty<SessionRepoEntity>();
    }

    // ── Run session (fire-and-forget AI pipeline) ──────────────────────────────────────────────

    private async Task RunSession(RemoteSessionEntity session, string? changeRequest = null)
    {
        if (_busyId == session.Id) { return; }
        _busyId = session.Id;
        try
        {
            // The run itself lives in BoardTaskService (shared with the project orchestrator); this only reports it.
            var started = await TaskService.StartAsync(_tenantId, session.Id, changeRequest, _cliProfile);
            switch (started)
            {
                case AgentOs.Web.Services.BoardTasks.TaskStart.Started:
                    _sessionRepos = await Sessions.ListAllReposForTenantAsync(_tenantId);
                    var all = await Sessions.ListForTenantAsync(_tenantId);
                    _sessions = _isAdmin ? all : all.Where(s => s.MemberUserId == _userId).ToList();
                    Toasts.Show("Board", $"Task #{session.IssueNumber} started — the AI is working on it. You can close this window.", ToastKind.Ok);
                    StartPolling();
                    break;
                case AgentOs.Web.Services.BoardTasks.TaskStart.BoardNotFound:
                    Toasts.Show("Board", "Board not found — reload and try again.", ToastKind.Err);
                    break;
                case AgentOs.Web.Services.BoardTasks.TaskStart.NoCodeProject:
                    Toasts.Show("Board", "This task has no code project to work on. Start it again from the ticket.", ToastKind.Err);
                    break;
                case AgentOs.Web.Services.BoardTasks.TaskStart.NoGitHubAccess:
                    Toasts.Show("Board", "GitHub access has expired — reconnect the project.", ToastKind.Err);
                    break;
                default:
                    Toasts.Show("Board", "This task no longer exists — refresh the list.", ToastKind.Err);
                    break;
            }
        }
        catch (Exception ex) when (ex is System.Net.Http.HttpRequestException or InvalidOperationException or System.IO.IOException or TimeoutException)
        {
            Toasts.Show("Board", $"Run failed: {ex.Message}", ToastKind.Err);
        }
        finally
        {
            _busyId = null;
        }
    }

    // The QA-loop iteration cap a Thorough run advertises (BoardTaskService applies the same clamp).
    private int QualityNMax() => TaskService.QualityNMax();

    private void OnBrainChanged()
    {
        if (EngineSelection.IsQuality(_brain)) { _runOnMachine = false; }
