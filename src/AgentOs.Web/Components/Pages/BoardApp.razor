    private RenderFragment PreviewCard(WorkspaceRepoEntity r, AgentOs.Web.Services.Preview.PreviewState? p) => @<div class="board-preview" data-state="@(_previewAsk.ContainsKey(r.Id) ? "Ask" : p?.State)" role="status" aria-live="polite">
        @if (_previewAsk.TryGetValue(r.Id, out var ask))
        {
