    private async Task RegisterRunner()
    {
        if (_busy) { return; }
        if (string.IsNullOrWhiteSpace(_runnerLabel))
        {
            Toasts.Show("Board", "A label is required.", ToastKind.Err);
            return;
        }
        _busy = true;
        try
        {
            var secret = Pairing.Issue();
            var entity = new RunnerEntity
            {
                Id = Guid.NewGuid(),
                TenantId = _tenantId,
                OwnerUserId = _userId,
                Label = _runnerLabel.Trim(),
                TokenHash = secret.TokenHash,
                Status = "Pending",
                CreatedAtUtc = DateTimeOffset.UtcNow,
                CreatedByUserId = string.IsNullOrEmpty(_userId) ? null : _userId,
            };
            await Runners.AddForTenantAsync(entity);
            _newRunner = (entity.Id, secret.Token);
            _newRunnerLabel = entity.Label;
            _newRunnerConnected = false;
            _newRunnerCode = PairingCodes.IssueTypedCode(entity.Id, secret.Token, Nav.BaseUri + "hubs/remote-agent");
            _runnerLabel = "";
            _ = WatchForConnectionAsync(entity.Id);
            var r0 = await Runners.ListForTenantAsync(_tenantId);
            _runners = _isAdmin ? r0 : r0.Where(r => r.OwnerUserId == _userId).ToList();
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Register failed: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Register failed: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Register failed: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Register failed: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeRunner(RunnerEntity r)
    {
        _busyId = r.Id;
        try
        {
            await Runners.SetStatusForTenantAsync(_tenantId, r.Id, "Revoked");
            Toasts.Show("Board", $"Revoked '{r.Label}'.", ToastKind.Ok);
            var r0 = await Runners.ListForTenantAsync(_tenantId);
            _runners = _isAdmin ? r0 : r0.Where(r => r.OwnerUserId == _userId).ToList();
        }
        catch (System.Net.Http.HttpRequestException ex) { Toasts.Show("Board", $"Revoke failed: {ex.Message}", ToastKind.Err); }
        catch (InvalidOperationException ex) { Toasts.Show("Board", $"Revoke failed: {ex.Message}", ToastKind.Err); }
        catch (System.IO.IOException ex) { Toasts.Show("Board", $"Revoke failed: {ex.Message}", ToastKind.Err); }
        catch (TimeoutException ex) { Toasts.Show("Board", $"Revoke failed: {ex.Message}", ToastKind.Err); }
        finally
        {
            _busyId = null;
        }
    }

