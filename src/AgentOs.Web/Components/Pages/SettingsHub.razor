@* SettingsHub — every setting behind ONE rail (UX phase 1, docs/plans/ux-simplification.md). It used to nest a
   second rail inside two categories (LLM & providers: 5 tabs, System: 6), three levels of disclosure; now each
   page is a rail item under a group heading (GNOME Settings style) and the rail has its own search. Pages are
   existing components rendered inline (they stay independently launchable + deep-linkable); Settings (LLM) and
   SystemApp render a single Section without their own rail. Items the signed-in user can't access are hidden. *@

@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject AgentOs.Web.Shell.Services.WindowManagerService WM
@inject IServiceProvider Services

<div class="prefs">
    <aside class="prefs-side" aria-label="Settings pages">
        <input class="prefs-input prefs-side-search" type="search" placeholder="Search settings…" aria-label="Search settings"
               value="@_filter" @oninput="@(e => _filter = e.Value?.ToString() ?? string.Empty)" />
        @foreach (var group in VisibleItems().GroupBy(i => i.Group))
        {
            <div class="prefs-side-head">@group.Key</div>
            @foreach (var item in group)
            {
                var active = IsActive(item);
                <button class="prefs-cat @(active ? "active" : "")" @onclick="@(() => _tab = item.Key)"
                        aria-current="@(active ? "page" : null)">
                    <span class="prefs-cat-ic"><Icon Name="@item.Icon" Size="14" /></span> @item.Label
                </button>
            }
        }
        @if (!VisibleItems().Any())
        {
            <p class="prefs-hint prefs-side-empty">No settings match “@_filter”.</p>
        }
    </aside>

    <div class="@ContentClass">
        @switch (_tab)
        {
            case "keys" or "routing" or "github" or "diagnostics":
                <Settings Section="@SettingsSection(_tab)" />
                break;
            case "agents":   <AgentProfilesApp />; break;
            case "prompts":  <PromptsApp />;  break;
            case "mcp":      <McpApp />;      break;
            case "plugins":  <PluginsApp />;  break;
            case "policy":   <PolicyApp />;   break;
            case "audit" or "evidence":
                <ActivityLog View="@(_tab == "evidence" ? ActivityLog.Tools : ActivityLog.Changes)" />
                break;
            case "users":    <UsersApp />;    break;
            case "tokens":   <ApiTokensApp />; break;
            case "data":     <DataApp />;     break;
            case "platform": <PlatformSettingsApp />; break;
            default:         <SystemApp Section="@_tab" />; break;
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isAdmin;
    private bool _isPlatformAdmin;
    private string _tab = "general";
    private string _filter = string.Empty;

    private enum Access { Everyone, Admin, Platform }

    // Rail order, grouped. "Host" pages are components with their own padded .prefs-content (Settings, System).
    // "Hidden" pages stay routable (deep links, search) but have no rail entry of their own.
    private sealed record Item(string Key, string Group, string Label, string Icon, Access Access, bool Host = false, bool Hidden = false);

    private static readonly Item[] Items =
    [
        new("keys",        "AI",            "Model keys",     "key",              Access.Admin, Host: true),
        new("routing",     "AI",            "Routing",        "lightning",        Access.Admin, Host: true),
        new("agents",      "AI",            "Agent profiles", "diamond",          Access.Admin),
        new("prompts",     "AI",            "Prompts",        "file",             Access.Admin),
        new("github",      "Connections",   "GitHub",         "git-pull-request", Access.Admin, Host: true),
        new("mcp",         "Connections",   "MCP servers",    "arrow-square-out", Access.Admin),
        new("plugins",     "Connections",   "Plugins",        "squares-stack",    Access.Everyone),
        new("policy",      "Governance",    "Tool policy",    "shield",           Access.Admin),
        new("audit",       "Governance",    "Activity log",   "clock-counter",    Access.Admin),
        new("evidence",    "Governance",    "Tool calls",     "scroll",           Access.Admin, Hidden: true),   // a view of Activity log
        new("users",       "People & data", "Users",          "user",             Access.Admin),
        new("tokens",      "People & data", "API tokens",     "tag",              Access.Admin),
        new("data",        "People & data", "Data",           "floppy-disk",      Access.Admin),
        new("general",     "Personal",      "General",        "gear",             Access.Everyone, Host: true),
        new("appearance",  "Personal",      "Appearance",     "palette",          Access.Everyone, Host: true),
        new("datetime",    "Personal",      "Date & time",    "clock",            Access.Everyone, Host: true),
        new("notifs",      "Personal",      "Notifications",  "bell",             Access.Everyone, Host: true),
        new("session",     "Personal",      "Session",        "power",            Access.Everyone, Host: true),
        new("about",       "System",        "About",          "info",             Access.Everyone, Host: true),
        new("diagnostics", "System",        "Diagnostics",    "circle-fill",      Access.Admin, Host: true),
        new("platform",    "System",        "Platform",       "server",           Access.Platform),
    ];

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _isAdmin = state.User.IsAdmin();
            _isPlatformAdmin = state.User.IsPlatformAdmin();
        }
        // Admins land on Model keys (the first thing a new workspace needs); members on their own preferences.
        _tab = _isAdmin ? "keys" : "general";
        Apply(WM.ConsumeLaunchTab(SettingsLinks.AppKey));
        WM.Changed += OnWindowsChanged;
    }

    // A deep link (SettingsLinks.Open) to an already-open hub arrives as a window-manager change.
    private void OnWindowsChanged()
    {
        var target = WM.ConsumeLaunchTab(SettingsLinks.AppKey);
        if (target is not null) { _ = InvokeAsync(() => { Apply(target); StateHasChanged(); }); }
    }

    private void Apply(string? target)
    {
        if (string.IsNullOrWhiteSpace(target)) { return; }
        var key = SettingsLinks.Normalize(target);
        if (!Allowed().Any(i => i.Key == key)) { return; }
        _tab = key;
        _filter = string.Empty;
    }

    public void Dispose() => WM.Changed -= OnWindowsChanged;

    private IEnumerable<Item> Allowed() => Items.Where(i => i.Access switch
    {
        Access.Admin => _isAdmin,
        Access.Platform => _isPlatformAdmin,
        _ => true,
    });

    // The rail filter matches a page's label, or any setting / keyword SettingsSearch maps to that page.
    private IEnumerable<Item> VisibleItems()
    {
        var q = _filter.Trim();
        if (q.Length == 0) { return Allowed().Where(i => !i.Hidden); }
        var catalog = Services.GetService<AgentOs.Domain.Configuration.ISettingsCatalog>();
        var targets = SettingsSearch.Find(q, catalog?.All ?? [], _isAdmin, _isPlatformAdmin, max: 50)
            .Select(h => h.Target).ToHashSet(StringComparer.Ordinal);
        return Allowed().Where(i => !i.Hidden && (targets.Contains(i.Key) || i.Label.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (i.Key == "audit" && targets.Contains("evidence"))));
    }

    // Activity log's rail entry stays lit while its "Tool calls" view (the evidence key) is open.
    private bool IsActive(Item item) => _tab == item.Key || (item.Key == "audit" && _tab == "evidence");

    private static string SettingsSection(string key) => key switch
    {
        "routing" => "providers",
        "diagnostics" => "status",
        _ => key,
    };

    private string ContentClass => Items.FirstOrDefault(i => i.Key == _tab) is { Host: true } ? "prefs-content flush" : "prefs-content";
}
