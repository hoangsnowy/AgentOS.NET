@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager Nav
@inject AgentOs.Web.Shell.Services.WindowManagerService WM
@inject AgentOs.Web.Shell.Services.ToastService Toasts
@inject AgentOs.Web.Services.AuthSession Auth
@inject IServiceProvider Services

<TopBar />

<div class="shell shell-deskmode">
    <div class="shell-pane">
        <main class="shell-main">
            @Body
        </main>

        @* All open desktop-app windows render here on top of the desktop. *@
        <WindowHost />

        <Taskbar StartOpen="_startOpen" OnToggleStart="ToggleStart" />
    </div>
</div>

@* ===== Start menu — Kickoff-style launcher: search · pinned grid · recents · user bar ===== *@
@if (_startOpen)
{
    <div class="start-menu-backdrop" @onclick="CloseStart" @oncontextmenu="CloseStart" @oncontextmenu:preventDefault="true"></div>
    <div class="kickoff ko-overview" @onclick:stopPropagation="true" role="menu" aria-label="Activities overview">

        <div class="ko-search">
            <span class="ko-search-ic"><Icon Name="search" Size="15" /></span>
            <input class="ko-search-input" type="text" placeholder="Search apps, settings and actions…  (Ctrl K)"
                   autocomplete="off" spellcheck="false"
                   value="@_query" @oninput="OnSearch" @onkeydown="OnSearchKey" @ref="_searchRef" />
            @if (!string.IsNullOrEmpty(_query))
            {
                <button class="ko-search-clear" @onclick="ClearSearch" title="Clear" aria-label="Clear search">
                    <Icon Name="x" Size="13" />
                </button>
            }
        </div>

        <div class="ko-body">
            @if (string.IsNullOrWhiteSpace(_query))
            {
                @* GNOME workspace thumbnail strip — click to switch; dots preview the windows on each. *@
                <div class="ko-section-row"><span class="ko-section">Workspaces</span></div>
                <div class="ko-workspaces">
                    @for (var i = 0; i < AgentOs.Web.Shell.Services.WindowManagerService.WorkspaceCount; i++)
                    {
                        var ws = i;
                        var wsWins = WM.WindowsOn(ws).ToList();
                        var wsClass = WM.ActiveWorkspace == ws ? "ko-ws active" : "ko-ws";
                        <button class="@wsClass"
                                @onclick="@(() => WM.SwitchWorkspace(ws))" title="@($"Workspace {ws + 1}")">
                            <span class="ko-ws-num">@(ws + 1)</span>
                            <span class="ko-ws-dots">
                                @foreach (var ww in wsWins.Take(5))
                                {
                                    <span class="ko-ws-dot" style="background:@(AppCatalog.Find(ww.AppKey)?.Color ?? "#3584e4")"></span>
                                }
                            </span>
                        </button>
                    }
                </div>

                @if (WM.Open.Any(x => x.Workspace == WM.ActiveWorkspace))
                {
                    <div class="ko-section-row">
                        <span class="ko-section">Open windows</span>
                        <span class="ko-section-count">@WM.Open.Count(x => x.Workspace == WM.ActiveWorkspace)</span>
                    </div>
                    <div class="ko-expose">
                        @foreach (var w in WM.Open.Where(x => x.Workspace == WM.ActiveWorkspace).OrderByDescending(x => x.Z))
                        {
                            var winColor = AppCatalog.Find(w.AppKey)?.Color ?? "#3584e4";
                            <button class="ko-win @(w.Minimized ? "min" : "")" @onclick="@(() => FocusWindow(w))" title="@w.Title">
                                <span class="ko-win-ic" style="background:@winColor;color:#fff"><Icon Name="@w.Icon" Size="26" /></span>
                                <span class="ko-win-title">@w.Title</span>
                            </button>
                        }
                    </div>
                }
                @* Every app this user may open, grouped by category (pinned first within each group). *@
                @foreach (var group in AppCatalog.VisibleAll(_isAdmin).GroupBy(a => a.Category))
                {
                    <div class="ko-section-row">
                        <span class="ko-section">@group.Key</span>
                    </div>
                    <div class="ko-grid">
                        @foreach (var app in group.OrderByDescending(a => a.Pinned))
                        {
                            <button class="ko-tile" @onclick="@(() => Launch(app))" title="@app.Caption">
                                <span class="ko-tile-ic" style="background:@app.Color;color:#fff"><Icon Name="@app.Icon" Size="22" /></span>
                                <span class="ko-tile-label">@app.Title</span>
                            </button>
                        }
                    </div>
                }

                @if (_recents.Count > 0)
                {
                    <div class="ko-section-row">
                        <span class="ko-section">Recent</span>
                    </div>
                    <div class="ko-list">
                        @foreach (var app in _recents)
                        {
                            <button class="ko-row" @onclick="@(() => Launch(app))">
                                <span class="ko-row-ic"><Icon Name="@app.Icon" Size="16" /></span>
                                <span class="ko-row-text">
                                    <span class="ko-row-title">@app.Title</span>
                                    <span class="ko-row-cap">@app.Caption</span>
                                </span>
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="ko-section-row">
                    <span class="ko-section">Apps</span>
                    <span class="ko-section-count">@_results.Count</span>
                </div>
                @if (_results.Count == 0 && _actionHits.Count == 0 && _settingHits.Count == 0)
                {
                    <div class="ko-empty">
                        <Icon Name="search" Size="22" />
                        <span>Nothing matches “@_query”.</span>
                    </div>
                }
                else
                {
                    <div class="ko-list">
                        @foreach (var app in _results)
                        {
                            <button class="ko-row" @onclick="@(() => Launch(app))">
                                <span class="ko-row-ic"><Icon Name="@app.Icon" Size="16" /></span>
                                <span class="ko-row-text">
                                    <span class="ko-row-title">@app.Title</span>
                                    <span class="ko-row-cap">@app.Caption</span>
                                </span>
                                <span class="ko-row-cat">@app.Category</span>
                            </button>
                        }
                    </div>
                    @if (_actionHits.Count > 0)
                    {
                        <div class="ko-section-row">
                            <span class="ko-section">Actions</span>
                            <span class="ko-section-count">@_actionHits.Count</span>
                        </div>
                        <div class="ko-list">
                            @foreach (var action in _actionHits)
                            {
                                <button class="ko-row" @onclick="@(() => RunActionAsync(action))">
                                    <span class="ko-row-ic"><Icon Name="@action.Icon" Size="16" /></span>
                                    <span class="ko-row-text">
                                        <span class="ko-row-title">@action.Title</span>
                                        <span class="ko-row-cap">@action.Caption</span>
                                    </span>
                                </button>
                            }
                        </div>
                    }
                    @if (_settingHits.Count > 0)
                    {
                        <div class="ko-section-row">
                            <span class="ko-section">Settings</span>
                            <span class="ko-section-count">@_settingHits.Count</span>
                        </div>
                        <div class="ko-list">
                            @foreach (var hit in _settingHits)
                            {
                                <button class="ko-row" @onclick="@(() => OpenSetting(hit))">
                                    <span class="ko-row-ic"><Icon Name="@hit.Icon" Size="16" /></span>
                                    <span class="ko-row-text">
                                        <span class="ko-row-title">@hit.Title</span>
                                        <span class="ko-row-cap">@hit.Path</span>
                                    </span>
                                </button>
                            }
                        </div>
                    }
                }
            }
        </div>

        <div class="ko-footer">
            <button class="ko-user" @onclick="ShowAbout" title="About AgentOS.NET">
                <span class="ko-avatar">@AvatarLetter</span>
                <span class="ko-user-text">
                    <span class="ko-user-name">@(_user ?? "operator")</span>
                    <span class="ko-user-sub">AgentOS.NET v1.0</span>
                </span>
            </button>
            <div class="ko-footer-actions">
                <button class="ko-fbtn" @onclick="ShowAbout" title="About" aria-label="About AgentOS.NET">
                    <Icon Name="info" Size="16" />
                </button>
                <button class="ko-fbtn ko-fbtn-danger" @onclick="Lock" title="Lock screen" aria-label="Lock screen">
                    <Icon Name="power" Size="16" />
                </button>
            </div>
        </div>
    </div>
}

@* ===== About dialog ===== *@
<Dialog Show="_aboutOpen" Title="About — AgentOS.NET" Width="440" OnClose="@(() => _aboutOpen = false)">
    <ChildContent>
        <h3 class="about-h">AgentOS.NET</h3>
        <p class="about-tag">A .NET multi-agent AI framework for the software development lifecycle.</p>
        <table class="about-tbl">
            <tr><th>Version</th><td>1.0</td></tr>
            <tr><th>Runtime</th><td>.NET 10</td></tr>
            <tr><th>License</th><td>MIT</td></tr>
            <tr><th>Source</th><td><a href="https://github.com/hoangsnowy/AgentOS.NET" target="_blank">github.com/hoangsnowy/AgentOS.NET</a></td></tr>
        </table>
    </ChildContent>
    <Footer>
        <Btn OnClick="@(() => _aboutOpen = false)">Close</Btn>
    </Footer>
</Dialog>

<ToastHost />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _startOpen;
    private bool _aboutOpen;
    private string _query = "";
    private string? _user;
    private bool _isAdmin;
    private ElementReference _searchRef;
    private bool _focusOnRender;

    protected override async Task OnInitializedAsync()
    {
        WM.StartMenuToggleRequested += OnStartMenuToggle;
        if (AuthState is not null)
        {
            var state = await AuthState;
            _isAdmin = state.User.IsAdmin();
            _isPlatformAdmin = state.User.IsPlatformAdmin();
        }
    }

    // GNOME "Activities" in the top bar routes here through the window manager.
    private void OnStartMenuToggle() => InvokeAsync(async () =>
    {
        await ToggleStart();
        StateHasChanged();
    });

    public void Dispose()
    {
        WM.StartMenuToggleRequested -= OnStartMenuToggle;
        _selfRef?.Dispose();
    }

    private string AvatarLetter => string.IsNullOrEmpty(_user) ? "O" : _user[..1].ToUpperInvariant();

    private List<DesktopApp> _recents = new();
    private List<DesktopApp> _results = new();
    private IReadOnlyList<SettingsHit> _settingHits = [];
    private IReadOnlyList<ShellAction> _actionHits = [];
    private DotNetObjectReference<AppShellLayout>? _selfRef;
    private bool _isPlatformAdmin;

    private Task ToggleStart()
    {
        _startOpen = !_startOpen;
        if (_startOpen)
        {
            _query = "";
            RefreshRecents();
            _focusOnRender = true;
            _user ??= Auth.Username;
        }
        return Task.CompletedTask;
    }

    private void CloseStart() => _startOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestorePreferencesAsync();
            try
            {
                _selfRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("agentosShellKeys.register", _selfRef);
            }
            catch (JSException ex) { _ = ex.Message; }   // shortcut unavailable; Activities still works
            // Authentic GNOME: nothing auto-opens — the desktop boots to a clean empty wallpaper.
            // The glanceable control plane is the Overview app, pinned first in the Dash (one click)
            // and reachable from the Activities overview.
        }

        if (_focusOnRender)
        {
            _focusOnRender = false;
            try { await _searchRef.FocusAsync(); }
            catch (Microsoft.JSInterop.JSException ex) { _ = ex.Message; } // element gone
            catch (System.InvalidOperationException ex) { _ = ex.Message; } // prerender / no JS
        }
    }

    // Hydrate the persisted desktop preferences into the singleton services so they apply
    // app-wide (toast suppression, focus mode, auto-minimize) — not only while System is open.
    private async Task RestorePreferencesAsync()
    {
        try
        {
            var showToasts = await JS.InvokeAsync<string?>("localStorage.getItem", "pref-show-toasts");
            var focus = await JS.InvokeAsync<string?>("localStorage.getItem", "pref-focus");
            var autoMin = await JS.InvokeAsync<string?>("localStorage.getItem", "pref-auto-min");
            Toasts.ShowToasts = showToasts != "0";          // default on
            Toasts.FocusMode = focus == "1";                // default off
            WM.AutoMinimizeOnBlur = autoMin == "1";         // default off
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            // Prerender / JS unavailable — keep the in-memory preference defaults.
            _ = ex.Message;
        }
        catch (System.InvalidOperationException ex)
        {
            _ = ex.Message;
        }
    }

    private void RefreshRecents()
    {
        _recents = WM.RecentKeys
            .Select(AppCatalog.Find)
            .Where(a => a is not null)
            .Cast<DesktopApp>()
            .ToList();
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        var q = _query.Trim();
        _results = string.IsNullOrEmpty(q)
            ? new()
            : AppCatalog.VisibleAll(_isAdmin)
                .Where(a => a.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                         || a.Caption.Contains(q, StringComparison.OrdinalIgnoreCase)
                         || a.Category.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
        // Settings are searchable too: every page + every setting label, deep-linked (SettingsSearch).
        var catalog = Services.GetService<AgentOs.Domain.Configuration.ISettingsCatalog>();
        _settingHits = string.IsNullOrEmpty(q)
            ? []
            : SettingsSearch.Find(q, catalog?.All ?? [], _isAdmin, _isPlatformAdmin);
        _actionHits = string.IsNullOrEmpty(q) ? [] : ShellActions.Find(q, _isAdmin);
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { CloseStart(); }
        else if (e.Key == "Enter")
        {
            var first = !string.IsNullOrWhiteSpace(_query) ? _results.FirstOrDefault() : AppCatalog.VisiblePinned(_isAdmin).FirstOrDefault();
            if (first is not null) { Launch(first); }
            else if (!string.IsNullOrWhiteSpace(_query) && _actionHits.Count > 0) { _ = RunActionAsync(_actionHits[0]); }
            else if (!string.IsNullOrWhiteSpace(_query) && _settingHits.Count > 0) { OpenSetting(_settingHits[0]); }
        }
    }

    // Ctrl/⌘+K from anywhere (shell-keys.js): open Activities with the search focused, or refocus it.
    [JSInvokable]
    public Task OnCommandKey() => InvokeAsync(async () =>
    {
        if (!_startOpen) { await ToggleStart(); }
        else { _focusOnRender = true; }
        StateHasChanged();
    });

    private async Task RunActionAsync(ShellAction action)
    {
        CloseStart();
        if (ShellActions.SettingsTarget(action.Id) is { } target) { SettingsLinks.Open(WM, target); return; }
        switch (action.Id)
        {
            case ShellActions.Run: OpenAppByKey("workflow"); break;
            case ShellActions.Idea: OpenAppByKey("board"); break;
            case ShellActions.SignOut: Nav.NavigateTo("/account/logout", forceLoad: true); break;
            case ShellActions.Theme:
                try
                {
                    await JS.InvokeAsync<string>("agenticTheme.toggleAppearance");
                    WM.NotifyThemeChanged();
                }
                catch (JSException ex) { _ = ex.Message; }   // JS unavailable — leave the theme as is
                break;
        }
    }

    private void OpenAppByKey(string key)
    {
        if (AppCatalog.Find(key) is { } app) { Launch(app); }
    }

    private void OpenSetting(SettingsHit hit)
    {
        CloseStart();
        SettingsLinks.Open(WM, hit.Target);
    }

    private void ClearSearch()
    {
        _query = "";
        _results = new();
        _settingHits = [];
        _actionHits = [];
        _focusOnRender = true;
    }

    private void Launch(DesktopApp app)
    {
        WM.OpenApp(app.Key, app.Title, app.Icon, app.W, app.H);
        _startOpen = false;
    }

    // Activities overview window exposé — click a thumbnail to focus (or restore) that window.
    private void FocusWindow(AppWindowState w)
    {
        if (w.Minimized) { WM.Restore(w.Id); }
        else { WM.Focus(w.Id); }
        _startOpen = false;
    }

    private void ShowAbout()
    {
        _aboutOpen = true;
        _startOpen = false;
    }

    private void Lock()
    {
        _startOpen = false;
        Nav.NavigateTo("/account/logout", forceLoad: true);
    }
}
