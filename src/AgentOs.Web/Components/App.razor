<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>AgentOS.NET</title>
    <link rel="preconnect" href="https://rsms.me/" />
    @* Webfont is non-blocking: first paint uses the system UI font, Inter swaps in when it arrives. *@
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" media="print" onload="this.media='all'" />
    @* Local assets go through @Assets: fingerprinted URLs served with long-lived immutable caching by
       MapStaticAssets (precompressed in Release), instead of a revalidation round trip on every load. *@
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/Z.Blazor.Diagrams/style.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["orchestration.css"]" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="icon" type="image/png" sizes="32x32" href="@Assets["favicon-32.png"]" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    <HeadOutlet @rendermode="@(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false))" />
</head>

<body>
    <Routes @rendermode="@(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false))" />

    @* Themed Blazor reconnection modal — overrides the framework's default white box. Blazor toggles the
       components-reconnect-{show,failed,rejected} classes on this element. *@
    <div id="components-reconnect-modal">
        <div class="reconnect-card">
            <div class="reconnect-agent reconnect-when-show"><BrandMark Size="52" Decorative="true" Busy="true" /></div>
            <div class="reconnect-title reconnect-when-show">Reconnecting…</div>
            <div class="reconnect-sub reconnect-when-show">Restoring your session.</div>

            <div class="reconnect-icon reconnect-when-failed">⚠</div>
            <div class="reconnect-title reconnect-when-failed">Connection lost</div>
            <div class="reconnect-sub reconnect-when-failed">The server is unreachable right now.</div>

            <div class="reconnect-icon reconnect-when-rejected">↻</div>
            <div class="reconnect-title reconnect-when-rejected">Session ended</div>
            <div class="reconnect-sub reconnect-when-rejected">Reload the page to continue.</div>

            <div class="reconnect-actions">
                <button class="reconnect-btn reconnect-when-failed" onclick="window.Blazor.reconnect()">Retry now</button>
                <button class="reconnect-btn reconnect-when-rejected" onclick="location.reload()">Reload</button>
            </div>
        </div>
    </div>

    <script src="@Assets["_content/Z.Blazor.Diagrams/script.min.js"]"></script>
    <script src="@Assets["theme.js"]"></script>
    <script src="@Assets["workflow-keys.js"]"></script>
    <script src="@Assets["shell-keys.js"]"></script>
    <script src="@Assets["panel-resize.js"]"></script>
    <script src="@Assets["ticket-files.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
