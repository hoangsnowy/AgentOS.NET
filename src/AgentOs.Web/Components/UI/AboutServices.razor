@* System → About, GNOME-style: a centred hero (the product, its version and links), a status banner tinted by
   the overall health, a service map (visual), and an Adwaita boxed list with one expandable row per service
   (the accessible, detailed alternative). Rows that need attention open by default. Infra facts (hosts, URLs,
   errors) only for platform admins. Its own component so SystemApp's 1 Hz clock never re-renders it. *@

@using AgentOs.Web.Services.About
@implements IDisposable
@inject SystemStatusService StatusService
@inject LlmConfigView LlmView
@inject IJSRuntime JS
@inject ToastService Toasts

<div class="about">
    <header class="about-hero">
        <AgentMascot Role="Orchestrator" State="AgentMascot.MascotState.Idle" Size="72" />
        <h2 class="about-title">AgentOS</h2>
        <p class="about-version">
            Version @Format.ShortVersion(WebHostProbe.InformationalVersion)
            @if (Format.Commit(WebHostProbe.InformationalVersion) is { } sha)
            {
                <span class="about-build">· build @sha</span>
            }
        </p>
        <p class="about-tagline">A .NET multi-agent platform for the software lifecycle.</p>
        <div class="about-links">
            <span class="about-chip">@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</span>
            <span class="about-chip">MIT licence</span>
            <a class="about-chip about-chip-link" href="https://github.com/hoangsnowy/AgentOs" target="_blank" rel="noopener">
                Source <Icon Name="arrow-square-out" Size="12" />
            </a>
        </div>
    </header>

    <section class="about-status is-@StateClass(_overall)" aria-label="Service status">
        <span class="about-status-ic" aria-hidden="true">
            <Icon Name="@(_overall switch { ServiceHealth.Healthy => "check", ServiceHealth.Degraded => "warning", _ => "x" })" Size="18" />
        </span>
        <div class="about-status-text">
            <strong class="about-overall" role="status">@_headline</strong>
            <span>
                @if (_services.Count == 0)
                {
                    <text>Checking services…</text>
                }
                else
                {
                    <text>@_services.Count services · checked @_checkedAt.ToLocalTime().ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture) · shared for @((int)SystemStatusService.Ttl.TotalSeconds) s</text>
                }
            </span>
        </div>
        <div class="about-status-actions">
            <Btn Size="Btn.ButtonSize.Sm" OnClick="RefreshAsync" Disabled="_busy" Title="Probe every service again">
                <Icon Name="arrow-clockwise" Size="13" Loop="_busy" /> Refresh
            </Btn>
            <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Ghost" OnClick="CopyAsync" Disabled="_services.Count == 0" Title="Copy a plain-text status report">
                <Icon Name="file" Size="13" /> Copy report
            </Btn>
        </div>
    </section>

    @if (_services.Count > 0)
    {
        <figure class="about-topo">
            <svg viewBox="0 0 600 @TopoHeight" role="img" aria-label="@TopoLabel()" preserveAspectRatio="xMidYMin meet">
                @{ var mid = TopoHeight / 2; }
                <path class="topo-edge" d="M120 @mid L196 @mid" />
                @for (var i = 0; i < Outer.Count; i++)
                {
                    var y = OuterY(i) + NodeH / 2;
                    <path class="topo-edge is-@StateClass(Outer[i].Health)" d="M340 @mid C380 @mid 380 @y 420 @y" />
                }
                <g class="topo-node is-plain">
                    <rect x="8" y="@(mid - NodeH / 2)" width="112" height="@NodeH" rx="10" />
                    <text class="topo-name" x="24" y="@(mid - 3)">Browser</text>
                    <text class="topo-meta" x="24" y="@(mid + 12)">you</text>
                </g>
                @if (Web is { } web)
                {
                    <g class="topo-node is-hub is-@StateClass(web.Health)">
                        <rect x="196" y="@(mid - NodeH / 2 - 6)" width="144" height="@(NodeH + 12)" rx="12" />
                        <circle class="topo-dot" cx="214" cy="@(mid - 6)" r="4.5" />
                        <text class="topo-name" x="226" y="@(mid - 2)">@web.Name</text>
                        <text class="topo-meta" x="214" y="@(mid + 14)">@Meta(web)</text>
                    </g>
                }
                @for (var i = 0; i < Outer.Count; i++)
                {
                    var s = Outer[i];
                    var y = OuterY(i);
                    <g class="topo-node is-@StateClass(s.Health)">
                        <rect x="420" y="@y" width="172" height="@NodeH" rx="10" />
                        <circle class="topo-dot" cx="436" cy="@(y + 15)" r="4" />
                        <text class="topo-name" x="447" y="@(y + 19)">@s.Name</text>
                        <text class="topo-meta" x="436" y="@(y + 34)">@Meta(s)</text>
                    </g>
                }
            </svg>
        </figure>

        <h3 class="about-section">Services</h3>
        <div class="about-list">
            @foreach (var s in _services)
            {
                <details class="about-row is-@StateClass(s.Health)" data-service="@s.Id" open="@NeedsAttention(s)">
                    <summary aria-label="@($"{s.Name}: {AboutReport.Label(s.Health)}")">
                        <span class="about-row-ic" aria-hidden="true"><Icon Name="@s.Icon" Size="16" /></span>
                        <span class="about-row-title">
                            <strong>@s.Name</strong>
                            <span>@(s.Summary ?? s.Role)</span>
                        </span>
                        <span class="about-row-meta">
                            @if (s.Version is { Length: > 0 })
                            {
                                <span class="about-ver">@VersionLabel(s.Version)</span>
                            }
                            @if (s.LatencyMs is { } ms)
                            {
                                <span class="about-lat">@Format.Latency(ms)</span>
                            }
                            <span class="about-state"><span class="about-dot" aria-hidden="true"></span>@AboutReport.Label(s.Health)</span>
                            <span class="about-chevron" aria-hidden="true"><Icon Name="chevron-right" Size="14" /></span>
                        </span>
                    </summary>
                    <div class="about-row-body">
                        <p class="about-row-role">@s.Role</p>
                        @if (s.Facts.Count > 0)
                        {
                            <dl class="about-facts">
                                @foreach (var f in s.Facts)
                                {
                                    <div><dt>@f.Label</dt><dd>@f.Value</dd></div>
                                }
                            </dl>
                        }
                        @if (_platformAdmin && s.Infra.Count > 0)
                        {
                            <p class="about-infra-h"><Icon Name="lock" Size="12" /> Infrastructure · platform admins</p>
                            <dl class="about-facts about-infra">
                                @foreach (var f in s.Infra)
                                {
                                    <div><dt>@f.Label</dt><dd>@f.Value</dd></div>
                                }
                            </dl>
                        }
                    </div>
                </details>
            }
        </div>
    }
</div>

@code {
    private const int NodeH = 44;
    private const int RowGap = 54;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private List<ServiceStatus> _services = [];
    private ServiceStatus? _llm;
    private DateTimeOffset _checkedAt;
    private ServiceHealth _overall = ServiceHealth.Healthy;
    private string _headline = "Checking services…";
    private bool _busy;
    private bool _platformAdmin;

    private ServiceStatus? Web => _services.Find(s => s.Id == "web");
    private List<ServiceStatus> Outer => _services.FindAll(s => s.Id != "web");
    private int TopoHeight => Math.Max(NodeH + 24, Outer.Count * RowGap + 6);
    private static int OuterY(int i) => 4 + i * RowGap;

    protected override async Task OnInitializedAsync()
    {
        string? tenant = null, user = null;
        if (AuthState is not null)
        {
            var state = await AuthState;
            _platformAdmin = state.User.IsPlatformAdmin();
            tenant = state.User.GetTenantId();
            user = state.User.Identity?.Name;
        }
        _llm = LlmGatewayCard.From(LlmView.Resolve(tenant, user));

        if (StatusService.Last is { } last) { Apply(last); }   // paint the last snapshot immediately
        await LoadAsync(refresh: false);
    }

    private async Task RefreshAsync() => await LoadAsync(refresh: true);

    private async Task LoadAsync(bool refresh)
    {
        _busy = true;
        try
        {
            Apply(await StatusService.GetAsync(refresh, _cts.Token));
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            // Window closed mid-probe.
        }
        finally
        {
            _busy = false;
        }
    }

    private void Apply(SystemSnapshot snapshot)
    {
        var services = new List<ServiceStatus>(snapshot.Services.Count + 1);
        services.AddRange(snapshot.Services);
        if (_llm is not null) { services.Add(_llm); }
        _services = services;
        _checkedAt = snapshot.CheckedAt;
        _overall = SystemSnapshot.Worst(services);
        _headline = SystemSnapshot.Headline(services);
    }

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", AboutReport.Text(_services, _checkedAt, _platformAdmin));
            Toasts.Show("About", "Status report copied", ToastKind.Ok);
        }
        catch (JSException)
        {
            Toasts.Show("About", "The browser blocked clipboard access", ToastKind.Warn);
        }
    }

    /// <summary>Degraded / down rows open on load so a problem is never hidden behind a click.</summary>
    internal static bool NeedsAttention(ServiceStatus s) => s.Health is ServiceHealth.Degraded or ServiceHealth.Down;

    /// <summary>"v18.3" for a numeric version, the bare name for a product ("MailHog").</summary>
    internal static string VersionLabel(string version) => char.IsAsciiDigit(version[0]) ? "v" + version : version;

    private static string Meta(ServiceStatus s)
    {
        if (s.Health == ServiceHealth.NotConfigured) { return "not in this run"; }
        if (s.Health == ServiceHealth.Down) { return "down"; }
        if (s.MapLabel is { Length: > 0 } label) { return s.LatencyMs is { } t ? $"{label} · {Format.Latency(t)}" : label; }
        var parts = new List<string>(2);
        if (s.Version is { Length: > 0 } v) { parts.Add(v.Length > 14 ? v[..14] : v); }
        if (s.LatencyMs is { } ms) { parts.Add(Format.Latency(ms)); }
        return parts.Count == 0 ? AboutReport.Label(s.Health).ToLowerInvariant() : string.Join(" · ", parts);
    }

    private string TopoLabel()
        => $"Service map: browser to Web desktop, which uses {string.Join(", ", Outer.Select(s => $"{s.Name} ({AboutReport.Label(s.Health)})"))}.";

    private static string StateClass(ServiceHealth h) => h switch
    {
        ServiceHealth.Healthy => "healthy",
        ServiceHealth.Degraded => "degraded",
        ServiceHealth.Down => "down",
        _ => "off",
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
