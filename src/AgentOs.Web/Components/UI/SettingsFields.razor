@* SettingsFields — renders registry settings (ADR-0011) as a form straight from their descriptors: the control
   follows the kind (choice → select, boolean → Toggle, model → ModelPicker, secret → write-only password,
   numbers → number input), every field shows where its value comes from, and Save/Reset act per field.
   Platform-scope and operator-locked settings render read-only for a tenant admin. Reused by every
   settings surface so new settings get a UI by declaring a descriptor, not by writing markup. *@

@using AgentOs.Domain.Configuration
@using AgentOs.Modules.Llm
@inject ISettings Settings
@inject ISettingsCatalog Catalog
@inject AgentOs.Web.Shell.Services.ToastService Toasts

@foreach (var f in _fields)
{
    var d = f.View.Descriptor;
    var readOnly = IsReadOnly(f);
    <div class="prefs-row" @key="d.Key">
        <div class="prefs-label">
            <strong>@d.Label</strong>
            <Badge Variant="@(f.View.Source == SettingSource.Tenant ? Badge.BadgeVariant.Info : f.View.Source == SettingSource.Locked ? Badge.BadgeVariant.Warn : Badge.BadgeVariant.Default)">@SourceLabel(f.View.Source)</Badge>
            @if (!string.IsNullOrWhiteSpace(d.Help))
            {
                <br /><span class="prefs-hint">@d.Help</span>
            }
            @if (readOnly && f.View.Source == SettingSource.Locked)
            {
                <br /><span class="prefs-hint">Pinned by the operator (Settings:Locks) — change it in deployment config.</span>
            }
            else if (readOnly)
            {
                <br /><span class="prefs-hint">Platform-wide — set by a platform admin.</span>
            }
        </div>
        <div class="settings-field-control">
            @switch (d.Kind)
            {
                case SettingKind.Boolean when readOnly:
                    <span class="prefs-hint">@(bool.TryParse(f.Draft, out var ro) && ro ? "On" : "Off")</span>
                    break;
                case SettingKind.Boolean:
                    <Toggle Checked="@(bool.TryParse(f.Draft, out var on) && on)" Title="@d.Label"
                            CheckedChanged="@(v => f.Draft = v ? "true" : "false")" />
                    break;
                case SettingKind.Choice:
                    <select class="prefs-select" disabled="@readOnly" aria-label="@d.Label" value="@f.Draft"
                            @onchange="e => f.Draft = e.Value?.ToString() ?? string.Empty">
                        <option value="">— inherit —</option>
                        @foreach (var c in d.Choices ?? [])
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                    break;
                case SettingKind.Secret:
                    <input class="prefs-input" type="password" autocomplete="off" disabled="@readOnly" aria-label="@d.Label"
                           placeholder="@(f.View.IsSet ? $"Set ({f.View.DisplayValue}) — type to replace" : "Not set")"
                           value="@f.Draft" @onchange="e => f.Draft = e.Value?.ToString() ?? string.Empty" />
                    break;
                case SettingKind.WholeNumber or SettingKind.Number:
                    <input class="prefs-input" type="number" disabled="@readOnly" aria-label="@d.Label"
                           min="@d.Min" max="@d.Max" step="@(d.Kind == SettingKind.WholeNumber ? "1" : "any")"
                           value="@f.Draft" @onchange="e => f.Draft = e.Value?.ToString() ?? string.Empty" />
                    break;
                case SettingKind.Model:
                    <ModelPicker Value="@f.Draft" ValueChanged="v => f.Draft = v" AllowInherit="true"
                                 AriaLabel="@d.Label" Disabled="@readOnly" />
                    break;
                default:
                    <input class="prefs-input" disabled="@readOnly" aria-label="@d.Label"
                           value="@f.Draft" @onchange="e => f.Draft = e.Value?.ToString()?.Trim() ?? string.Empty" />
                    break;
            }
            <Btn Size="Btn.ButtonSize.Sm" Variant="Btn.ButtonVariant.Primary" Disabled="@(readOnly || _saving)" OnClick="() => Save(f)">Save</Btn>
            <Btn Size="Btn.ButtonSize.Sm" Disabled="@(readOnly || _saving || !HasOwnValue(f))" OnClick="() => Reset(f)">Reset</Btn>
        </div>
    </div>
}

@code {
    /// <summary>Registry keys to render, in order.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Keys { get; set; } = [];

    /// <summary>The signed-in tenant (a circuit has no HttpContext — pass it from AuthenticationState).</summary>
    [Parameter, EditorRequired] public string TenantId { get; set; } = string.Empty;

    /// <summary>Who is editing (recorded in the settings audit trail).</summary>
    [Parameter] public string Actor { get; set; } = "admin";

    /// <summary>Toast title.</summary>
    [Parameter] public string Area { get; set; } = "Settings";

    /// <summary>The viewer is a platform admin: platform-scope settings become editable and are written at
    /// platform scope (every tenant). Tenant-scope settings still write to <see cref="TenantId"/>.</summary>
    [Parameter] public bool CanEditPlatform { get; set; }

    private sealed class FieldState(SettingView view)
    {
        public SettingView View { get; set; } = view;
        public string Draft { get; set; } = view.Descriptor.IsSecret ? string.Empty : view.DisplayValue ?? string.Empty;
    }

    private List<FieldState> _fields = [];
    private bool _saving;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var fields = new List<FieldState>(Keys.Count);
        foreach (var key in Keys)
        {
            if (!Catalog.TryGet(key, out var d))
            {
                continue;
            }
            var v = await Settings.GetAsync(key, TenantId);
            var display = !v.HasValue ? null : d.IsSecret ? SettingValidationMask(v.Value!) : v.Value;
            fields.Add(new FieldState(new SettingView(d, display, v.Source, v.HasValue)));
        }
        _fields = fields;
    }

    // Operator-locked is always read-only. Platform-scope is read-only unless the viewer is a platform admin.
    private bool IsReadOnly(FieldState f) =>
        f.View.Source == SettingSource.Locked || (f.View.Descriptor.Scope == SettingScope.Platform && !CanEditPlatform);

    private SettingScope WriteScope(FieldState f) =>
        f.View.Descriptor.Scope == SettingScope.Platform ? SettingScope.Platform : SettingScope.Tenant;

    // Reset clears the row at the scope the field writes to.
    private static bool HasOwnValue(FieldState f) =>
        f.View.Source == (f.View.Descriptor.Scope == SettingScope.Platform ? SettingSource.Platform : SettingSource.Tenant);

    private Task Save(FieldState f) => WriteAsync(f, f.Draft, f.View.Descriptor.IsSecret && string.IsNullOrEmpty(f.Draft) ? null : $"{f.View.Descriptor.Label} saved — applies to the next call.");

    private Task Reset(FieldState f) => WriteAsync(f, string.Empty, $"{f.View.Descriptor.Label} reset to the inherited value.");

    private async Task WriteAsync(FieldState f, string value, string? okMessage)
    {
        if (okMessage is null)
        {
            Toasts.Show(Area, "Type a new value to replace the secret.", AgentOs.Web.Shell.Services.ToastKind.Info);
            return;
        }
        _saving = true;
        try
        {
            var scope = WriteScope(f);
            var result = await Settings.SetAsync(f.View.Descriptor.Key, value, scope, scope == SettingScope.Tenant ? TenantId : null, Actor);
            Toasts.Show(Area, result.Ok ? okMessage : result.Error ?? "Save failed.",
                result.Ok ? AgentOs.Web.Shell.Services.ToastKind.Ok : AgentOs.Web.Shell.Services.ToastKind.Err);
        }
        finally
        {
            _saving = false;
            await LoadAsync();
        }
    }

    private static string SettingValidationMask(string secret) =>
        AgentOs.Modules.AppConfig.Settings.SettingValidation.Mask(secret);

    private static string SourceLabel(SettingSource s) => s switch
    {
        SettingSource.Tenant => "This tenant",
        SettingSource.Platform => "Platform",
        SettingSource.Seed => "appsettings",
        SettingSource.Locked => "Locked",
        _ => "Default",
    };
}
