@* AgentMascot — a cartoon character per agent role (Orchestrator conducts with a baton, Requirement writes on
   a clipboard, Coding types on a laptop, Testing sweeps a magnifier, QA stamps a shield) that acts out its run
   state: idle floats and blinks, running bobs and works its prop, done hops with happy eyes and sparkles,
   failed shakes with X eyes and a sweat drop, canned dozes off (grey, zzz), skipped greys out.
   Pure inline SVG + CSS keyframes on transform/opacity (compositor-only, no JS, no <defs> ids so any number
   can share a page). Motion stops under prefers-reduced-motion; the face still tells the state. *@

<svg class="mascot role-@RoleClass is-@StateClass" viewBox="0 0 64 64" role="img" aria-label="@Label"
     style="width:@(Size)px;height:@(Size)px">
    <title>@Label</title>
    <ellipse class="m-shadow" cx="32" cy="58.5" rx="13" ry="2.4" />
    <g class="m-body">
        @if (RoleClass == "generic")
        {
            <path class="m-antenna" d="M32 13V6" />
            <circle class="m-bulb" cx="32" cy="5" r="2.4" />
        }
        <ellipse class="m-dark" cx="25" cy="54.5" rx="4.5" ry="2.4" />
        <ellipse class="m-dark" cx="39" cy="54.5" rx="4.5" ry="2.4" />
        <path class="m-skin" d="M32 12C45 12 51 23 51 35.5C51 47.5 43.5 54 32 54C20.5 54 13 47.5 13 35.5C13 23 19 12 32 12Z" />
        <ellipse class="m-belly" cx="32" cy="44.5" rx="11" ry="7.5" />
        <path class="m-shine" d="M20.5 22Q23.5 16.5 29 15.2" />

        <g class="m-eyes">
            <ellipse class="m-eye" cx="25.5" cy="30" rx="4.6" ry="5.4" />
            <ellipse class="m-eye" cx="38.5" cy="30" rx="4.6" ry="5.4" />
            <g>
                <circle class="m-pupil" cx="26.3" cy="31" r="2.7" />
                <circle class="m-pupil" cx="39.3" cy="31" r="2.7" />
                <circle class="m-glint" cx="27.3" cy="29.8" r="1" />
                <circle class="m-glint" cx="40.3" cy="29.8" r="1" />
            </g>
        </g>
        <path class="m-face m-eyes-happy" d="M21.5 31.5Q25.5 26.5 29.5 31.5M34.5 31.5Q38.5 26.5 42.5 31.5" />
        <path class="m-face m-eyes-shut" d="M21.5 30.5Q25.5 34 29.5 30.5M34.5 30.5Q38.5 34 42.5 30.5" />
        <path class="m-face m-eyes-x" d="M22.8 27.3l5.4 5.4M28.2 27.3l-5.4 5.4M35.8 27.3l5.4 5.4M41.2 27.3l-5.4 5.4" />
        <circle class="m-cheek" cx="19.5" cy="37.5" r="2.6" />
        <circle class="m-cheek" cx="44.5" cy="37.5" r="2.6" />
        <path class="m-face m-smile" d="M28 39.5Q32 43 36 39.5" />
        <ellipse class="m-mouth m-talk" cx="32" cy="40.6" rx="2.2" ry="1.8" />
        <path class="m-mouth m-grin" d="M27 39Q32 46.5 37 39Z" />
        <path class="m-face m-frown" d="M28.5 42.2Q32 39 35.5 42.2" />

        @switch (RoleClass)
        {
            case "orchestrator":
                <path class="m-ink" d="M27 47.5L32 49.6L37 47.5V52.2L32 50.2L27 52.2Z" />
                <circle class="m-dark" cx="14.5" cy="38.5" r="3" />
                <g class="m-baton">
                    <path class="m-stick" d="M50.5 37L58 24" />
                    <circle class="m-tip" cx="58.3" cy="23.4" r="1.4" />
                    <circle class="m-dark" cx="49.5" cy="38.5" r="3" />
                </g>
                break;
            case "requirement":
                <g>
                    <rect class="m-board" x="5.5" y="33" width="15" height="19" rx="2" />
                    <rect class="m-paper" x="7.5" y="36" width="11" height="14" rx="1" />
                    <rect class="m-ink" x="10" y="31.6" width="6" height="3" rx="1" />
                    <path class="m-lines" d="M9.5 40h7M9.5 43h7M9.5 46h4.5" />
                    <circle class="m-dark" cx="17.5" cy="47" r="3" />
                </g>
                <g class="m-pencil">
                    <path class="m-pencil-body" d="M47.5 43L55 31.5" />
                    <path class="m-ink" d="M46.6 44.4L47.1 41.9L48.9 43.1Z" />
                    <circle class="m-dark" cx="49.5" cy="41.5" r="3" />
                </g>
                break;
            case "coding":
                <g>
                    <rect class="m-screen" x="19" y="43" width="26" height="12.5" rx="1.8" />
                    <text class="m-code" x="30.5" y="51.6" text-anchor="middle">&lt;/&gt;</text>
                    <rect class="m-cursor" x="37.6" y="47" width="1.3" height="5" />
                    <path class="m-base" d="M15 55.5H49L46.5 58.3H17.5Z" />
                    <circle class="m-dark m-hand-l" cx="23" cy="55.6" r="2.8" />
                    <circle class="m-dark m-hand-r" cx="41" cy="55.6" r="2.8" />
                </g>
                break;
            case "testing":
                <circle class="m-dark" cx="14.5" cy="40" r="3" />
                <g class="m-lens">
                    <path class="m-handle" d="M50.5 43.5L56.5 51" />
                    <circle class="m-glass" cx="46" cy="36" r="6.2" />
                    <path class="m-glass-shine" d="M42.6 34.2Q43.4 31.6 46 31" />
                    <circle class="m-dark" cx="49.5" cy="42" r="3" />
                </g>
                break;
            case "qa":
                <circle class="m-dark" cx="14.5" cy="40" r="3" />
                <g class="m-stamp">
                    <path class="m-shield" d="M49 26.5L56 29V34C56 38.5 53 41.5 49 43C45 41.5 42 38.5 42 34V29Z" />
                    <path class="m-check" d="M45.4 34.3L48 36.9L52.6 31.8" />
                    <circle class="m-dark" cx="49" cy="43.5" r="3" />
                </g>
                break;
            default:
                <circle class="m-dark" cx="14.5" cy="40" r="3" />
                <circle class="m-dark" cx="49.5" cy="40" r="3" />
                break;
        }
    </g>

    <g class="m-fx m-sparkles">
        <g transform="translate(9 17)"><path class="m-star" d="M0-3.4L.9-.9L3.4 0L.9.9L0 3.4L-.9.9L-3.4 0L-.9-.9Z" /></g>
        <g transform="translate(55 12)"><path class="m-star" d="M0-3.4L.9-.9L3.4 0L.9.9L0 3.4L-.9.9L-3.4 0L-.9-.9Z" /></g>
        <g transform="translate(57 30) scale(.7)"><path class="m-star" d="M0-3.4L.9-.9L3.4 0L.9.9L0 3.4L-.9.9L-3.4 0L-.9-.9Z" /></g>
    </g>
    <g class="m-fx m-zzz">
        <text class="m-z" x="45" y="15">z</text>
        <text class="m-z m-z2" x="50" y="9">z</text>
    </g>
    <path class="m-fx m-sweat" d="M48.5 17Q51.5 21.5 48.5 23.6Q45.5 21.5 48.5 17Z" />
    @if (RoleClass == "orchestrator")
    {
        <g class="m-fx m-notes">
            <text class="m-note" x="5" y="18">&#9834;</text>
            <text class="m-note m-note2" x="56" y="16">&#9835;</text>
        </g>
    }
</svg>

@code {
    /// <summary>What the agent is doing — drives the face and the motion.</summary>
    public enum MascotState
    {
        /// <summary>At rest: floats and blinks.</summary>
        Idle,

        /// <summary>Working: bobs and animates its prop.</summary>
        Running,

        /// <summary>Finished: a hop, happy eyes, sparkles.</summary>
        Done,

        /// <summary>Errored: shakes, X eyes, sweat drop.</summary>
        Failed,

        /// <summary>Finished on canned offline output: asleep and greyed.</summary>
        Canned,

        /// <summary>Not run.</summary>
        Skipped,
    }

    /// <summary>Agent role (Orchestrator, Requirement, Coding, Testing, Qa); anything else gets the generic bot.</summary>
    [Parameter] public string? Role { get; set; }

    /// <summary>Run state.</summary>
    [Parameter] public MascotState State { get; set; }

    /// <summary>Rendered size in CSS pixels.</summary>
    [Parameter] public int Size { get; set; } = 40;

    // The Board agents (AgentRoles keys) wear the character of the pipeline role they mirror.
    private string RoleClass => Role?.Trim().ToUpperInvariant() switch
    {
        "ORCHESTRATOR" or "DECOMPOSER" or "AUTOPILOTORCHESTRATOR" => "orchestrator",
        "REQUIREMENT" or "DISCOVERY" => "requirement",
        "CODING" or "ISSUEWORK" => "coding",
        "TESTING" or "ACCEPTANCE" => "testing",
        "QA" or "REVIEWER" or "DESIGNER" => "qa",
        _ => "generic",
    };

    private string StateClass => State switch
    {
        MascotState.Running => "running",
        MascotState.Done => "done",
        MascotState.Failed => "failed",
        MascotState.Canned => "canned",
        MascotState.Skipped => "skipped",
        _ => "idle",
    };

    private string Label => $"{(string.IsNullOrWhiteSpace(Role) ? "Agent" : Role)} — {StateClass}";
}
