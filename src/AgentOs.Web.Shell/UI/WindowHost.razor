@* WindowHost — renders every open app window from WindowManagerService. App-agnostic AND host-agnostic:
   it resolves a window's component through the IAppRegistry seam (the host implements it from its
   AppCatalog), so this chrome lives in AgentOs.Web.Shell and names neither a specific app nor the host. *@

@implements IDisposable
@inject WindowManagerService WM
@inject IAppRegistry Registry

@* EVERY open window renders; minimized ones and those on another virtual workspace are hidden with
   CSS (.appwin.minimized / .appwin.off-workspace, both display:none) rather than dropped from the
   render tree.

   Filtering them out here destroyed them: Blazor disposes a component the moment it leaves the tree,
   so minimizing a window — or switching workspace — threw away everything it held. A pipeline run in
   flight, the story typed into it, the artifacts it had already produced: gone, with the server-side
   work still running and nowhere to land. On a desktop metaphor, minimize must hide a window, not
   kill the app inside it. The stylesheet already assumed this (.appwin.minimized has existed all
   along); only this filter disagreed. *@
@foreach (var w in WM.Open)
{
        <AppFrame W="@w" @key="w.Id">
            @if (Registry.Find(w.AppKey) is { } app && !app.IsVisibleTo(_granted))
            {
                @* RBAC v2: a deep link / restored window for an app this user's roles don't allow renders a refusal,
                   never the app — the app's own page re-checks too (defence in depth). *@
                <div class="appwin-blank" role="alert">You don't have access to <strong>@app.Title</strong>. Ask an admin for a role that includes it.</div>
            }
            else if (Registry.ResolveComponent(w.AppKey) is { } appComponent)
            {
                <DynamicComponent Type="appComponent" />
            }
            else
            {
                <div class="appwin-blank">Unknown app: <code>@w.AppKey</code></div>
            }
        </AppFrame>
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    private Permission _granted;

    protected override void OnInitialized()
    {
        WM.Changed += OnChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            _granted = (await AuthState).User.GetPermissions();
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => WM.Changed -= OnChanged;
}
