@* BrandMark — the AgentOS.NET product icon: a friendly agent face (antenna with a gold light, big eyes, cheeks, smile)
   on the accent squircle, drawn in the same illustration palette as the agent characters (--mascot-* tokens).
   Pure inline SVG with no ids/defs (any number can share a page); the gradient is the wrapper's CSS background.
   Still at rest; on hover it blinks and waves its antenna once. Busy (loading) is the only looping state, off
   under reduced motion or the Animations setting. The static twin is wwwroot/favicon.svg (+ PNG renders) and the Keycloak login tile. *@

<span class="brand-logo @(Busy ? "is-busy" : "")" style="width:@(Size)px;height:@(Size)px"
      role="@(Decorative ? null : "img")" aria-label="@(Decorative ? null : "AgentOS.NET")" aria-hidden="@(Decorative ? "true" : null)">
    <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <g class="bl-antenna">
            <line class="bl-stalk" x1="32" y1="18" x2="32" y2="10" />
            <circle class="bl-bulb" cx="32" cy="8.5" r="3.6" />
        </g>
        <rect class="bl-head" x="12.5" y="17.5" width="39" height="31" rx="13" />
        <g class="bl-eyes">
            <ellipse class="bl-eye" cx="25" cy="31.5" rx="3.7" ry="4.5" />
            <ellipse class="bl-eye" cx="39" cy="31.5" rx="3.7" ry="4.5" />
            <circle class="bl-glint" cx="26.3" cy="29.7" r="1.25" />
            <circle class="bl-glint" cx="40.3" cy="29.7" r="1.25" />
        </g>
        <circle class="bl-cheek" cx="19" cy="38.5" r="2.7" />
        <circle class="bl-cheek" cx="45" cy="38.5" r="2.7" />
        <path class="bl-smile" d="M27.2 39.4 Q32 43.6 36.8 39.4" />
    </svg>
</span>

@code {
    /// <summary>Edge length in CSS pixels.</summary>
    [Parameter] public int Size { get; set; } = 40;

    /// <summary>True when a visible "AgentOS.NET" label sits next to it (the mark is then hidden from assistive tech).</summary>
    [Parameter] public bool Decorative { get; set; }

    /// <summary>Loading state: the agent bobs, glances around and its antenna light pulses — loops only while
    /// something is actually in progress (the Spinner and the reconnect screen).</summary>
    [Parameter] public bool Busy { get; set; }
}
